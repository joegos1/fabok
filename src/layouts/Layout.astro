---
/**
 * Main Layout Component
 * =====================
 * Basis layout met navigatie voor alle pagina's
 */

import type { Profile } from '../types/database';
import { requireAuth } from '../lib';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'VABOK - Versterken van de Aansluiting in de Beroepskolom' } = Astro.props;

// Haal gebruiker en profiel op (redirect wordt genegeerd voor publieke pagina's)
const { user, profile } = await requireAuth(Astro.request);
const isLoggedIn = !!user;

// Nederlandse vertalingen voor rollen
const roleLabels: Record<string, string> = {
  admin: 'Beheerder',
  landingpage_editor: 'Landingspaginabeheerder',
  project_editor: 'Projectbeheerder',
  viewer: 'Bezoeker',
};
const roleLabel = profile 
  ? `${profile.full_name || profile.email} - ${roleLabels[profile.role] || profile.role}` 
  : '';
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/FirdaGeel_Groen-07_0_0.png" />
  <title>{title} | VABOK</title>
</head>
<body class="min-h-screen bg-firda-gray-50 text-firda-grey-900">
  <!-- Header / Navigatie -->
  <header class="bg-firda-blue-600 text-white shadow-lg">
  
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16">
        <!-- Logo / Site naam -->
        <a href="/" class="flex items-center gap-3 hover:opacity-90 transition">
          <img src="/Picture1.png" alt="Logo VABOK" class="h-14 object-contain"/>
          <span class="text-xl font-bold">VABOK</span>
        </a>

        <!-- Navigatie links -->
        <nav class="hidden md:flex items-center space-x-6">
          <a href="/" class="hover:text-firda-green-400 transition font-medium">
            Home
          </a>
          <a href="/projecten/lijst" class="hover:text-firda-green-400 transition font-medium">
            Projecten
          </a>
          {isLoggedIn ? (
            <>
              {profile && ['admin', 'project_editor', 'landingpage_editor'].includes(profile.role) && (
                <a href="/dashboard/overzicht" class="hover:text-firda-green-400 transition font-medium">
                  Dashboard
                </a>
              )}
              {profile && (
                <div class="flex items-center gap-2 px-3 py-1 bg-firda-blue-700/50 rounded-lg">
                  <span class="text-sm text-firda-blue-100">{profile.email}</span>
                  <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-firda-green-500 text-firda-gray-900">
                    {roleLabel}
                  </span>
                </div>
              )}
              <a 
                href="/api/auth/logout" 
                class="bg-firda-blue-700 hover:bg-firda-blue-800 px-4 py-2 rounded-lg transition font-medium"
              >
                Uitloggen
              </a>
            </>
          ) : (
            <a 
              href="/login" 
              class="bg-firda-green-500 hover:bg-firda-green-600 text-firda-gray-900 px-4 py-2 rounded-lg transition font-medium"
            >
              Inloggen
            </a>
          )}
        </nav>

        <!-- Mobile menu button -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-firda-blue-700 transition"
          aria-label="Menu openen"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <nav id="mobile-menu" class="hidden md:hidden pb-4">
        <div class="flex flex-col space-y-2">
          <a href="/" class="hover:bg-firda-blue-700 px-3 py-2 rounded-lg transition">
            Home
          </a>
          <a href="/projecten/lijst" class="hover:bg-firda-blue-700 px-3 py-2 rounded-lg transition">
            Projecten
          </a>
          {isLoggedIn ? (
            <>
              {profile && (
                <div class="flex items-center justify-between px-3 py-2 bg-firda-blue-700/50 rounded-lg mb-2">
                  <span class="text-sm text-firda-blue-100 truncate">{profile.email}</span>
                  <span class="inline-block px-2 py-0.5 text-xs font-medium rounded-full bg-firda-green-500 text-firda-gray-900 ml-2">
                    {roleLabel}
                  </span>
                </div>
              )}
              {profile && ['admin', 'project_editor', 'landingpage_editor'].includes(profile.role) && (
                <a href="/dashboard/overzicht" class="hover:bg-firda-blue-700 px-3 py-2 rounded-lg transition">
                  Dashboard
                </a>
              )}
              <a href="/api/auth/logout" class="hover:bg-firda-blue-700 px-3 py-2 rounded-lg transition">
                Uitloggen
              </a>
            </>
          ) : (
            <a href="/login" class="bg-firda-green-500 hover:bg-firda-green-600 text-firda-gray-900 px-3 py-2 rounded-lg transition">
              Inloggen
            </a>
          )}
        </div>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-firda-gray-800 text-firda-gray-300 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col items-center gap-6">
        <div>
          <p class="text-sm text-center">
            &copy; {new Date().getFullYear()} VABOK - Versterken van de Aansluiting in de Beroepskolom
          </p>
        </div>
        
      </div>
    </div>
  </footer>

  <!-- Mobile menu script -->
  <script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
</style>

---
/**
 * Main Layout Component
 * =====================
 * Basis layout met navigatie voor alle pagina's
 */

import type { Profile } from '../types/database';
import { requireAuth } from '../lib';
import { Image } from 'astro:assets';
import LogoVabok from '../assets/logo-vabok.png';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'VABOK - Versterken van de Aansluiting in de Beroepskolom' } = Astro.props;

// Haal gebruiker en profiel op (redirect wordt genegeerd voor publieke pagina's)
const { user, profile } = await requireAuth(Astro.request);
const isLoggedIn = !!user;

// Nederlandse vertalingen voor rollen
const roleLabels: Record<string, string> = {
  admin: 'Beheerder',
  landingpage_editor: 'Editor',
  project_editor: 'Projectbeheerder',
  viewer: 'Bezoeker',
};
const roleLabel = profile 
  ? `${profile.full_name || profile.email} - ${roleLabels[profile.role] || profile.role}` 
  : '';
---

<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/FirdaGeel_Groen-07_0_0.png" />
  <title>{title} | VABOK</title>
</head>
<body class="min-h-screen bg-firda-gray-50 text-firda-grey-900">
  <!-- Header / Navigatie -->
  <header class="bg-firda-blue-600 text-white shadow-md sticky top-0 z-50">
  
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-20">
        <!-- Rechter kant: Logo + Hoofdmenu -->
        <div class="flex items-center gap-12">
          <!-- Logo -->
          <a href="/" class="flex items-center gap-4 hover:opacity-90 transition-opacity group">
            <Image src={LogoVabok} alt="Logo VABOK" class="h-12 w-auto object-contain" loading="eager" />
            <div class="flex flex-col">
              <span class="text-xl font-bold leading-tight tracking-wide group-hover:text-firda-green-400 transition-colors">VABOK</span>
            </div>
          </a>

          <!-- Hoofd Navigatie (Desktop) -->
          <nav class="hidden md:flex items-center space-x-2">
            <a href="/" class="px-4 py-2 rounded-md hover:bg-white/10 hover:text-firda-green-400 transition-all font-medium border-b-2 border-transparent hover:border-firda-green-400">
              Home
            </a>
            <a href="/projecten/lijst" class="px-4 py-2 rounded-md hover:bg-white/10 hover:text-firda-green-400 transition-all font-medium border-b-2 border-transparent hover:border-firda-green-400">
              Projecten
            </a>
            <a href="/#documenten" class="px-4 py-2 rounded-md hover:bg-white/10 hover:text-firda-green-400 transition-all font-medium border-b-2 border-transparent hover:border-firda-green-400">
              Documenten
            </a>
          </nav>
        </div>

        <!-- Linker kant: User Actions -->
        <div class="hidden md:flex items-center gap-6">
          {isLoggedIn ? (
            <>
              <!-- Admin / Dashboard Link -->
              {profile && ['admin', 'project_editor', 'landingpage_editor'].includes(profile.role) && (
                <a href="/dashboard/overzicht" class="flex items-center gap-2 px-4 py-2 bg-firda-green-500 text-firda-blue-900 rounded font-bold hover:bg-firda-green-400 transition shadow-sm">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"></path></svg>
                  <span>Dashboard</span>
                </a>
              )}

              <!-- User Info (Text Only) -->
              {profile && (
                <div class="flex flex-col items-end text-right border-r border-white/20 pr-6 mr-2">
                  <span class="text-sm font-semibold">{profile.full_name || profile.email}</span>
                  <span class="text-xs text-firda-green-400 uppercase tracking-wider font-bold">
                    {roleLabels[profile.role] || profile.role}
                  </span>
                </div>
              )}

              <!-- Logout -->
              <a 
                href="/api/auth/logout" 
                class="text-white/80 hover:text-white transition-colors p-2"
                title="Uitloggen"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                </svg>
              </a>
            </>
          ) : (
            <div class="flex items-center gap-4">
              <a 
                href="/projecten/lijst" 
                class="hidden lg:flex items-center gap-2 px-5 py-2 bg-firda-green-500 text-firda-blue-900 rounded font-bold hover:bg-firda-green-400 transition shadow-sm"
              >
                <span>Bekijk projecten</span>
              </a>
              <a 
                href="/login" 
                class="px-5 py-2 border border-white/30 rounded font-semibold hover:bg-white/10 transition-colors"
              >
                Inloggen
              </a>
            </div>
          )}
        </div>

        <!-- Mobile menu button -->
        <button 
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg hover:bg-white/10 transition text-white"
          aria-label="Menu openen"
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      
      <!-- Mobile menu (Improved) -->
      <nav id="mobile-menu" class="hidden md:hidden py-4 border-t border-white/10">
        <div class="flex flex-col space-y-3">
          <a href="/" class="block px-4 py-2 hover:bg-white/10 rounded transition font-medium">Home</a>
          <a href="/projecten/lijst" class="block px-4 py-2 hover:bg-white/10 rounded transition font-medium">Projecten</a>
          <a href="/#documenten" class="block px-4 py-2 hover:bg-white/10 rounded transition font-medium">Documenten</a>
          
          {isLoggedIn ? (
            <div class="border-t border-white/10 mt-2 pt-2">
              {profile && (
                <div class="px-4 py-2 mb-2">
                  <div class="text-sm opacity-75">Ingelogd als:</div>
                  <div class="font-medium">{profile.email}</div>
                  <div class="text-xs text-firda-green-400 uppercase mt-1">{roleLabels[profile.role] || profile.role}</div>
                </div>
              )}
              
              {profile && ['admin', 'project_editor', 'landingpage_editor'].includes(profile.role) && (
                <a href="/dashboard/overzicht" class="block px-4 py-2 bg-firda-green-500 text-firda-blue-900 font-bold rounded mx-4 text-center my-2">
                  Naar Dashboard
                </a>
              )}
              
              <a href="/api/auth/logout" class="block px-4 py-2 text-red-300 hover:text-red-100 transition">
                Uitloggen
              </a>
            </div>
          ) : (
            <a href="/login" class="block mx-4 py-2 text-center bg-white text-firda-blue-600 font-bold rounded mt-4">
              Inloggen
            </a>
          )}
        </div>
      </nav>
    </div>
  </header>

  <!-- Main content -->
  <main class="flex-grow">
    <slot />
  </main>

  <!-- Footer -->
  <footer class="bg-firda-gray-800 text-firda-gray-300 mt-auto">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <div class="flex flex-col items-center gap-6">
        <div>
          <p class="text-sm text-center">
            &copy; {new Date().getFullYear()} VABOK - Versterken van de Aansluiting in de Beroepskolom
          </p>
          <p class="text-sm text-center">
            Ontwikkeld door <a href="https://firda.nl" class="underline hover:text-firda-green-400 transition">Jorg & Jens</a>
          </p>
        </div>
        
      </div>
    </div>
  </footer>

  <!-- Mobile menu script -->
  <script>
    const mobileMenuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    
    mobileMenuBtn?.addEventListener('click', () => {
      mobileMenu?.classList.toggle('hidden');
    });
  </script>
</body>
</html>

<style is:global>
  @tailwind base;
  @tailwind components;
  @tailwind utilities;
</style>

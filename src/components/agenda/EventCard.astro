---
/**
 * EventCard Component
 * ===================
 * Toont een enkel evenement in een lijst-weergave.
 */

import type { ProjectEvent } from "../../types/database";

interface Props {
    event: ProjectEvent;
    showProject?: boolean;
    projectName?: string;
}

const { event, showProject = false, projectName } = Astro.props;

const startDate = new Date(event.start_date);
const day = startDate.getDate();
const month = startDate
    .toLocaleString("nl-NL", { month: "short" })
    .replace(".", "");
const time = startDate.toLocaleTimeString("nl-NL", {
    hour: "2-digit",
    minute: "2-digit",
});

const location = event.location || "Locatie n.v.t.";

// Check of het event in het verleden ligt
const now = new Date();
const isPast = startDate < now;
---

<div
    class={`group relative bg-white rounded-xl border p-4 transition-all duration-300 overflow-hidden ${isPast ? "border-firda-gray-200 bg-firda-gray-50/50 grayscale-[0.5] opacity-80" : "border-firda-gray-200 hover:border-firda-green-400 hover:shadow-lg hover:shadow-firda-blue-500/5"}`}
>
    <!-- Background Accent -->
    {
        !isPast && (
            <div class="absolute top-0 right-0 -mr-8 -mt-8 w-16 h-16 bg-firda-green-50 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-2xl" />
        )
    }

    <div class="flex items-start gap-4 relative z-10">
        <!-- Datum badge -->
        <div
            class={`flex-shrink-0 w-12 h-12 rounded-lg flex flex-col items-center justify-center border transition-all duration-300 ${isPast ? "bg-firda-gray-100 border-firda-gray-200" : "bg-white border-firda-blue-50 group-hover:border-firda-green-500 group-hover:bg-firda-green-500 shadow-sm"}`}
        >
            <span
                class={`text-xl font-black leading-none tracking-tight ${isPast ? "text-firda-gray-500" : "text-firda-blue-600 group-hover:text-white"}`}
                >{day}</span
            >
            <span
                class={`text-[8px] font-black uppercase tracking-[0.1em] mt-0.5 ${isPast ? "text-firda-gray-400" : "text-firda-blue-400 group-hover:text-firda-green-50"}`}
                >{month}</span
            >
        </div>

        <!-- Content -->
        <div class="flex-grow min-w-0 pt-0.5">
            <div
                class="flex items-center gap-1.5 mb-1.5 uppercase tracking-widest text-[8px] font-black"
            >
                <span class="text-firda-gray-400 italic">Project:</span>
                {
                    showProject && projectName && (
                        <span
                            class={`font-bold transition-colors ${isPast ? "text-firda-gray-500" : "text-firda-green-600"}`}
                        >
                            {projectName}
                        </span>
                    )
                }
            </div>

            <div
                class="text-[8px] font-black text-firda-gray-300 uppercase tracking-[0.2em] mb-0.5"
            >
                Onderwerp
            </div>
            <h3
                class={`text-lg font-bold leading-snug truncate transition-all duration-300 ${isPast ? "text-firda-gray-500" : "text-firda-gray-900 group-hover:text-[19px] group-hover:text-firda-blue-600"}`}
            >
                {event.title}
            </h3>

            {
                event.description && (
                    <div class="mt-2">
                        <div class="text-[8px] font-black text-firda-gray-300 uppercase tracking-[0.2em] mb-0.5">
                            Omschrijving
                        </div>
                        <p
                            class={`text-sm line-clamp-2 ${isPast ? "text-firda-gray-400" : "text-firda-gray-600"}`}
                        >
                            {event.description}
                        </p>
                    </div>
                )
            }

            <div
                class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-3 pt-3 border-t border-firda-gray-50"
            >
                <!-- Tijd -->
                <div
                    class={`flex items-center gap-2 font-bold px-2.5 py-1 rounded-md border text-xs transition-colors ${isPast ? "bg-firda-gray-100 border-firda-gray-200 text-firda-gray-400" : "bg-firda-blue-50/50 border-firda-blue-100/50 text-firda-blue-600 group-hover:bg-firda-green-50 group-hover:border-firda-green-200 group-hover:text-firda-green-700"}`}
                >
                    <span
                        class="text-[9px] font-black uppercase tracking-wider text-firda-blue-300"
                        >Tijd:</span
                    >
                    <span class="tracking-tight">{time}</span>
                </div>

                <!-- Locatie -->
                <div
                    class={`flex items-center gap-2 text-xs ${isPast ? "text-firda-gray-400" : "text-firda-gray-500"}`}
                >
                    <span
                        class="text-[9px] font-black uppercase tracking-wider text-firda-gray-300"
                        >Locatie:</span
                    >
                    <span class="font-medium truncate">{location}</span>
                </div>
            </div>
        </div>

        <!-- Arrow indicator (Subtle premium detail) -->
        <div
            class="hidden sm:flex items-center justify-center w-8 h-8 rounded-full bg-firda-gray-50 text-firda-gray-400 group-hover:bg-firda-green-500 group-hover:text-white transition-all duration-300 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    </div>
</div>

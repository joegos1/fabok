---
/**
 * EventCard Component
 * ===================
 * Toont een enkel evenement in een lijst-weergave.
 */

import type { ProjectEvent } from "../../types/database";

interface Props {
    event: ProjectEvent;
    showProject?: boolean;
    projectName?: string;
}

const { event, showProject = false, projectName } = Astro.props;

const startDate = new Date(event.start_date);
const day = startDate.getDate();
const month = startDate
    .toLocaleString("nl-NL", { month: "short" })
    .replace(".", "");
const time = startDate.toLocaleTimeString("nl-NL", {
    hour: "2-digit",
    minute: "2-digit",
});

const location = event.location || "Locatie n.v.t.";
---

<div
    class="group bg-white rounded-xl border border-firda-gray-200 p-4 hover:border-firda-blue-300 hover:shadow-md transition-all duration-300"
>
    <div class="flex items-start gap-4">
        <!-- Datum badge -->
        <div
            class="flex-shrink-0 w-16 h-16 bg-firda-blue-50 rounded-lg flex flex-col items-center justify-center border border-firda-blue-100 group-hover:bg-firda-blue-600 group-hover:border-firda-blue-600 transition-colors duration-300"
        >
            <span
                class="text-2xl font-bold text-firda-blue-600 group-hover:text-white leading-none"
                >{day}</span
            >
            <span
                class="text-xs font-bold text-firda-blue-400 group-hover:text-firda-blue-100 uppercase tracking-wider"
                >{month}</span
            >
        </div>

        <!-- Content -->
        <div class="flex-grow min-w-0">
            <div class="flex items-start justify-between gap-2 mb-1">
                <h3
                    class="font-bold text-firda-gray-900 truncate group-hover:text-firda-blue-600 transition-colors"
                >
                    {event.title}
                </h3>
                <span
                    class="text-xs font-medium text-firda-gray-500 whitespace-nowrap bg-firda-gray-100 px-2 py-0.5 rounded"
                >
                    {time}
                </span>
            </div>

            {
                showProject && projectName && (
                    <p class="text-xs font-semibold text-firda-blue-600 mb-1 uppercase tracking-tight">
                        {projectName}
                    </p>
                )
            }

            <div class="flex items-center text-sm text-firda-gray-500 gap-3">
                <div class="flex items-center gap-1.5 truncate">
                    <svg
                        class="w-4 h-4 flex-shrink-0 text-firda-gray-400"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="truncate">{location}</span>
                </div>
            </div>
        </div>
    </div>
</div>

---
/**
 * EventCard Component
 * ===================
 * Toont een enkel evenement in een lijst-weergave.
 */

import type { ProjectEvent } from "../../types/database";

interface Props {
    event: ProjectEvent;
    showProject?: boolean;
    projectName?: string;
}

const { event, showProject = false, projectName } = Astro.props;

const startDate = new Date(event.start_date);
const day = startDate.getDate();
const month = startDate
    .toLocaleString("nl-NL", { month: "short" })
    .replace(".", "");
const time = startDate.toLocaleTimeString("nl-NL", {
    hour: "2-digit",
    minute: "2-digit",
});

const location = event.location || "Locatie n.v.t.";

// Check of het event in het verleden ligt
const now = new Date();
const isPast = startDate < now;
---

<div
    class={`group relative bg-white rounded-xl border p-4 transition-all duration-300 overflow-hidden ${isPast ? "border-firda-gray-200 bg-firda-gray-50/50 grayscale-[0.5] opacity-80" : "border-firda-gray-200 hover:border-firda-green-400 hover:shadow-lg hover:shadow-firda-blue-500/5"}`}
>
    <!-- Background Accent -->
    {
        !isPast && (
            <div class="absolute top-0 right-0 -mr-8 -mt-8 w-16 h-16 bg-firda-green-50 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-2xl"></div>
        )
    }

    <div class="flex items-start gap-4 relative z-10">
        <!-- Datum badge -->
        <div
            class={`flex-shrink-0 w-12 h-12 rounded-lg flex flex-col items-center justify-center border transition-all duration-300 ${isPast ? "bg-firda-gray-100 border-firda-gray-200" : "bg-white border-firda-blue-50 group-hover:border-firda-green-500 group-hover:bg-firda-green-500 shadow-sm"}`}
        >
            <span
                class={`text-xl font-black leading-none tracking-tight ${isPast ? "text-firda-gray-500" : "text-firda-blue-600 group-hover:text-white"}`}
                >{day}</span
            >
            <span
                class={`text-[8px] font-black uppercase tracking-[0.1em] mt-0.5 ${isPast ? "text-firda-gray-400" : "text-firda-blue-400 group-hover:text-firda-green-50"}`}
                >{month}</span
            >
        </div>

        <!-- Content -->
        <div class="flex-grow min-w-0 pt-0.5">
            <div class="flex items-center gap-2 mb-1">
                {
                    showProject && projectName && (
                        <span
                            class={`text-[8px] font-bold px-1.5 py-0.5 rounded-full uppercase tracking-wider ${isPast ? "bg-firda-gray-200 text-firda-gray-500" : "bg-firda-green-50 text-firda-green-600"}`}
                        >
                            {projectName}
                        </span>
                    )
                }
            </div>

            <h3
                class={`text-base font-bold leading-snug truncate transition-colors ${isPast ? "text-firda-gray-500" : "text-firda-gray-900 group-hover:text-firda-blue-600"}`}
            >
                {event.title}
            </h3>

            {
                event.description && (
                    <p
                        class={`text-xs mt-1 line-clamp-2 ${isPast ? "text-firda-gray-400" : "text-firda-gray-600"}`}
                    >
                        {event.description}
                    </p>
                )
            }

            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-2">
                <!-- Tijd -->
                <div
                    class={`flex items-center gap-1 font-bold px-2 py-0.5 rounded-md border text-[10px] transition-colors ${isPast ? "bg-firda-gray-100 border-firda-gray-200 text-firda-gray-400" : "bg-firda-blue-50/50 border-firda-blue-100/50 text-firda-blue-600 group-hover:bg-firda-green-50 group-hover:border-firda-green-200 group-hover:text-firda-green-700"}`}
                >
                    <svg
                        class="w-3 h-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    <span class="tracking-tight">{time}</span>
                </div>

                <!-- Locatie -->
                <div
                    class={`flex items-center gap-1 text-[10px] ${isPast ? "text-firda-gray-400" : "text-firda-gray-500"}`}
                >
                    <svg
                        class={`w-3 h-3 flex-shrink-0 transition-colors ${isPast ? "text-firda-gray-300" : "text-firda-gray-300 group-hover:text-firda-green-500"}`}
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="font-medium truncate">{location}</span>
                </div>
            </div>
        </div>

        <!-- Arrow indicator (Subtle premium detail) -->
        <div
            class="hidden sm:flex items-center justify-center w-8 h-8 rounded-full bg-firda-gray-50 text-firda-gray-400 group-hover:bg-firda-green-500 group-hover:text-white transition-all duration-300 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    </div>
</div>

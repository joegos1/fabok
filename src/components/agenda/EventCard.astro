---
/**
 * EventCard Component
 * ===================
 * Toont een enkel evenement in een lijst-weergave.
 */

import type { ProjectEvent } from "../../types/database";

interface Props {
    event: ProjectEvent;
    showProject?: boolean;
    projectName?: string;
}

const { event, showProject = false, projectName } = Astro.props;

const startDate = new Date(event.start_date);
const day = startDate.getDate();
const month = startDate
    .toLocaleString("nl-NL", { month: "short" })
    .replace(".", "");
const time = startDate.toLocaleTimeString("nl-NL", {
    hour: "2-digit",
    minute: "2-digit",
});

const location = event.location || "Locatie n.v.t.";
---

<div
    class="group relative bg-white rounded-2xl border border-firda-gray-200 p-5 hover:border-firda-green-400 hover:shadow-xl hover:shadow-firda-blue-500/5 transition-all duration-500 ease-out hover:-translate-y-1 overflow-hidden"
>
    <!-- Background Accent -->
    <div
        class="absolute top-0 right-0 -mr-8 -mt-8 w-24 h-24 bg-firda-green-50 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 blur-2xl"
    >
    </div>

    <div class="flex items-center gap-5 relative z-10">
        <!-- Datum badge -->
        <div
            class="flex-shrink-0 w-16 h-16 bg-white rounded-xl flex flex-col items-center justify-center border-2 border-firda-blue-50 shadow-sm group-hover:border-firda-green-500 group-hover:bg-firda-green-500 transition-all duration-300 transform group-hover:scale-105"
        >
            <span
                class="text-2xl font-black text-firda-blue-600 group-hover:text-white leading-none tracking-tight"
                >{day}</span
            >
            <span
                class="text-[10px] font-black text-firda-blue-400 group-hover:text-firda-green-50 uppercase tracking-[0.15em] mt-0.5"
                >{month}</span
            >
        </div>

        <!-- Content -->
        <div class="flex-grow min-w-0">
            <div class="flex items-center gap-2 mb-0.5">
                {
                    showProject && projectName && (
                        <span class="text-[10px] font-bold text-firda-green-600 bg-firda-green-50 px-2 py-0.5 rounded-full uppercase tracking-wider">
                            {projectName}
                        </span>
                    )
                }
            </div>

            <h3
                class="text-lg font-bold text-firda-gray-900 leading-snug truncate group-hover:text-firda-blue-600 transition-colors"
            >
                {event.title}
            </h3>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2">
                <!-- Tijd (Nu prominenter) -->
                <div
                    class="flex items-center gap-1.5 text-firda-blue-600 font-bold bg-firda-blue-50/50 px-2.5 py-1 rounded-lg border border-firda-blue-100/50 group-hover:bg-firda-green-50 group-hover:border-firda-green-200 group-hover:text-firda-green-700 transition-colors"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    <span class="text-sm tracking-tight">{time}</span>
                </div>

                <!-- Locatie -->
                <div class="flex items-center gap-1.5 text-firda-gray-500">
                    <svg
                        class="w-4 h-4 flex-shrink-0 text-firda-gray-300 group-hover:text-firda-green-500 transition-colors"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <span class="text-xs font-medium truncate">{location}</span>
                </div>
            </div>
        </div>

        <!-- Arrow indicator (Subtle premium detail) -->
        <div
            class="hidden sm:flex items-center justify-center w-8 h-8 rounded-full bg-firda-gray-50 text-firda-gray-400 group-hover:bg-firda-green-500 group-hover:text-white transition-all duration-300 opacity-0 group-hover:opacity-100 transform translate-x-2 group-hover:translate-x-0"
        >
            <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M9 5l7 7-7 7"></path>
            </svg>
        </div>
    </div>
</div>

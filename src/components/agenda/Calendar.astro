---
/**
 * Calendar Component
 * ==================
 * Interactieve maandkalender met events.
 * - Toont volledig maand in 7-koloms grid
 * - Dagen met events zijn gemarkeerd
 * - Klik op dag toont events van die dag
 * - Klik op event opent detail popup met inschrijfformulier
 */

import EventCard from "./EventCard.astro";
import EventModal from "./EventModal.astro";
import type { ProjectEvent } from "../../types/database";

interface Props {
    events: (ProjectEvent & { projects?: { title: string } })[];
}

const { events } = Astro.props;

// Get current month/year from URL or use today
const today = new Date();
const currentMonth = today.getMonth();
const currentYear = today.getFullYear();

// Calculate calendar days
function getDaysInMonth(month: number, year: number) {
    return new Date(year, month + 1, 0).getDate();
}

function getFirstDayOfMonth(month: number, year: number) {
    return new Date(year, month, 1).getDay(); // 0 = Sunday
}

const daysInMonth = getDaysInMonth(currentMonth, currentYear);
const firstDay = getFirstDayOfMonth(currentMonth, currentYear);
const prevMonthDays = getDaysInMonth(currentMonth - 1, currentYear);

// Build calendar grid
const calendarDays: (number | null)[] = [];

// Fill previous month days
for (let i = firstDay - 1; i >= 0; i--) {
    calendarDays.push(null);
}

// Fill current month days
for (let i = 1; i <= daysInMonth; i++) {
    calendarDays.push(i);
}

// Fill next month days
const remainingDays = 42 - calendarDays.length; // 6 rows * 7 days
for (let i = 1; i <= remainingDays; i++) {
    calendarDays.push(null);
}

// Helper: Check if day has events
function dayHasEvents(day: number): boolean {
    if (!day) return false;
    const date = new Date(currentYear, currentMonth, day);
    const dateString = date.toISOString().split("T")[0];
    return events.some((e) => e.start_date.split("T")[0] === dateString);
}

// Helper: Get events for a specific day
function getEventsForDay(day: number): (ProjectEvent & { projects?: { title: string } })[] {
    if (!day) return [];
    const date = new Date(currentYear, currentMonth, day);
    const dateString = date.toISOString().split("T")[0];
    return events.filter((e) => e.start_date.split("T")[0] === dateString);
}

// Month and year labels
const monthNames = [
    "Januari",
    "Februari",
    "Maart",
    "April",
    "Mei",
    "Juni",
    "Juli",
    "Augustus",
    "September",
    "Oktober",
    "November",
    "December",
];
const monthLabel = monthNames[currentMonth];
const yearLabel = currentYear;
---

<div class="space-y-6">
    <!-- Header with navigation -->
    <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-firda-gray-900">Agenda</h2>
        <div class="h-1 w-12 bg-firda-green-500 rounded-full"></div>
    </div>

    <div class="bg-white rounded-lg border border-firda-gray-200 p-6">
        <!-- Month/Year Header and Navigation -->
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-lg font-bold text-firda-gray-900">
                {monthLabel} {yearLabel}
            </h3>
            <div class="flex gap-2">
                <button
                    id="prevMonth"
                    class="px-3 py-2 text-firda-gray-600 hover:text-firda-blue-600 hover:bg-firda-blue-50 rounded-lg transition"
                    title="Vorige maand"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 19l-7-7 7-7"></path>
                    </svg>
                </button>
                <button
                    id="nextMonth"
                    class="px-3 py-2 text-firda-gray-600 hover:text-firda-blue-600 hover:bg-firda-blue-50 rounded-lg transition"
                    title="Volgende maand"
                >
                    <svg
                        class="w-5 h-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Weekday headers -->
        <div class="grid grid-cols-7 gap-2 mb-4">
            {
                ["Ma", "Di", "Wo", "Do", "Vr", "Za", "Zo"].map((day) => (
                    <div class="text-center text-sm font-semibold text-firda-gray-500 py-2">
                        {day}
                    </div>
                ))
            }
        </div>

        <!-- Calendar grid -->
        <div class="grid grid-cols-7 gap-2">
            {
                calendarDays.map((day) => {
                    const hasEvents = day ? dayHasEvents(day) : false;
                    const isCurrentMonth = day !== null;
                    const isToday =
                        day === today.getDate() &&
                        currentMonth === today.getMonth() &&
                        currentYear === today.getFullYear();

                    return (
                        <button
                            data-day={day}
                            class={`aspect-square rounded-lg border-2 transition-all text-sm font-medium flex items-center justify-center relative
                                ${!isCurrentMonth
                                    ? "bg-firda-gray-50 border-transparent text-firda-gray-300 cursor-default"
                                    : isToday
                                      ? "border-firda-blue-600 bg-firda-blue-50 text-firda-gray-900 font-bold"
                                      : hasEvents
                                        ? "border-firda-green-500 bg-firda-green-50 text-firda-gray-900 cursor-pointer hover:shadow-md"
                                        : "border-firda-gray-200 text-firda-gray-700 hover:border-firda-blue-300 hover:bg-firda-blue-50"
                            }`}
                            onclick={!isCurrentMonth ? undefined : `window.selectDay(${day})`}
                            disabled={!isCurrentMonth}
                        >
                            <span>{day}</span>
                            {hasEvents && (
                                <span class="absolute bottom-1 right-1 w-2 h-2 bg-firda-green-500 rounded-full"></span>
                            )}
                        </button>
                    );
                })
            }
        </div>
    </div>

    <!-- Selected day events -->
    <div id="selectedDayEvents" class="space-y-4"></div>
</div>

<!-- Event detail modal -->
<EventModal />

<script define:vars={{ calendarEvents: events }}>
    // Make events available globally for modal and day selection
    window.__CALENDAR_EVENTS__ = calendarEvents;
    
    // Global state for calendar
    interface Window {
        selectedDay: number | null;
        currentMonth: number;
        currentYear: number;
        calendarEvents: any[];
        __CALENDAR_EVENTS__: any[];
        selectDay: (day: number) => void;
    }

    window.selectedDay = new Date().getDate();
    window.currentMonth = new Date().getMonth();
    window.currentYear = new Date().getFullYear();
    window.calendarEvents = window.__CALENDAR_EVENTS__ || [];

    function renderSelectedDayEvents() {
        const container = document.getElementById("selectedDayEvents");
        if (!container) return;

        if (!window.selectedDay) {
            container.innerHTML = "";
            return;
        }

        // Get events for selected day
        const date = new Date(
            window.currentYear,
            window.currentMonth,
            window.selectedDay,
        );
        const dateString = date.toISOString().split("T")[0];
        const dayEvents = window.calendarEvents.filter(
            (e) => e.start_date.split("T")[0] === dateString,
        );

        if (dayEvents.length === 0) {
            container.innerHTML =
                '<p class="text-center text-firda-gray-500 py-4">Geen evenementen op deze dag</p>';
            return;
        }

        // Format date for display
        const formatter = new Intl.DateTimeFormat("nl-NL", {
            weekday: "long",
            day: "numeric",
            month: "long",
            year: "numeric",
        });
        const dateLabel = formatter.format(date);

        let html = `<div class="space-y-2">
            <h3 class="font-semibold text-firda-gray-900 mb-4">Evenementen op ${dateLabel}</h3>
            <div class="grid gap-4">`;

        dayEvents.forEach((event) => {
            const startDate = new Date(event.start_date);
            const day = startDate.getDate();
            const month = startDate
                .toLocaleString("nl-NL", { month: "short" })
                .replace(".", "");
            const time = startDate.toLocaleTimeString("nl-NL", {
                hour: "2-digit",
                minute: "2-digit",
            });
            const location = event.location || "Locatie n.v.t.";

            html += `
                <div class="group bg-white rounded-xl border border-firda-gray-200 p-4 hover:border-firda-blue-300 hover:shadow-md transition-all duration-300 cursor-pointer" onclick="window.openEventModal('${event.id}')">
                    <div class="flex items-start gap-4">
                        <div class="flex-shrink-0 w-16 h-16 bg-firda-blue-50 rounded-lg flex flex-col items-center justify-center border border-firda-blue-100 group-hover:bg-firda-blue-600 group-hover:border-firda-blue-600 transition-colors duration-300">
                            <span class="text-2xl font-bold text-firda-blue-600 group-hover:text-white leading-none">${day}</span>
                            <span class="text-xs font-bold text-firda-blue-400 group-hover:text-firda-blue-100 uppercase tracking-wider">${month}</span>
                        </div>
                        <div class="flex-grow min-w-0">
                            <div class="flex items-start justify-between gap-2 mb-1">
                                <h3 class="font-bold text-firda-gray-900 truncate group-hover:text-firda-blue-600 transition-colors">${event.title}</h3>
                                <span class="text-xs font-medium text-firda-gray-500 whitespace-nowrap bg-firda-gray-100 px-2 py-0.5 rounded">${time}</span>
                            </div>
                            <div class="flex items-center text-sm text-firda-gray-500 gap-3">
                                <div class="flex items-center gap-1.5 truncate">
                                    <svg class="w-4 h-4 flex-shrink-0 text-firda-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                    <span class="truncate">${location}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        });

        html += `</div></div>`;
        container.innerHTML = html;
    }

    window.selectDay = function (day: number) {
        window.selectedDay = day;
        renderSelectedDayEvents();
    };

    window.openEventModal = function (eventId: string) {
        const event = window.calendarEvents.find((e) => e.id === eventId);
        if (event) {
            const modal = document.getElementById("eventModal");
            if (modal && (modal as any).showEvent) {
                (modal as any).showEvent(event);
            }
        }
    };

    // Initial render
    renderSelectedDayEvents();
</script>

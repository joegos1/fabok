---
/**
 * EventModal Component
 * ====================
 * Popup dialog voor event details en inschrijfformulier
 * - Toont event titel, datum, tijd, locatie, beschrijving
 * - Inschrijfformulier met velden: voornaam*, achternaam*, email*, bedrijf
 * - Sluit via X-button of klik buiten modal
 */
---

<div
    id="eventModal"
    class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 p-4"
    onclick="if(event.target.id === 'eventModal') { (event.target as any).closeModal(); }"
>
    <div
        class="bg-white rounded-xl shadow-xl max-w-2xl w-full max-h-[90vh] overflow-y-auto"
        onclick="event.stopPropagation()"
    >
        <!-- Header with close button -->
        <div class="sticky top-0 bg-white border-b border-firda-gray-200 p-6 flex items-start justify-between">
            <div>
                <h2 id="eventTitle" class="text-2xl font-bold text-firda-gray-900">
                    Event Title
                </h2>
            </div>
            <button
                class="text-firda-gray-400 hover:text-firda-gray-600 transition"
                onclick="(document.getElementById('eventModal') as any).closeModal()"
            >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Content -->
        <div class="p-6 space-y-6">
            <!-- Event details -->
            <div class="space-y-4">
                <div class="flex items-start gap-4">
                    <svg
                        class="w-5 h-5 text-firda-gray-400 flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        ></path>
                    </svg>
                    <div>
                        <p class="text-sm text-firda-gray-500">Datum en tijd</p>
                        <p id="eventDateTime" class="font-medium text-firda-gray-900">
                            -
                        </p>
                    </div>
                </div>

                <div class="flex items-start gap-4">
                    <svg
                        class="w-5 h-5 text-firda-gray-400 flex-shrink-0 mt-0.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                        ></path>
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    </svg>
                    <div>
                        <p class="text-sm text-firda-gray-500">Locatie</p>
                        <p id="eventLocation" class="font-medium text-firda-gray-900">-</p>
                    </div>
                </div>

                <div id="descriptionSection" class="hidden">
                    <p class="text-sm text-firda-gray-500 mb-2">Beschrijving</p>
                    <p id="eventDescription" class="text-firda-gray-700"></p>
                </div>
            </div>

            <!-- Signup form -->
            <div class="border-t border-firda-gray-200 pt-6">
                <h3 class="text-lg font-semibold text-firda-gray-900 mb-4">
                    Inschrijven voor dit evenement
                </h3>

                <form id="signupForm" class="space-y-4" onsubmit="handleSignup(event)">
                    <!-- Voornaam -->
                    <div>
                        <label
                            for="firstName"
                            class="block text-sm font-medium text-firda-gray-700 mb-1"
                        >
                            Voornaam <span class="text-orange-600">*</span>
                        </label>
                        <input
                            type="text"
                            id="firstName"
                            name="firstName"
                            required
                            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-firda-blue-500 focus:border-transparent transition"
                            placeholder="Jan"
                        />
                    </div>

                    <!-- Achternaam -->
                    <div>
                        <label
                            for="lastName"
                            class="block text-sm font-medium text-firda-gray-700 mb-1"
                        >
                            Achternaam <span class="text-orange-600">*</span>
                        </label>
                        <input
                            type="text"
                            id="lastName"
                            name="lastName"
                            required
                            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-firda-blue-500 focus:border-transparent transition"
                            placeholder="Jansen"
                        />
                    </div>

                    <!-- Email -->
                    <div>
                        <label
                            for="email"
                            class="block text-sm font-medium text-firda-gray-700 mb-1"
                        >
                            Email <span class="text-orange-600">*</span>
                        </label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            required
                            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-firda-blue-500 focus:border-transparent transition"
                            placeholder="jan@voorbeeld.nl"
                        />
                    </div>

                    <!-- Bedrijf (optional) -->
                    <div>
                        <label
                            for="company"
                            class="block text-sm font-medium text-firda-gray-700 mb-1"
                        >
                            Bedrijf
                        </label>
                        <input
                            type="text"
                            id="company"
                            name="company"
                            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-firda-blue-500 focus:border-transparent transition"
                            placeholder="Mijn Bedrijf"
                        />
                    </div>

                    <!-- Submit button -->
                    <div class="pt-4">
                        <button
                            type="submit"
                            class="w-full px-4 py-3 bg-firda-blue-600 text-white font-medium rounded-lg hover:bg-firda-blue-700 transition"
                        >
                            Inschrijven
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    const eventModal = document.getElementById("eventModal") as any;

    if (eventModal) {
        eventModal.showEvent = function (event: any) {
            // Set event details
            document.getElementById("eventTitle")!.textContent = event.title;

            const startDate = new Date(event.start_date);
            const formatter = new Intl.DateTimeFormat("nl-NL", {
                weekday: "long",
                day: "numeric",
                month: "long",
                year: "numeric",
                hour: "2-digit",
                minute: "2-digit",
            });
            document.getElementById("eventDateTime")!.textContent =
                formatter.format(startDate);

            document.getElementById("eventLocation")!.textContent =
                event.location || "Locatie n.v.t.";

            // Show description if available
            const descriptionSection = document.getElementById(
                "descriptionSection",
            );
            if (event.description) {
                descriptionSection?.classList.remove("hidden");
                document.getElementById("eventDescription")!.textContent =
                    event.description;
            } else {
                descriptionSection?.classList.add("hidden");
            }

            // Reset form
            const form = document.getElementById("signupForm") as HTMLFormElement;
            if (form) {
                form.reset();
            }

            // Store current event ID for form submission
            (eventModal as any).currentEventId = event.id;

            // Show modal
            eventModal.classList.remove("hidden");
        };

        eventModal.closeModal = function () {
            eventModal.classList.add("hidden");
        };
    }

    // Handle form submission (UI only for now)
    function handleSignup(e: Event) {
        e.preventDefault();

        const form = e.target as HTMLFormElement;
        const firstName = (
            form.querySelector("#firstName") as HTMLInputElement
        ).value;
        const lastName = (
            form.querySelector("#lastName") as HTMLInputElement
        ).value;
        const email = (form.querySelector("#email") as HTMLInputElement).value;
        const company = (
            form.querySelector("#company") as HTMLInputElement
        ).value;

        console.log("Signup submitted (UI only):", {
            firstName,
            lastName,
            email,
            company,
            eventId: (eventModal as any).currentEventId,
        });

        // Show success message
        alert(
            `Bedankt voor je inschrijving, ${firstName}! Backend-integratie volgt.`,
        );

        // Close modal
        eventModal.closeModal();
    }

    // Close on Escape key
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !eventModal.classList.contains("hidden")) {
            eventModal.closeModal();
        }
    });
</script>

---
/**
 * EventSignupModal Component
 * ==========================
 * Een stijlvol modal voor het aanmelden bij evenementen.
 */

interface Props {
    eventId: string;
    eventTitle: string;
}

const { eventId, eventTitle } = Astro.props;
---

<dialog
    id={`signup-modal-${eventId}`}
    class="fixed inset-0 z-50 p-0 m-auto bg-transparent backdrop:bg-firda-gray-900/60 backdrop:backdrop-blur-sm shadow-2xl rounded-2xl w-full max-w-md overflow-hidden transform transition-all duration-300 scale-95 opacity-0 open:scale-100 open:opacity-100"
>
    <div
        class="bg-white/90 backdrop-blur-md p-8 relative border border-white/20"
    >
        <!-- Close Button -->
        <button
            onclick={`document.getElementById('signup-modal-${eventId}').close()`}
            class="absolute top-4 right-4 p-2 rounded-full text-firda-gray-400 hover:text-firda-blue-600 hover:bg-firda-blue-50 transition-all duration-300"
        >
            <svg
                class="w-6 h-6"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>

        <div class="text-center mb-8">
            <div
                class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-firda-green-500 text-white mb-4 shadow-lg shadow-firda-green-500/20 rotate-3"
            >
                <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"
                    ></path>
                </svg>
            </div>
            <h2 class="text-2xl font-black text-firda-gray-900 tracking-tight">
                Meld je aan
            </h2>
            <p class="text-firda-gray-500 text-sm mt-1">
                Voor het evenement: <span class="font-bold text-firda-blue-600"
                    >{eventTitle}</span>
            </p>
        </div>

        <form id={`signup-form-${eventId}`} class="space-y-4">
            <input type="hidden" name="event_id" value={eventId} />

            <div class="grid grid-cols-2 gap-4">
                <div class="space-y-1">
                    <label
                        class="text-[10px] font-black uppercase tracking-widest text-firda-gray-400 ml-1"
                        >Voornaam</label
                    >
                    <input
                        type="text"
                        name="first_name"
                        required
                        class="w-full px-4 py-3 bg-firda-gray-50 border border-firda-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-firda-blue-500/20 focus:border-firda-blue-500 transition-all duration-300"
                        placeholder="Jan"
                    />
                </div>
                <div class="space-y-1">
                    <label
                        class="text-[10px] font-black uppercase tracking-widest text-firda-gray-400 ml-1"
                        >Tussenvoegsel</label
                    >
                    <input
                        type="text"
                        name="middle_name"
                        class="w-full px-4 py-3 bg-firda-gray-50 border border-firda-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-firda-blue-500/20 focus:border-firda-blue-500 transition-all duration-300"
                        placeholder="van"
                    />
                </div>
            </div>

            <div class="space-y-1">
                <label
                    class="text-[10px] font-black uppercase tracking-widest text-firda-gray-400 ml-1"
                    >Achternaam</label
                >
                <input
                    type="text"
                    name="last_name"
                    required
                    class="w-full px-4 py-3 bg-firda-gray-50 border border-firda-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-firda-blue-500/20 focus:border-firda-blue-500 transition-all duration-300"
                    placeholder="de Vries"
                />
            </div>

            <div class="space-y-1">
                <label
                    class="text-[10px] font-black uppercase tracking-widest text-firda-gray-400 ml-1"
                    >E-mailadres</label
                >
                <input
                    type="email"
                    name="email"
                    required
                    class="w-full px-4 py-3 bg-firda-gray-50 border border-firda-gray-100 rounded-xl focus:outline-none focus:ring-2 focus:ring-firda-blue-500/20 focus:border-firda-blue-500 transition-all duration-300"
                    placeholder="jan@voorbeeld.nl"
                />
            </div>

            <div class="pt-4">
                <button
                    type="submit"
                    class="w-full py-4 bg-firda-gray-900 text-white font-black rounded-xl hover:bg-firda-blue-600 hover:shadow-xl hover:shadow-firda-blue-600/20 transform hover:-translate-y-0.5 active:scale-95 transition-all duration-300 flex items-center justify-center gap-2 group"
                >
                    <span>Meld mij aan</span>
                    <svg
                        class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                    </svg>
                </button>
            </div>
        </form>

        <div
            id={`signup-success-${eventId}`}
            class="hidden text-center py-8 space-y-4"
        >
            <div
                class="w-20 h-20 bg-firda-green-500 text-white rounded-full flex items-center justify-center mx-auto shadow-xl shadow-firda-green-500/30"
            >
                <svg
                    class="w-10 h-10"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="3"
                        d="M5 13l4 4L19 7"></path>
                </svg>
            </div>
            <div>
                <h3 class="text-xl font-black text-firda-gray-900">Gelukt!</h3>
                <p class="text-firda-gray-500 mt-2">
                    Je aanmelding voor <span
                        class="text-firda-blue-600 font-bold">{eventTitle}</span
                    > is succesvol verwerkt.
                </p>
            </div>
            <button
                onclick={`document.getElementById('signup-modal-${eventId}').close()`}
                class="px-8 py-3 bg-firda-gray-100 text-firda-gray-600 font-bold rounded-xl hover:bg-firda-gray-200 transition-all"
            >
                Sluiten
            </button>
        </div>
    </div>
</dialog>

<script define:vars={{ eventId }}>
    const form = document.getElementById(`signup-form-${eventId}`);
    const successDiv = document.getElementById(`signup-success-${eventId}`);

    form?.addEventListener("submit", async (e) => {
        e.preventDefault();

        const submitBtn = form.querySelector('button[type="submit"]');
        if (submitBtn) {
            submitBtn.disabled = true;
            submitBtn.innerHTML =
                '<span class="animate-spin w-5 h-5 border-2 border-white border-t-transparent rounded-full"></span>';
        }

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());

        try {
            const response = await fetch("/api/agenda/register", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(data),
            });

            const result = await response.json();

            if (response.ok) {
                form.classList.add("hidden");
                successDiv.classList.remove("hidden");
                // Optioneel: refresh pagina na een paar seconden om teller bij te werken
                setTimeout(() => {
                    window.location.reload();
                }, 3000);
            } else {
                alert(result.error || "Er is een fout opgetreden.");
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = "<span>Meld mij aan</span>";
                }
            }
        } catch (error) {
            console.error("Error:", error);
            alert("Er is een fout opgetreden bij de verbinding.");
            if (submitBtn) {
                submitBtn.disabled = false;
                submitBtn.innerHTML = "<span>Meld mij aan</span>";
            }
        }
    });

    // Close on click outside
    const modal = document.getElementById(`signup-modal-${eventId}`);
    modal?.addEventListener("click", (e) => {
        const dialogDimensions = modal.getBoundingClientRect();
        if (
            e.clientX < dialogDimensions.left ||
            e.clientX > dialogDimensions.right ||
            e.clientY < dialogDimensions.top ||
            e.clientY > dialogDimensions.bottom
        ) {
            modal.close();
        }
    });
</script>

<style>
    dialog::backdrop {
        animation: backdrop-fade-in 0.4s ease forwards;
    }

    @keyframes backdrop-fade-in {
        from {
            opacity: 0;
            backdrop-filter: blur(0);
        }
        to {
            opacity: 1;
            backdrop-filter: blur(4px);
        }
    }

    dialog[open] {
        animation: modal-pop-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    }

    @keyframes modal-pop-in {
        from {
            opacity: 0;
            transform: scale(0.9) translateY(20px);
        }
        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }
</style>

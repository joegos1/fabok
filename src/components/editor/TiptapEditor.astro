---
/**
 * Tiptap Rich Text Editor Component
 * ==================================
 * WYSIWYG editor met toolbar voor rijke tekst en afbeelding upload
 */

export interface Props {
  initialContent?: string;
  projectId: string;
  fieldName?: string;
}

const { initialContent = '', projectId, fieldName = 'full_description' } = Astro.props;
---

<div class="tiptap-editor-wrapper">
  <!-- Hidden input voor form submission -->
  <input type="hidden" id={fieldName} name={fieldName} value={initialContent} />
  
  <!-- Toolbar -->
  <div class="tiptap-toolbar" id="tiptap-toolbar">
    <div class="toolbar-group">
      <button type="button" data-action="bold" title="Vet (Ctrl+B)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 4h8a4 4 0 014 4 4 4 0 01-4 4H6z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 12h9a4 4 0 014 4 4 4 0 01-4 4H6z"></path>
        </svg>
      </button>
      <button type="button" data-action="italic" title="Cursief (Ctrl+I)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
        </svg>
      </button>
      <button type="button" data-action="strike" title="Doorhalen">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12h18M9 5v14M15 5v14"></path>
        </svg>
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <div class="toolbar-group">
      <button type="button" data-action="heading" data-level="2" title="Heading 2">
        <span class="font-semibold">H2</span>
      </button>
      <button type="button" data-action="heading" data-level="3" title="Heading 3">
        <span class="font-semibold">H3</span>
      </button>
      <button type="button" data-action="paragraph" title="Paragraaf">
        <span>P</span>
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <div class="toolbar-group">
      <button type="button" data-action="bulletList" title="Opsomming">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
      <button type="button" data-action="orderedList" title="Genummerde lijst">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5h12M9 12h12M9 19h12M5 5v14"></path>
        </svg>
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <div class="toolbar-group">
      <button type="button" data-action="blockquote" title="Citaat">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
        </svg>
      </button>
    </div>

    <div class="toolbar-divider"></div>

    <div class="toolbar-group">
      <button type="button" data-action="image" title="Afbeelding toevoegen">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
      </button>
      <input 
        type="file" 
        id="tiptap-image-input" 
        accept="image/jpeg,image/png,image/gif,image/webp"
        style="display: none;"
      />
    </div>

    <div class="toolbar-divider"></div>

    <div class="toolbar-group">
      <button type="button" data-action="undo" title="Ongedaan maken (Ctrl+Z)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path>
        </svg>
      </button>
      <button type="button" data-action="redo" title="Opnieuw (Ctrl+Y)">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 10h-10a8 8 0 00-8 8v2m18-10l-6 6m6-6l-6-6"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Editor Content -->
  <div 
    id="tiptap-editor" 
    class="tiptap-content"
  ></div>

  <!-- Loading indicator voor image upload -->
  <div id="tiptap-upload-status" class="upload-status" style="display: none;">
    <span class="loading-text">Afbeelding uploaden...</span>
  </div>
</div>

<style>
  .tiptap-editor-wrapper {
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .tiptap-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    padding: 0.5rem;
    background-color: #f9fafb;
    border-bottom: 1px solid #d1d5db;
  }

  .toolbar-group {
    display: flex;
    gap: 0.125rem;
  }

  .toolbar-divider {
    width: 1px;
    background-color: #d1d5db;
    margin: 0.25rem 0.5rem;
  }

  .tiptap-toolbar button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    padding: 0.25rem;
    border: none;
    background-color: transparent;
    color: #374151;
    border-radius: 0.25rem;
    cursor: pointer;
    transition: background-color 0.15s;
  }

  .tiptap-toolbar button:hover {
    background-color: #e5e7eb;
  }

  .tiptap-toolbar button.is-active {
    background-color: #3B5755;
    color: white;
  }

  .tiptap-toolbar button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tiptap-content {
    min-height: 300px;
    padding: 1rem;
    background-color: white;
    overflow-y: auto;
    max-height: 600px;
  }

  .tiptap-content:focus {
    outline: none;
  }

  /* Prose styling for editor content */
  .tiptap-content :global(.ProseMirror) {
    outline: none;
    min-height: 280px;
  }

  .tiptap-content :global(.ProseMirror p) {
    margin-bottom: 1rem;
    line-height: 1.625;
  }

  .tiptap-content :global(.ProseMirror h2) {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 1rem;
    margin-top: 1.5rem;
    line-height: 1.25;
  }

  .tiptap-content :global(.ProseMirror h3) {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
    margin-top: 1rem;
    line-height: 1.375;
  }

  .tiptap-content :global(.ProseMirror ul),
  .tiptap-content :global(.ProseMirror ol) {
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .tiptap-content :global(.ProseMirror ul) {
    list-style-type: disc;
  }

  .tiptap-content :global(.ProseMirror ol) {
    list-style-type: decimal;
  }

  .tiptap-content :global(.ProseMirror li) {
    margin-bottom: 0.25rem;
  }

  .tiptap-content :global(.ProseMirror blockquote) {
    border-left: 3px solid #3B5755;
    padding-left: 1rem;
    margin: 1rem 0;
    color: #6b7280;
    font-style: italic;
  }

  .tiptap-content :global(.ProseMirror img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1rem 0;
  }

  .tiptap-content :global(.ProseMirror strong) {
    font-weight: 700;
  }

  .tiptap-content :global(.ProseMirror em) {
    font-style: italic;
  }

  .tiptap-content :global(.ProseMirror s) {
    text-decoration: line-through;
  }

  .tiptap-content :global(.ProseMirror p.is-editor-empty:first-child::before) {
    content: attr(data-placeholder);
    float: left;
    color: #9ca3af;
    pointer-events: none;
    height: 0;
  }

  .upload-status {
    padding: 0.5rem 1rem;
    background-color: #eff6ff;
    border-top: 1px solid #d1d5db;
    text-align: center;
    font-size: 0.875rem;
    color: #3B5755;
  }

  .loading-text::before {
    content: '';
    display: inline-block;
    width: 0.875rem;
    height: 0.875rem;
    margin-right: 0.5rem;
    border: 2px solid #3B5755;
    border-top-color: transparent;
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
    vertical-align: middle;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }
</style>

<script>
  import { Editor } from '@tiptap/core';
  import StarterKit from '@tiptap/starter-kit';
  import Image from '@tiptap/extension-image';

  // Get elements
  const editorElement = document.getElementById('tiptap-editor');
  const hiddenInput = document.getElementById('full_description') as HTMLInputElement;
  const toolbar = document.getElementById('tiptap-toolbar');
  const imageInput = document.getElementById('tiptap-image-input') as HTMLInputElement;
  const uploadStatus = document.getElementById('tiptap-upload-status');

  if (!editorElement || !hiddenInput || !toolbar) {
    console.error('Required editor elements not found');
  } else {
    // Get initial content and project ID from hidden input
    const initialContent = hiddenInput.value || '';
    const projectId = hiddenInput.closest('form')?.querySelector('input[name="projectId"]')?.getAttribute('value') 
      || window.location.pathname.split('/').pop();

    // Initialize Tiptap editor
    const editor = new Editor({
      element: editorElement,
      extensions: [
        StarterKit,
        Image.configure({
          inline: false,
          allowBase64: false,
          HTMLAttributes: {
            class: 'editor-image',
          },
        }),
      ],
      content: initialContent,
      editorProps: {
        attributes: {
          class: 'ProseMirror',
          'data-placeholder': 'Begin met typen...'
        }
      },
      onUpdate: ({ editor }) => {
        // Update hidden input when content changes
        hiddenInput.value = editor.getHTML();
      },
    });

    // Toolbar button handlers
    toolbar.addEventListener('click', async (e) => {
      const button = (e.target as HTMLElement).closest('button');
      if (!button) return;

      e.preventDefault();
      const action = button.dataset.action;

      switch (action) {
        case 'bold':
          editor.chain().focus().toggleBold().run();
          break;
        case 'italic':
          editor.chain().focus().toggleItalic().run();
          break;
        case 'strike':
          editor.chain().focus().toggleStrike().run();
          break;
        case 'heading':
          const level = parseInt(button.dataset.level || '2') as 2 | 3;
          editor.chain().focus().toggleHeading({ level }).run();
          break;
        case 'paragraph':
          editor.chain().focus().setParagraph().run();
          break;
        case 'bulletList':
          editor.chain().focus().toggleBulletList().run();
          break;
        case 'orderedList':
          editor.chain().focus().toggleOrderedList().run();
          break;
        case 'blockquote':
          editor.chain().focus().toggleBlockquote().run();
          break;
        case 'image':
          imageInput?.click();
          break;
        case 'undo':
          editor.chain().focus().undo().run();
          break;
        case 'redo':
          editor.chain().focus().redo().run();
          break;
      }

      updateToolbarState();
    });

    // Image upload handler
    if (imageInput) {
      imageInput.addEventListener('change', async (e) => {
        const file = (e.target as HTMLInputElement).files?.[0];
        if (!file) return;

        // Validate file type
        const allowedTypes = ['image/jpeg', 'image/png', 'image/gif', 'image/webp'];
        if (!allowedTypes.includes(file.type)) {
          alert('Alleen JPEG, PNG, GIF en WebP afbeeldingen zijn toegestaan');
          return;
        }

        // Validate file size (5MB)
        if (file.size > 5 * 1024 * 1024) {
          alert('Afbeelding is te groot (max 5MB)');
          return;
        }

        // Show loading
        if (uploadStatus) {
          uploadStatus.style.display = 'block';
        }

        try {
          // Upload image
          const formData = new FormData();
          formData.append('image', file);
          formData.append('projectId', projectId || '');

          const response = await fetch('/api/images/upload', {
            method: 'POST',
            body: formData,
          });

          if (!response.ok) {
            const error = await response.json();
            throw new Error(error.error || 'Upload mislukt');
          }

          const data = await response.json();
          
          // Insert image into editor
          editor.chain().focus().setImage({ src: data.url }).run();

        } catch (error) {
          console.error('Image upload error:', error);
          alert(error instanceof Error ? error.message : 'Fout bij uploaden van afbeelding');
        } finally {
          // Hide loading
          if (uploadStatus) {
            uploadStatus.style.display = 'none';
          }
          // Reset input
          imageInput.value = '';
        }
      });
    }

    // Update toolbar button states
    function updateToolbarState() {
      toolbar.querySelectorAll('button').forEach(button => {
        const action = button.dataset.action;
        let isActive = false;

        switch (action) {
          case 'bold':
            isActive = editor.isActive('bold');
            break;
          case 'italic':
            isActive = editor.isActive('italic');
            break;
          case 'strike':
            isActive = editor.isActive('strike');
            break;
          case 'heading':
            const level = parseInt(button.dataset.level || '2');
            isActive = editor.isActive('heading', { level });
            break;
          case 'paragraph':
            isActive = editor.isActive('paragraph');
            break;
          case 'bulletList':
            isActive = editor.isActive('bulletList');
            break;
          case 'orderedList':
            isActive = editor.isActive('orderedList');
            break;
          case 'blockquote':
            isActive = editor.isActive('blockquote');
            break;
        }

        if (isActive) {
          button.classList.add('is-active');
        } else {
          button.classList.remove('is-active');
        }
      });
    }

    // Listen for editor updates to update button states
    editor.on('selectionUpdate', updateToolbarState);
    editor.on('transaction', updateToolbarState);

    // Initial toolbar state
    updateToolbarState();

    // Cleanup on page unload
    window.addEventListener('beforeunload', () => {
      editor.destroy();
    });
  }
</script>

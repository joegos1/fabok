---
/**
 * Image Upload Component (Server-side form)
 * ==========================================
 * Upload formulier voor afbeeldingen
 * Valideert bestandstype (alleen jpg, png, webp, gif toegestaan)
 */

interface Props {
  projectId?: string;  // Als undefined, dan voor landing page
  uploadUrl: string;
  onImageUploaded?: string;  // Optional callback
}

const { projectId, uploadUrl, onImageUploaded } = Astro.props;
---

<div class="bg-firda-gray-50 rounded-lg p-4">
  <h3 class="font-semibold text-firda-gray-800 mb-3 flex items-center">
    <svg class="w-5 h-5 mr-2 text-firda-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
    </svg>
    Afbeelding uploaden
  </h3>

  <form 
    id="image-upload-form" 
    action={uploadUrl} 
    method="POST" 
    enctype="multipart/form-data"
    class="space-y-4"
  >
    {projectId && (
      <input type="hidden" name="projectId" value={projectId} />
    )}
    
    <div 
      id="drop-zone"
      class="border-2 border-dashed border-firda-gray-300 rounded-lg p-6 text-center hover:border-firda-blue-400 transition cursor-pointer"
    >
      <svg class="mx-auto h-12 w-12 text-firda-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
      </svg>
      <p class="mt-2 text-sm text-firda-gray-600">
        <label for="image-file" class="font-medium text-firda-blue-600 hover:text-firda-blue-500 cursor-pointer">
          Klik om te uploaden
        </label>
        <span class="text-firda-gray-500"> of sleep hier een afbeelding</span>
      </p>
      <p class="mt-1 text-xs text-firda-gray-500">
        JPG, PNG, WebP of GIF (max 5MB)
      </p>
      <input 
        id="image-file" 
        name="imageFile" 
        type="file" 
        accept=".jpg,.jpeg,.png,.webp,.gif,image/jpeg,image/png,image/webp,image/gif" 
        class="hidden"
        required
      />
    </div>

    <!-- Geselecteerde afbeelding preview -->
    <div id="selected-image" class="hidden">
      <div class="space-y-3">
        <img id="image-preview" src="" alt="Preview" class="w-full h-48 object-cover rounded-lg border border-firda-gray-200" />
        <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-firda-gray-200">
          <div class="flex-1">
            <p id="image-name" class="text-sm font-medium text-firda-gray-800"></p>
            <p id="image-size" class="text-xs text-firda-gray-500"></p>
          </div>
          <button 
            type="button" 
            id="remove-image" 
            class="text-firda-gray-400 hover:text-red-500 transition"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- Error message -->
    <div id="upload-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
      <p id="error-message"></p>
    </div>

    <!-- Submit button -->
    <button 
      type="submit" 
      id="submit-btn"
      class="w-full bg-firda-green-500 text-white py-2 px-4 rounded-lg font-medium hover:bg-firda-green-600 disabled:bg-firda-gray-300 disabled:cursor-not-allowed transition"
      disabled
    >
      <span id="btn-text">Uploaden</span>
      <span id="btn-loading" class="hidden">
        <svg class="animate-spin h-5 w-5 mx-auto" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
      </span>
    </button>
  </form>
</div>

<script>
  const form = document.getElementById('image-upload-form') as HTMLFormElement;
  const fileInput = document.getElementById('image-file') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone') as HTMLDivElement;
  const selectedImage = document.getElementById('selected-image') as HTMLDivElement;
  const imagePreview = document.getElementById('image-preview') as HTMLImageElement;
  const imageName = document.getElementById('image-name') as HTMLParagraphElement;
  const imageSize = document.getElementById('image-size') as HTMLParagraphElement;
  const removeImage = document.getElementById('remove-image') as HTMLButtonElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text') as HTMLSpanElement;
  const btnLoading = document.getElementById('btn-loading') as HTMLSpanElement;
  const errorDiv = document.getElementById('upload-error') as HTMLDivElement;
  const errorMessage = document.getElementById('error-message') as HTMLParagraphElement;

  // Helper: format file size
  function formatFileSize(bytes: number): string {
    if (bytes < 1024) return `${bytes} bytes`;
    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
    return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
  }

  // Helper: validate image
  function isValidImage(file: File): boolean {
    const validTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
    const validExtensions = ['.jpg', '.jpeg', '.png', '.webp', '.gif'];
    const hasValidType = validTypes.includes(file.type);
    const hasValidExtension = validExtensions.some(ext => file.name.toLowerCase().endsWith(ext));
    return hasValidType && hasValidExtension;
  }

  // Helper: show error
  function showError(message: string) {
    errorMessage.textContent = message;
    errorDiv.classList.remove('hidden');
  }

  // Helper: hide error
  function hideError() {
    errorDiv.classList.add('hidden');
  }

  // Helper: update image display
  function updateImageDisplay(file: File | null) {
    if (file && isValidImage(file)) {
      const reader = new FileReader();
      reader.onload = (e) => {
        imagePreview.src = e.target?.result as string;
        imageName.textContent = file.name;
        imageSize.textContent = formatFileSize(file.size);
        selectedImage.classList.remove('hidden');
        dropZone.classList.add('hidden');
        submitBtn.disabled = false;
        hideError();
      };
      reader.readAsDataURL(file);
    } else if (file) {
      showError('Alleen JPG, PNG, WebP of GIF afbeeldingen zijn toegestaan.');
      resetFileInput();
    } else {
      selectedImage.classList.add('hidden');
      dropZone.classList.remove('hidden');
      submitBtn.disabled = true;
    }
  }

  // Helper: reset file input
  function resetFileInput() {
    fileInput.value = '';
    updateImageDisplay(null);
  }

  // Event: file input change
  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0] || null;
    updateImageDisplay(file);
  });

  // Event: click on drop zone
  dropZone.addEventListener('click', () => {
    fileInput.click();
  });

  // Event: drag and drop
  dropZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-firda-blue-400', 'bg-firda-blue-50');
  });

  dropZone.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-firda-blue-400', 'bg-firda-blue-50');
  });

  dropZone.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-firda-blue-400', 'bg-firda-blue-50');
    
    const files = e.dataTransfer?.files;
    if (files && files.length > 0) {
      const dataTransfer = new DataTransfer();
      dataTransfer.items.add(files[0]);
      fileInput.files = dataTransfer.files;
      updateImageDisplay(files[0]);
    }
  });

  // Event: remove image
  removeImage.addEventListener('click', () => {
    resetFileInput();
  });

  // Event: form submit
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const file = fileInput.files?.[0];
    if (!file || !isValidImage(file)) {
      showError('Selecteer een geldige afbeelding.');
      return;
    }

    // Show loading state
    submitBtn.disabled = true;
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');
    hideError();

    try {
      const formData = new FormData(form);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
      });

      if (response.ok) {
        const data = await response.json();
        // Emit custom event with image URL for parent form
        const event = new CustomEvent('imageUploaded', { detail: { url: data.url, filename: data.filename } });
        document.dispatchEvent(event);
        resetFileInput();
        showError('✓ Afbeelding succesvol geüpload!');
        errorDiv.classList.remove('bg-red-50', 'border-red-200', 'text-red-700');
        errorDiv.classList.add('bg-green-50', 'border-green-200', 'text-green-700');
      } else {
        const data = await response.json();
        showError(data.error || 'Er is een fout opgetreden bij het uploaden.');
      }
    } catch (error) {
      showError('Er is een onverwachte fout opgetreden.');
    } finally {
      submitBtn.disabled = false;
      btnText.classList.remove('hidden');
      btnLoading.classList.add('hidden');
    }
  });
</script>

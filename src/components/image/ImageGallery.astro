---
/**
 * Image Gallery Component
 * =======================
 * Toont geüploade afbeeldingen met klikbare thumbnails
 * Kopieert markdown image syntax naar clipboard voor gebruik in textarea
 */

interface Props {
  images: any[];
  projectId: string;
}

const { images, projectId } = Astro.props;
---

{images && images.length > 0 && (
  <div class="bg-white rounded-lg border border-firda-gray-200 p-4">
    <div class="flex items-center justify-between mb-3">
      <h3 class="font-semibold text-firda-gray-800 flex items-center">
        <svg class="w-5 h-5 mr-2 text-firda-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
        </svg>
        Geüploade Afbeeldingen
      </h3>
      <span class="text-xs text-firda-gray-500">{images.length} {images.length === 1 ? 'afbeelding' : 'afbeeldingen'}</span>
    </div>

    <div class="mb-3 p-3 bg-firda-blue-50 rounded-lg border border-firda-blue-200">
      <p class="text-xs text-firda-blue-800 font-medium mb-1">💡 Tip: Afbeeldingen in tekst plaatsen</p>
      <p class="text-xs text-firda-blue-700">
        Klik op een afbeelding om de URL te kopiëren. Plak deze in de uitgebreide beschrijving als:
      </p>
      <code class="block mt-2 text-xs bg-white px-2 py-1 rounded border border-firda-blue-200 text-firda-gray-700">
        ![beschrijving](URL)
      </code>
    </div>

    <div class="grid grid-cols-2 gap-3 max-h-96 overflow-y-auto">
      {images.map((image) => (
        <div class="group relative border border-firda-gray-200 rounded-lg overflow-hidden hover:border-firda-blue-400 transition">
          <button
            type="button"
            class="image-copy-btn w-full text-left"
            data-url={image.url}
            data-filename={image.filename}
          >
            <img 
              src={image.url} 
              alt={image.filename}
              class="w-full h-32 object-cover"
            />
            <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-40 transition flex items-center justify-center">
              <div class="opacity-0 group-hover:opacity-100 transition">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
                </svg>
              </div>
            </div>
          </button>
          <div class="p-2 bg-firda-gray-50">
            <p class="text-xs text-firda-gray-600 truncate" title={image.filename}>
              {image.filename}
            </p>
            <div class="flex items-center justify-between mt-1">
              <span class="text-xs text-firda-gray-500">
                {(image.file_size / 1024).toFixed(0)} KB
              </span>
              <form action="/api/images/delete" method="POST" class="inline">
                <input type="hidden" name="imageId" value={image.id} />
                <input type="hidden" name="redirectTo" value={`/dashboard/beheer-projecten/${projectId}`} />
                <button
                  type="submit"
                  class="p-1 text-firda-gray-400 hover:text-red-500 transition"
                  onclick="return confirm('Weet je zeker dat je deze afbeelding wilt verwijderen?')"
                  title="Verwijderen"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                  </svg>
                </button>
              </form>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
)}

<!-- Toast notification voor gekopieerde URL -->
<div 
  id="copy-toast" 
  class="fixed bottom-4 right-4 bg-firda-green-500 text-white px-4 py-3 rounded-lg shadow-lg hidden items-center gap-2 z-50"
>
  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
  </svg>
  <span>URL gekopieerd naar klembord!</span>
</div>

<script>
  // Copy image URL to clipboard when clicking on image
  document.querySelectorAll('.image-copy-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const button = e.currentTarget as HTMLButtonElement;
      const url = button.dataset.url;
      const filename = button.dataset.filename || 'afbeelding';
      
      // Create markdown syntax
      const markdown = `![${filename}](${url})`;
      
      try {
        await navigator.clipboard.writeText(markdown);
        
        // Show toast
        const toast = document.getElementById('copy-toast');
        if (toast) {
          toast.classList.remove('hidden');
          toast.classList.add('flex');
          
          setTimeout(() => {
            toast.classList.add('hidden');
            toast.classList.remove('flex');
          }, 3000);
        }
      } catch (err) {
        console.error('Failed to copy:', err);
        alert('URL kopiëren mislukt. Probeer het opnieuw.');
      }
    });
  });
</script>

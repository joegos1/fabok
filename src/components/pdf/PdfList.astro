---
/**
 * PDF List Component
 * ==================
 * Toont lijst van PDF's met download links
 * Nieuwste PDF's bovenaan, scrollbaar bij veel items
 */

import type { PdfFile } from '../../types/database';

interface Props {
  pdfs: PdfFile[];
  maxHeight?: string;
  title?: string;
}

const { pdfs, maxHeight = '400px', title = 'Documenten' } = Astro.props;

// Sorteer op uploaded_at, nieuwste eerst
const sortedPdfs = [...pdfs].sort((a, b) => 
  new Date(b.uploaded_at).getTime() - new Date(a.uploaded_at).getTime()
);

function formatDate(dateString: string): string {
  return new Date(dateString).toLocaleDateString('nl-NL', {
    day: 'numeric',
    month: 'short',
    year: 'numeric'
  });
}

function formatFileSize(bytes: number | null): string {
  if (!bytes) return '';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
---

<div class="bg-firda-gray-50 rounded-lg p-4">
  <h3 class="font-semibold text-firda-gray-800 mb-3 flex items-center">
    <svg class="w-5 h-5 mr-2 text-firda-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
    </svg>
    {title}
  </h3>

  {sortedPdfs.length === 0 ? (
    <p class="text-sm text-firda-gray-500 italic">
      Geen documenten beschikbaar
    </p>
  ) : (
    <div 
      class="overflow-y-auto space-y-2"
      style={`max-height: ${maxHeight};`}
    >
      {sortedPdfs.map(pdf => (
        <a 
          href={pdf.url} 
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center p-3 bg-white rounded-lg border border-firda-gray-200 hover:border-firda-blue-300 hover:shadow-sm transition group"
          download
        >
          <svg class="w-8 h-8 text-red-500 mr-3 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M10.92,12.31C10.68,11.54 10.15,9.08 11.55,9.04C12.95,9 12.03,12.16 12.03,12.16C12.42,13.65 14.05,14.72 14.05,14.72C14.55,14.57 17.4,14.24 17,15.72C16.57,17.2 13.5,15.81 13.5,15.81C11.55,15.95 10.09,16.47 10.09,16.47C8.96,18.58 7.64,19.5 7.1,18.61C6.43,17.5 9.23,16.07 9.23,16.07C10.68,13.72 10.9,12.35 10.92,12.31Z" />
          </svg>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-firda-gray-800 truncate group-hover:text-firda-blue-600 transition">
              {pdf.filename}
            </p>
            <p class="text-xs text-firda-gray-500">
              {formatDate(pdf.uploaded_at)}
              {pdf.file_size && (
                <span class="ml-2">{formatFileSize(pdf.file_size)}</span>
              )}
            </p>
          </div>
          <svg class="w-5 h-5 text-firda-gray-400 group-hover:text-firda-blue-500 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
        </a>
      ))}
    </div>
  )}
</div>

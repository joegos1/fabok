---
/**
 * Projecten Overzichtspagina
 * ==========================
 * Lijst met alle actieve VABOK projecten
 */

import Layout from "../../../layouts/Layout.astro";
import ProjectCard from "../../../components/project/ProjectCard.astro";
import { supabaseAdmin } from "../../../lib";
import type { Project } from "../../../types/database";

// Haal alle actieve EN gepubliceerde projecten op
const { data, error } = await supabaseAdmin
  .from("projects")
  .select("*")
  .eq("status", "active")
  .eq("is_published", true)
  .order("created_at", { ascending: false });

const projects = (data || []) as Project[];
---

<Layout title="Projecten">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Header -->
    <div class="mb-8">
      <h1 class="text-3xl lg:text-4xl font-bold text-firda-gray-900 mb-4">
        VABOK Projecten
      </h1>
      <p class="text-lg text-firda-gray-600 max-w-3xl">
        Ontdek alle VABOK-projecten van ons. Klik op een project voor meer
        details.
      </p>
    </div>

    <!-- Zoekbalk & Provincie Filter -->
    <div class="mb-8 space-y-8">
      <div class="max-w-md">
        <label for="search" class="sr-only">Zoek projecten</label>
        <div class="relative">
          <div
            class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none"
          >
            <svg
              class="h-5 w-5 text-firda-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <input
            type="text"
            id="search"
            placeholder="Zoek op titel of beschrijving..."
            class="block w-full pl-10 pr-3 py-2 border border-firda-gray-300 rounded-lg leading-5 bg-white placeholder-firda-gray-500 focus:outline-none focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 sm:text-sm transition-all shadow-sm"
          />
        </div>
      </div>

      <div>
        <h2
          class="text-sm font-semibold text-firda-gray-700 mb-4 flex items-center"
        >
          <svg
            class="w-4 h-4 mr-2 text-firda-blue-500"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          Filter op provincie:
        </h2>
        <div class="flex flex-wrap gap-2 md:gap-3">
          <button
            data-filter="all"
            class="filter-btn active px-4 py-2 text-sm font-medium rounded-xl bg-firda-blue-600 text-white shadow-sm transition-all hover:bg-firda-blue-700"
          >
            Alle provincies
          </button>
          {
            [
              "Friesland",
              "Groningen",
              "Drenthe",
              "Overijssel",
              "Flevoland",
              "Gelderland",
              "Utrecht",
              "Noord-Holland",
              "Zuid-Holland",
              "Zeeland",
              "Noord-Brabant",
              "Limburg",
            ].map((provincie) => (
              <button
                data-filter={provincie}
                class="filter-btn px-4 py-2 text-sm font-medium rounded-xl bg-white border border-firda-gray-200 text-firda-gray-700 hover:border-firda-blue-300 hover:text-firda-blue-600 hover:bg-firda-blue-50 transition-all shadow-sm"
              >
                {provincie}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Projecten grid -->
    {
      !projects || projects.length === 0 ? (
        <div class="text-center py-16 bg-white rounded-xl shadow-sm">
          <svg
            class="mx-auto h-16 w-16 text-firda-gray-400 mb-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            />
          </svg>
          <h3 class="text-lg font-semibold text-firda-gray-900 mb-2">
            Nog geen projecten
          </h3>
          <p class="text-firda-gray-600">
            Er zijn momenteel geen actieve projecten om weer te geven.
          </p>
        </div>
      ) : (
        <div
          id="projects-grid"
          class="grid md:grid-cols-2 lg:grid-cols-3 gap-6"
        >
          {projects.map((project) => (
            <div
              class="project-item"
              data-province={project.province || ""}
              data-title={project.title.toLowerCase()}
              data-description={(project.short_description || "").toLowerCase()}
              data-tags={(project.tags || []).join(" ").toLowerCase()}
            >
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      )
    }

    <!-- Geen resultaten na filtering -->
    <div
      id="no-results"
      class="hidden text-center py-16 bg-white rounded-xl shadow-sm"
    >
      <svg
        class="mx-auto h-16 w-16 text-firda-gray-400 mb-4"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <h3 class="text-lg font-semibold text-firda-gray-900 mb-2">
        Geen projecten gevonden
      </h3>
      <p class="text-firda-gray-600">
        Er zijn geen projecten met de geselecteerde provincie.
      </p>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById("search") as HTMLInputElement;
  const filterBtns = document.querySelectorAll(".filter-btn");
  const projectItems = document.querySelectorAll(".project-item");
  const projectsGrid = document.getElementById("projects-grid");
  const noResults = document.getElementById("no-results");

  let activeFilter = "all";
  let searchQuery = "";

  function applyFilters() {
    let visibleCount = 0;
    const query = searchQuery.toLowerCase().trim();

    projectItems.forEach((item) => {
      const province = item.getAttribute("data-province") || "";
      const title = item.getAttribute("data-title") || "";
      const description = item.getAttribute("data-description") || "";
      const tags = item.getAttribute("data-tags") || "";

      const matchesProvince =
        activeFilter === "all" || province === activeFilter;
      const matchesSearch =
        !query ||
        title.includes(query) ||
        description.includes(query) ||
        tags.includes(query);

      if (matchesProvince && matchesSearch) {
        item.classList.remove("hidden");
        visibleCount++;
      } else {
        item.classList.add("hidden");
      }
    });

    // Show/hide no results message
    if (visibleCount === 0) {
      projectsGrid?.classList.add("hidden");
      noResults?.classList.remove("hidden");
    } else {
      projectsGrid?.classList.remove("hidden");
      noResults?.classList.add("hidden");
    }
  }

  // Province filtering
  filterBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeFilter = btn.getAttribute("data-filter") || "all";

      // Update active state
      filterBtns.forEach((b) => {
        b.classList.remove("active", "bg-firda-blue-600", "text-white");
        b.classList.add(
          "bg-white",
          "text-firda-gray-700",
          "border-firda-gray-200",
        );
      });

      if (activeFilter === "all") {
        btn.classList.add("active", "bg-firda-blue-600", "text-white");
        btn.classList.remove(
          "bg-white",
          "text-firda-gray-700",
          "border-firda-gray-200",
        );
      } else {
        btn.classList.add("active", "bg-firda-blue-600", "text-white");
        btn.classList.remove(
          "bg-white",
          "text-firda-gray-700",
          "border-firda-gray-200",
        );
      }

      applyFilters();
    });
  });

  // Search filtering
  searchInput?.addEventListener("input", (e) => {
    searchQuery = (e.target as HTMLInputElement).value;
    applyFilters();
  });
</script>
```

                </div>
              </div>
            )
          }

          {
            owner && (
              <div class="flex items-start">
                <svg
                  class="w-5 h-5 mr-3 text-firda-gray-400 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  />
                </svg>
                <div>
                  <p class="text-sm text-firda-gray-500">Projecteigenaar</p>
                  <p class="font-medium text-firda-gray-800">
                    {owner.full_name || owner.email}

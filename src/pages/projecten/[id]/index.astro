                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                    </svg>
                  </a>
                )}

                {/* Instagram */}
                {(project as any).instagram_url && (
                  <a
                    href={(project as any).instagram_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-10 h-10 rounded-full bg-firda-gray-100 text-firda-gray-600 hover:bg-gradient-to-tr hover:from-[#F58529]/10 hover:via-[#DD2A7B]/10 hover:to-[#515BD4]/10 hover:text-[#DD2A7B] transition"
                    title="Instagram"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                    </svg>
                  </a>
                )}

                {/* X/Twitter */}
                {(project as any).x_url && (
                  <a
                    href={(project as any).x_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-10 h-10 rounded-full bg-firda-gray-100 text-firda-gray-600 hover:bg-black/10 hover:text-black transition"
                    title="X (Twitter)"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                    </svg>
                  </a>
                )}

                {/* YouTube */}
                {(project as any).youtube_url && (
                  <a
                    href={(project as any).youtube_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-10 h-10 rounded-full bg-firda-gray-100 text-firda-gray-600 hover:bg-[#FF0000]/10 hover:text-[#FF0000] transition"
                    title="YouTube"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          )
        }

        <!-- Agenda -->
        {
          projectEvents.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              <AgendaSection
                events={projectEvents}
                title="Project Agenda"
                emptyMessage="Geen evenementen gepland."
              />
            </div>
          )
        }

        <!-- PDF documenten -->
        {
          isLoggedIn && (
            <div class="sticky top-8">
              <PdfList
                pdfs={pdfs || []}
                title="Projectdocumenten"
                maxHeight="400px"
              />
            </div>
          )
        }
        {
          !isLoggedIn && (
            <div class="p-6 bg-firda-blue-50 rounded-xl border border-firda-blue-100 text-center">
              <p class="text-sm font-medium text-firda-blue-800">
                Projectdocumenten zijn alleen zichtbaar voor ingelogde
                gebruikers.
              </p>
              <a
                href="/login"
                class="inline-block mt-3 text-sm font-bold text-firda-blue-600 hover:text-firda-blue-700 underline underline-offset-4"
              >
                Log in om PDF's te bekijken
              </a>
            </div>
          )
        }
      </aside>
    </div>

    <!-- Terug link -->
    <div class="mt-8">
      <a
        href="/projecten/lijst"
        class="inline-flex items-center text-firda-blue-600 font-medium hover:text-firda-blue-700 transition"
      >
        <svg
          class="w-5 h-5 mr-2"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        Terug naar overzicht
      </a>
    </div>
  </div>
</Layout>

<script>
  // UX-first image fitting:
  // - Default: cover (fills 16:9 nicely)
  // - If image is portrait/square-ish: switch to contain to avoid huge cropping
  (function () {
    const images = document.querySelectorAll(
      'img[data-smart-fit="section-image"]',
    );
    if (!images || images.length === 0) return;

    const applySmartFit = (img: HTMLImageElement) => {
      try {
        const w = img.naturalWidth;
        const h = img.naturalHeight;
        if (!w || !h) return;

        const ratio = w / h;
        // If ratio is <= ~1.15 (square/portrait leaning), cropping in 16:9 becomes very aggressive.
        if (ratio <= 1.15) {
          img.classList.remove("object-cover");
          img.classList.add("object-contain");
          img.style.objectPosition = "center";
          // Keep the soft background visible for letterboxing
          const parent = img.parentElement;
          if (parent) parent.classList.add("bg-firda-gray-50");
        }
      } catch (_) {
        // ignore
      }
    };

    images.forEach((el) => {
      const img = el as HTMLImageElement;
      if (img.complete) applySmartFit(img);
      else
        img.addEventListener("load", () => applySmartFit(img), { once: true });
    });
  })();
</script>

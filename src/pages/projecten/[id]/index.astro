              <div class="flex flex-wrap gap-3">
                {/* Website */}
                {(project as any).website_url && (
                  <a
                    href={(project as any).website_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center w-10 h-10 rounded-full bg-firda-gray-100 text-firda-gray-600 hover:bg-firda-blue-100 hover:text-firda-blue-600 transition"
                    title="Website"
                  >
                    <svg
                      class="w-5 h-5"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"

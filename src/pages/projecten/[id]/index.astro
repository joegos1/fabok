              <p class="text-firda-gray-700">{project.target_audience}</p>
            </div>
          )
        }
      </div>

      <!-- Sidebar -->
      <aside class="lg:col-span-1 space-y-6">
        <!-- Contactinformatie -->
        <div class="bg-white rounded-xl shadow-sm p-6">
          <h3 class="text-lg font-bold text-firda-gray-900 mb-4">Contact</h3>

          {
            project.contact_person && (
              <div class="flex items-start mb-4">
                <svg
                  class="w-5 h-5 mr-3 text-firda-gray-400 flex-shrink-0 mt-0.5"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"

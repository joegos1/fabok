---
/**
 * Project Detail Pagina
 * =====================
 * Toont alle informatie van één VABOK project
 */

import Layout from "../../../layouts/Layout.astro";
import PdfList from "../../../components/pdf/PdfList.astro";
import ImageMagnifier from "../../../components/common/ImageMagnifier.astro";
import AgendaSection from "../../../components/agenda/AgendaSection.astro";
import {
  supabaseAdmin,
  getCurrentUser,
  getUserProfile,
  isAdmin,
  isProjectEditor,
} from "../../../lib";
import type {
  Project,
  PdfFile,
  ProjectEvent,
  EventRegistration,
} from "../../../types/database";

// Haal project ID uit URL
const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/projecten/lijst");
}

// Auth check voor PDF's en registraties
const cookies = Astro.request.headers.get("cookie") || "";
const accessToken = cookies.match(/sb-access-token=([^;]+)/)?.[1];
const user = await getCurrentUser(accessToken);
const profile = user ? await getUserProfile(user.id) : null;
const isLoggedIn = !!user;

// Mag de gebruiker registraties zien? (Admin of Projectleider)
const canViewRegistrations =
  profile && (isAdmin(profile.role) || isProjectEditor(profile.role));

// Haal project op
const { data: projectData, error: projectError } = await supabaseAdmin
  .from("projects")
  .select("*")
  .eq("id", id)
  .eq("status", "active")
  .single();

if (projectError || !projectData) {
  return Astro.redirect("/projecten/lijst");
}

const project = projectData as Project;

// Haal PDF's op voor dit project (alleen als ingelogd)
let pdfs: PdfFile[] = [];
if (isLoggedIn) {
  const { data: pdfsData } = await supabaseAdmin
    .from("pdf_files")
    .select("*")
    .eq("project_id", id)
    .order("uploaded_at", { ascending: false });
  pdfs = (pdfsData || []) as PdfFile[];
}

// Haal eigenaar info op
const { data: ownerData } = await supabaseAdmin
  .from("profiles")
  .select("full_name, email")
  .eq("id", project.owner_id)
  .single();

const owner = ownerData as { full_name: string | null; email: string } | null;

// Haal agenda op voor dit project
const { data: projectEventsData } = await supabaseAdmin
  .from("project_events")
  .select("*")
  .eq("project_id", id)
  .order("start_date", { ascending: true });

// Haal alle registraties op voor deze events
const eventIds = ((projectEventsData || []) as ProjectEvent[]).map((e) => e.id);
const { data: allRegistrationsData } = await supabaseAdmin
  .from("event_registrations")
  .select("*")
  .in("event_id", eventIds);

const allRegistrations = (allRegistrationsData || []) as EventRegistration[];

const projectEvents = ((projectEventsData || []) as ProjectEvent[]).map(
  (event) => ({
    ...event,
    registrationCount: allRegistrations.filter((r) => r.event_id === event.id)
      .length,
    registrations: canViewRegistrations
      ? allRegistrations.filter((r) => r.event_id === event.id)
      : [],
    canViewRegistrations,
  }),
) as any[];
---

<Layout title={project.title}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- Breadcrumb -->
    <nav class="mb-8">
      <ol class="flex items-center space-x-2 text-sm text-firda-gray-500">
        <li>
          <a href="/" class="hover:text-firda-blue-600 transition">Home</a>
        </li>
        <li>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </li>
        <li>
          <a
            href="/projecten/lijst"
            class="hover:text-firda-blue-600 transition">Projecten</a
          >
        </li>
        <li>
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path
              fill-rule="evenodd"
              d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
              clip-rule="evenodd"></path>
          </svg>
        </li>
        <li class="text-firda-gray-900 font-medium truncate max-w-[200px]">
          {project.title}
        </li>
      </ol>
    </nav>

    <div class="grid lg:grid-cols-3 gap-8">
      <!-- Hoofdcontent -->
      <div class="lg:col-span-2 space-y-8">
        <!-- Header -->
        <div class="bg-white rounded-xl shadow-sm p-8">
          <h1 class="text-3xl font-bold text-firda-gray-900 mb-4">
            {project.title}
          </h1>

          {
            project.tags && project.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-6">
                {project.tags.map((tag: string) => (
                  <span class="px-3 py-1 text-sm font-medium rounded-full bg-firda-blue-50 text-firda-blue-600">
                    {tag}
                  </span>
                ))}
              </div>
            )
          }

          {
            project.short_description && (
              <p class="text-lg text-firda-gray-600 leading-relaxed">
                {project.short_description}
              </p>
            )
          }
        </div>

        <!-- Uitgebreide beschrijving -->
        {
          project.full_description && (
            <div class="bg-white rounded-xl shadow-sm p-8">
              <h2 class="text-xl font-bold text-firda-gray-900 mb-4">
                Over dit project
              </h2>
              <div class="prose prose-lg max-w-none text-firda-gray-700">
                {project.full_description
                  .split("\n")
                  .map(
                    (paragraph: string) =>
                      paragraph.trim() && <p class="mb-4">{paragraph}</p>,
                  )}
              </div>
            </div>
          )
        }

        <!-- Doelen -->
        {
          project.goals && (
            <div class="bg-white rounded-xl shadow-sm p-8">
              <h2 class="text-xl font-bold text-firda-gray-900 mb-4 flex items-center">
                <svg
                  class="w-6 h-6 mr-2 text-firda-green-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                Doelen
              </h2>
              <div class="prose prose-lg max-w-none text-firda-gray-700">
                {project.goals.split("\n").map(
                  (goal: string) =>
                    goal.trim() && (
                      <div class="flex items-start mb-3">
                        <svg
                          class="w-5 h-5 mr-3 text-firda-green-500 flex-shrink-0 mt-1"
                          fill="none"
                          stroke="currentColor"
                          viewBox="0 0 24 24"
                        >
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"
                          />
                        </svg>
                        <span>{goal.trim()}</span>
                      </div>
                    ),
                )}
              </div>
            </div>
          )
        }

        <!-- Sectie afbeelding (tussen doelen en doelgroep) -->
        {
          project.section_image_url && (
            <div class="bg-white rounded-xl shadow-sm p-6">
              <div
                class="aspect-video w-full overflow-hidden rounded-lg border border-firda-gray-100 bg-firda-gray-50"
                style="max-height: 520px;"
              >
                <ImageMagnifier
                  src={project.section_image_url}
                  alt={`Afbeelding bij ${project.title}`}
                  imgClass="h-full w-full object-cover"
                  smartFit={true}
                />
              </div>
            </div>
          )
        }

        <!-- Doelgroep -->
        {
          project.target_audience && (
            <div class="bg-white rounded-xl shadow-sm p-8">
              <h2 class="text-xl font-bold text-firda-gray-900 mb-4 flex items-center">
                <svg
                  class="w-6 h-6 mr-2 text-firda-blue-500"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
                  />
                </svg>
                Doelgroep

---
/**
 * Global Agenda Page
 * ==================
 * Toont alle aankomende evenementen van alle projecten.
 */

import Layout from "../../layouts/Layout.astro";
import AgendaSection from "../../components/agenda/AgendaSection.astro";
import { supabaseAdmin } from "../../lib";

// Haal alle aankomende evenementen op
const { data: eventsData } = await supabaseAdmin
    .from("project_events")
    .select("*, projects(title)")
    .gte("start_date", new Date().toISOString())
    .order("start_date", { ascending: true });

const events = (eventsData || []) as any[];
---

<Layout title="VABOK Agenda">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <!-- Header -->
        <div class="mb-12">
            <nav class="mb-4">
                <ol
                    class="flex items-center space-x-2 text-sm text-firda-gray-500"
                >
                    <li>
                        <a href="/" class="hover:text-firda-blue-600 transition"
                            >Home</a>
                    </li>
                    <li>
                        <svg
                            class="w-4 h-4"
                            fill="currentColor"
                            viewBox="0 0 20 20"
                        >
                            <path
                                fill-rule="evenodd"
                                d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"
                                clip-rule="evenodd"></path>
                        </svg>
                    </li>
                    <li class="text-firda-gray-900 font-medium">Agenda</li>
                </ol>
            </nav>

            <h1 class="text-3xl lg:text-4xl font-bold text-firda-gray-900 mb-4">
                VABOK <span class="text-firda-blue-600">Agenda</span>
            </h1>
            <p class="text-lg text-firda-gray-600">
                Een overzicht van alle belangrijke data, bijeenkomsten en
                deadlines voor de verschillende VABOK projecten.
            </p>
        </div>

        <!-- Agenda inhoud -->
        <div
            class="bg-white rounded-2xl shadow-sm border border-firda-gray-100 p-8"
        >
            <AgendaSection
                events={events}
                showProject={true}
                title="Aankomende evenementen"
                emptyMessage="Er zijn momenteel geen evenementen gepland."
            />
        </div>

        <!-- Terug naar projecten -->
        <div class="mt-12 text-center">
            <p class="text-firda-gray-500 mb-6 font-medium">
                Benieuwd naar de projecten zelf?
            </p>
            <a
                href="/projecten/lijst"
                class="inline-flex items-center px-8 py-3 bg-firda-blue-600 text-white font-bold rounded-xl hover:bg-firda-blue-700 transition shadow-lg shadow-firda-blue-600/20"
            >
                Bekijk alle projecten
                <svg
                    class="ml-2 w-5 h-5 focus:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
            </a>
        </div>
    </div>
</Layout>

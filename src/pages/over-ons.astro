---
/**
 * Over Ons Pagina
 * ===============
 * Pagina over de makers van VABOK
 */

import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Over Ons"
    description="Leer meer over de makers van VABOK - Jorg & Jens"
>
    <!-- Video Hero Sectie -->
    <section
        class="relative h-[70vh] min-h-[500px] max-h-[700px] overflow-hidden"
    >
        <video
            id="hero-video"
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 w-full h-full object-cover"
        >
            <source src="/IMG_1513 (1).mp4" type="video/mp4" />
        </video>

        <!-- Overlay -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-firda-blue-900/80 via-firda-blue-900/40 to-transparent"
        >
        </div>

        <!-- Video Controls -->
        <div class="absolute bottom-4 right-4 flex items-center gap-2 z-10">
            <button
                id="play-pause-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Afspelen/Pauzeren"
            >
                <svg
                    id="pause-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 9v6m4-6v6"></path>
                </svg>
                <svg
                    id="play-icon"
                    class="w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                    ></path>
                </svg>
            </button>
            <button
                id="mute-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Geluid aan/uit"
            >
                <svg
                    id="muted-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
                </svg>
                <svg
                    id="unmuted-icon"
                    class="w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    ></path>
                </svg>
            </button>
            <button
                id="fullscreen-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Volledig scherm"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
                    ></path>
                </svg>
            </button>
        </div>

        <!-- Hero Content (Editorial Style) -->
        <div class="relative h-full flex items-end">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 w-full">
                <div class="relative z-10">
                    <span
                        class="inline-block px-2 py-0.5 bg-firda-green-500 text-firda-blue-900 text-[10px] font-bold uppercase tracking-[0.3em] mb-6"
                    >
                        De makers
                    </span>
                    <h1
                        class="text-6xl sm:text-8xl lg:text-9xl font-black text-white mb-2 leading-[0.8] tracking-tighter"
                    >
                        OVER<br /><span class="text-firda-green-500">ONS</span>
                    </h1>
                    <div class="w-24 h-2 bg-white mt-8 mb-4"></div>
                    <p
                        class="text-xl lg:text-2xl text-firda-blue-100 font-medium tracking-tight"
                    >
                        De studenten achter <span class="font-black italic"
                            >VABOK</span
                        >.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Introductie (Modern Editorial Layout) -->
    <section class="py-32 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col lg:flex-row gap-16 items-start">
                <!-- Linkerkant: Grote Quote/Headline -->
                <div class="w-full lg:w-1/2">
                    <h2
                        class="text-4xl lg:text-6xl font-black text-firda-gray-900 leading-tight tracking-tighter mb-8"
                    >
                        Leren door te <span class="text-firda-blue-600 italic"
                            >bouwen.</span
                        >
                    </h2>
                    <div
                        class="inline-block px-4 py-2 bg-firda-gray-100 border-l-4 border-firda-blue-600"
                    >
                        <p
                            class="text-firda-gray-900 font-bold uppercase tracking-widest text-xs"
                        >
                            IT Innovation Gateway
                        </p>
                    </div>
                </div>

                <!-- Rechterkant: Verhalende Tekst -->
                <div class="w-full lg:w-1/2 lg:pt-4">
                    <div
                        class="prose prose-xl max-w-none text-firda-gray-600 leading-relaxed font-medium"
                    >
                        <p class="mb-8 text-firda-gray-900 font-bold">
                            Wij zijn Jorg en Jens, twee scholieren die deze
                            website hebben ontwikkeld tijdens ons project bij de
                            IT Innovation Gateway. Met passie voor technologie
                            en een frisse blik hebben we VABOK tot leven
                            gebracht.
                        </p>
                        <p class="text-lg">
                            De IT Innovation Gateway biedt studenten de kans om
                            echte projecten te realiseren en zo praktijkervaring
                            op te doen. Dit platform is het resultaat van onze
                            samenwerking en laat zien wat mogelijk is wanneer
                            onderwijs en innovatie samenkomen.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Sectie: Modern Editorial (Concept 2) -->
    <section class="py-32 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Grote Achtergrond Tekst (Editorial Style) -->
            <div class="relative mb-24 lg:mb-32">
                <h2
                    class="text-[15vw] lg:text-[12vw] font-black text-firda-gray-200 absolute -top-8 -left-4 select-none leading-none z-0 opacity-50 lg:opacity-100"
                >
                    THE MAKERS
                </h2>
                <div class="relative z-10 pt-16 lg:pt-20 lg:pl-12">
                    <span
                        class="inline-block px-2 py-0.5 bg-firda-blue-600 text-white text-[10px] font-bold uppercase tracking-[0.3em] mb-4"
                    >
                        Het Team
                    </span>
                    <h3
                        class="text-4xl lg:text-7xl font-black text-firda-gray-900 leading-[0.9] tracking-tighter"
                    >
                        TWEE STUDENTEN,<br />
                        <span class="text-firda-blue-600">ÉÉN MISSIE.</span>
                    </h3>
                </div>
            </div>

            <!-- Asymmetrische Team Layout -->
            <div class="relative space-y-32 lg:space-y-48">
                <!-- Jorg Sectie (Asymmetrisch Links) -->
                <div
                    class="relative flex flex-col lg:flex-row items-center lg:items-start gap-12 lg:gap-0 group"
                >
                    <div class="w-full lg:w-1/2 relative">
                        <!-- Decoratieve Background Number -->
                        <span
                            class="absolute -top-20 -left-10 text-[200px] font-black text-firda-gray-100 select-none z-0 pointer-events-none"
                            >01</span
                        >

                        <!-- Portret/Avatar Frame -->
                        <div
                            class="relative w-64 h-80 lg:w-80 lg:h-[450px] bg-white shadow-2xl mx-auto lg:mx-0 overflow-hidden transition-all duration-500 group-hover:-translate-y-4 group-hover:rotate-2 z-10"
                        >
                            <img
                                src="/IMG_0599.jpeg"
                                alt="Jorg"
                                class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                            />
                            <!-- Tape effect - Verbeterd -->
                            <div
                                class="absolute -top-2 left-1/2 -translate-x-1/2 w-28 h-10 bg-white/40 backdrop-blur-md -rotate-3 z-30 shadow-sm border-x border-white/20"
                                style="clip-path: polygon(0% 0%, 5% 20%, 0% 40%, 5% 60%, 0% 80%, 5% 100%, 95% 100%, 100% 80%, 95% 60%, 100% 40%, 95% 20%, 100% 0%);"
                            >
                            </div>
                        </div>
                        <!-- Naam die over de foto loopt -->
                        <div
                            class="absolute -bottom-6 -right-2 lg:-bottom-8 lg:-right-12 z-20 transition-transform duration-500 group-hover:translate-x-4"
                        >
                            <h4
                                class="text-5xl lg:text-9xl font-black text-firda-gray-900 leading-none drop-shadow-sm"
                            >
                                JORG
                            </h4>
                            <div
                                class="inline-block px-3 py-1 bg-firda-blue-600 text-white text-[10px] lg:text-xs font-black uppercase tracking-widest mt-2 ml-2 lg:ml-4 shadow-lg"
                            >
                                LEAD DEVELOPER
                            </div>
                        </div>
                    </div>

                    <div
                        class="w-full lg:w-1/2 pt-12 lg:pt-32 lg:pl-12 relative"
                    >
                        <div class="max-w-md mx-auto lg:mx-0 relative z-10">
                            <p
                                class="text-xl lg:text-3xl font-bold text-firda-gray-800 leading-tight mb-8 text-center lg:text-left relative"
                            >
                                <span
                                    class="absolute -top-8 -left-8 text-6xl text-firda-blue-600/10 italic font-serif"
                                    >"</span
                                >
                                Code is voor mij de manier om ideeën tastbaar te maken
                                voor iedereen.
                            </p>
                            <div
                                class="w-12 h-1.5 bg-firda-blue-600 mb-8 mx-auto lg:mx-0"
                            >
                            </div>
                            <p
                                class="text-firda-gray-600 leading-relaxed text-base lg:text-lg italic text-center lg:text-left border-l-2 border-firda-gray-100 pl-6"
                            >
                                Als lead developer focus ik me op de technische
                                architectuur en de gebruiksvriendelijkheid van
                                het platform. Het bouwen van VABOK was een
                                perfecte oefening in het vertalen van complexe
                                wensen naar een simpele interface.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Jens Sectie (Asymmetrisch Rechts - Gespiegeld & Verschoven) -->
                <div
                    class="relative flex flex-col-reverse lg:flex-row items-center lg:items-start gap-12 lg:gap-0 group"
                >
                    <div
                        class="w-full lg:w-1/2 pt-12 lg:pt-32 lg:pr-12 lg:text-right flex flex-col items-center lg:items-end relative"
                    >
                        <div
                            class="max-w-md mx-auto lg:mr-0 lg:ml-auto relative z-10"
                        >
                            <p
                                class="text-xl lg:text-3xl font-bold text-firda-gray-800 leading-tight mb-8 text-center lg:text-right relative"
                            >
                                <span
                                    class="absolute -top-8 -right-8 text-6xl text-firda-green-600/10 italic font-serif"
                                    >"</span
                                >
                                Het gaat niet alleen om de techniek, maar om de impact
                                die we maken.
                            </p>
                            <div
                                class="w-12 h-1.5 bg-firda-green-500 mx-auto lg:ml-auto lg:mr-0 mb-8"
                            >
                            </div>
                            <p
                                class="text-firda-gray-600 leading-relaxed text-base lg:text-lg italic text-center lg:text-right border-r-2 border-firda-gray-100 pr-6"
                            >
                                Mijn passie ligt bij het verbinden van mensen en
                                projecten. Bij VABOK zorg ik dat de structuur
                                klopt en dat de groei van het project
                                gewaarborgd blijft voor de toekomst.
                            </p>
                        </div>
                    </div>

                    <div
                        class="w-full lg:w-1/2 relative lg:flex lg:justify-end"
                    >
                        <!-- Decoratieve Background Number -->
                        <span
                            class="absolute -top-20 -right-10 text-[200px] font-black text-firda-gray-100 select-none z-0 pointer-events-none"
                            >02</span
                        >

                        <div
                            class="relative w-64 h-80 lg:w-80 lg:h-[450px] bg-white shadow-2xl mx-auto lg:mx-0 overflow-hidden transition-all duration-500 group-hover:-translate-y-4 group-hover:-rotate-2 z-10"
                        >
                            <div
                                class="absolute inset-0 bg-firda-green-500 flex items-center justify-center transition-transform duration-700 group-hover:scale-110"
                            >
                                <span
                                    class="text-[150px] font-black text-firda-green-600/30"
                                    >J</span
                                >
                            </div>
                            <!-- Tape effect - Verbeterd -->
                            <div
                                class="absolute -top-2 left-1/2 -translate-x-1/2 w-28 h-10 bg-white/40 backdrop-blur-md rotate-3 z-30 shadow-sm border-x border-white/20"
                                style="clip-path: polygon(0% 0%, 5% 20%, 0% 40%, 5% 60%, 0% 80%, 5% 100%, 95% 100%, 100% 80%, 95% 60%, 100% 40%, 95% 20%, 100% 0%);"
                            >
                            </div>
                        </div>
                        <!-- Naam die over de foto loopt -->
                        <div
                            class="absolute -bottom-6 -left-2 lg:-bottom-8 lg:-left-12 z-20 transition-transform duration-500 group-hover:-translate-x-4"
                        >
                            <h4
                                class="text-5xl lg:text-9xl font-black text-firda-gray-900 leading-none drop-shadow-sm"
                            >
                                JENS
                            </h4>
                            <div
                                class="inline-block px-3 py-1 bg-firda-green-500 text-firda-blue-900 text-[10px] lg:text-xs font-black uppercase tracking-widest mt-2 ml-2 lg:ml-4 shadow-lg"
                            >
                                TECHNICAL ARCHITECT
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA terug naar projecten -->
    <section class="py-24 bg-firda-blue-600 relative overflow-hidden">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-xl lg:text-2xl font-bold mb-4 text-white">
                Benieuwd naar ons werk?
            </h2>
            <a
                href="/projecten/lijst"
                class="inline-flex items-center px-6 py-3 bg-firda-green-500 text-firda-blue-900 font-bold rounded-lg hover:bg-firda-green-400 transition-all shadow-lg hover:scale-105"
            >
                Bekijk de projecten
                <svg
                    class="ml-2 w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>
        </div>
    </section>
</Layout>

<script>
    const video = document.getElementById("hero-video") as HTMLVideoElement;
    const playPauseBtn = document.getElementById("play-pause-btn");
    const muteBtn = document.getElementById("mute-btn");
    const fullscreenBtn = document.getElementById("fullscreen-btn");

    const playIcon = document.getElementById("play-icon");
    const pauseIcon = document.getElementById("pause-icon");
    const mutedIcon = document.getElementById("muted-icon");
    const unmutedIcon = document.getElementById("unmuted-icon");

    // Play/Pause logic
    playPauseBtn?.addEventListener("click", () => {
        if (video.paused) {
            video.play();
            playIcon?.classList.add("hidden");
            pauseIcon?.classList.remove("hidden");
        } else {
            video.pause();
            playIcon?.classList.remove("hidden");
            pauseIcon?.classList.add("hidden");
        }
    });

    // Mute/Unmute logic
    muteBtn?.addEventListener("click", () => {
        video.muted = !video.muted;
        if (video.muted) {
            mutedIcon?.classList.remove("hidden");
            unmutedIcon?.classList.add("hidden");
        } else {
            mutedIcon?.classList.add("hidden");
            unmutedIcon?.classList.remove("hidden");
        }
    });

    // Initial state check for mute icon (since it starts muted via HTML attribute)
    if (video.muted) {
        mutedIcon?.classList.remove("hidden");
        unmutedIcon?.classList.add("hidden");
    } else {
        mutedIcon?.classList.add("hidden");
        unmutedIcon?.classList.remove("hidden");
    }

    // Fullscreen logic
    fullscreenBtn?.addEventListener("click", () => {
        if (video.requestFullscreen) {
            video.requestFullscreen();
        } else if ((video as any).webkitRequestFullscreen) {
            /* Safari */
            (video as any).webkitRequestFullscreen();
        } else if ((video as any).msRequestFullscreen) {
            /* IE11 */
            (video as any).msRequestFullscreen();
        }
    });
</script>

---
/**
 * Over Ons Pagina
 * ===============
 * Pagina over de makers van VABOK
 */

import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Over Ons"
    description="Leer meer over de makers van VABOK - Jorg & Jens"
>
    <!-- Video Hero Sectie -->
    <section
        class="relative h-[70vh] min-h-[500px] max-h-[700px] overflow-hidden"
    >
        <video
            id="hero-video"
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 w-full h-full object-cover"
        >
            <source src="/IMG_1513 (1).mp4" type="video/mp4" />
        </video>

        <!-- Overlay -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-firda-blue-900/80 via-firda-blue-900/40 to-transparent"
        >
        </div>

        <!-- Video Controls -->
        <div class="absolute bottom-4 right-4 flex items-center gap-2 z-10">
            <button
                id="play-pause-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Afspelen/Pauzeren"
            >
                <svg
                    id="pause-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 9v6m4-6v6"></path>
                </svg>
                <svg
                    id="play-icon"
                    class="w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                    ></path>
                </svg>
            </button>
            <button
                id="mute-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Geluid aan/uit"
            >
                <svg
                    id="muted-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
                </svg>
                <svg
                    id="unmuted-icon"
                    class="w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    ></path>
                </svg>
            </button>
            <button
                id="fullscreen-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Volledig scherm"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
                    ></path>
                </svg>
            </button>
        </div>

        <!-- Hero Content -->
        <div class="relative h-full flex items-end">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 w-full">
                <span
                    class="inline-block px-3 py-1 bg-firda-green-500/20 text-firda-green-400 text-xs font-bold tracking-wider uppercase rounded-full mb-4 backdrop-blur-sm border border-firda-green-500/30"
                >
                    De makers
                </span>
                <h1
                    class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white mb-4 leading-tight"
                >
                    Over Ons
                </h1>
                <p class="text-xl text-firda-blue-100 max-w-2xl">
                    De studenten achter VABOK
                </p>
            </div>
        </div>
    </section>

    <!-- Introductie -->
    <section class="py-16 bg-white">
        <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-10">
                <h2
                    class="text-2xl lg:text-3xl font-bold text-firda-gray-900 mb-4"
                >
                    Gemaakt bij de <span class="text-firda-blue-600"
                        >IT Innovation Gateway</span
                    >
                </h2>
                <div class="w-16 h-1 bg-firda-green-500 rounded-full mx-auto">
                </div>
            </div>

            <div
                class="prose prose-lg max-w-none text-firda-gray-600 leading-relaxed text-center"
            >
                <p class="mb-6">
                    Wij zijn Jorg en Jens, twee scholieren die deze website
                    hebben ontwikkeld tijdens ons project bij de IT Innovation
                    Gateway. Met passie voor technologie en een frisse blik
                    hebben we VABOK tot leven gebracht.
                </p>
                <p>
                    De IT Innovation Gateway biedt studenten de kans om echte
                    projecten te realiseren en zo praktijkervaring op te doen.
                    Dit platform is het resultaat van onze samenwerking en laat
                    zien wat mogelijk is wanneer onderwijs en innovatie
                    samenkomen.
                </p>
            </div>
        </div>
    </section>

    <!-- Team Sectie -->
    <section class="py-16 bg-firda-gray-50 border-y border-firda-gray-200">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-12">
                <h2
                    class="text-2xl lg:text-3xl font-bold text-firda-gray-900 mb-3"
                >
                    Het team
                </h2>
                <p class="text-firda-gray-600">De mensen achter dit project</p>
            </div>

            <div class="grid md:grid-cols-2 gap-8">
                <!-- Jorg -->
                <div
                    class="bg-white rounded-xl p-8 shadow-sm border border-firda-gray-200 hover:shadow-md transition-shadow"
                >
                    <div
                        class="w-20 h-20 bg-firda-blue-600 rounded-full flex items-center justify-center mb-6 mx-auto"
                    >
                        <span class="text-3xl font-bold text-white">J</span>
                    </div>
                    <h3
                        class="text-xl font-bold text-firda-gray-900 text-center mb-2"
                    >
                        Jorg
                    </h3>
                    <p
                        class="text-firda-blue-600 font-medium text-center text-sm mb-4"
                    >
                        Developer
                    </p>
                    <p
                        class="text-firda-gray-600 text-center text-sm leading-relaxed"
                    >
                        [Hier komt jouw beschrijving. Vertel iets over jezelf,
                        je rol in het project, wat je leuk vindt aan
                        programmeren, of wat je hebt geleerd.]
                    </p>
                </div>

                <!-- Jens -->
                <div
                    class="bg-white rounded-xl p-8 shadow-sm border border-firda-gray-200 hover:shadow-md transition-shadow"
                >
                    <div
                        class="w-20 h-20 bg-firda-green-500 rounded-full flex items-center justify-center mb-6 mx-auto"
                    >
                        <span class="text-3xl font-bold text-firda-blue-900"
                            >J</span
                        >
                    </div>
                    <h3
                        class="text-xl font-bold text-firda-gray-900 text-center mb-2"
                    >
                        Jens
                    </h3>
                    <p
                        class="text-firda-blue-600 font-medium text-center text-sm mb-4"
                    >
                        Developer
                    </p>
                    <p
                        class="text-firda-gray-600 text-center text-sm leading-relaxed"
                    >
                        [Hier komt jouw beschrijving. Vertel iets over jezelf,
                        je rol in het project, wat je leuk vindt aan
                        programmeren, of wat je hebt geleerd.]
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA terug naar projecten -->
    <section class="py-12 bg-firda-blue-600">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-xl lg:text-2xl font-bold mb-4 text-white">
                Benieuwd naar ons werk?
            </h2>
            <a
                href="/projecten/lijst"
                class="inline-flex items-center px-6 py-3 bg-firda-green-500 text-firda-blue-900 font-bold rounded-lg hover:bg-firda-green-400 transition-all shadow-lg hover:scale-105"
            >
                Bekijk de projecten
                <svg
                    class="ml-2 w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
                </svg>
            </a>
        </div>
    </section>
</Layout>

<script>
    const video = document.getElementById("hero-video") as HTMLVideoElement;
    const playPauseBtn = document.getElementById("play-pause-btn");
    const muteBtn = document.getElementById("mute-btn");
    const fullscreenBtn = document.getElementById("fullscreen-btn");

    const playIcon = document.getElementById("play-icon");
    const pauseIcon = document.getElementById("pause-icon");
    const mutedIcon = document.getElementById("muted-icon");
    const unmutedIcon = document.getElementById("unmuted-icon");

    // Play/Pause logic
    playPauseBtn?.addEventListener("click", () => {
        if (video.paused) {
            video.play();
            playIcon?.classList.add("hidden");
            pauseIcon?.classList.remove("hidden");
        } else {
            video.pause();
            playIcon?.classList.remove("hidden");
            pauseIcon?.classList.add("hidden");
        }
    });

    // Mute/Unmute logic
    muteBtn?.addEventListener("click", () => {
        video.muted = !video.muted;
        if (video.muted) {
            mutedIcon?.classList.remove("hidden");
            unmutedIcon?.classList.add("hidden");
        } else {
            mutedIcon?.classList.add("hidden");
            unmutedIcon?.classList.remove("hidden");
        }
    });

    // Initial state check for mute icon (since it starts muted via HTML attribute)
    if (video.muted) {
        mutedIcon?.classList.remove("hidden");
        unmutedIcon?.classList.add("hidden");
    } else {
        mutedIcon?.classList.add("hidden");
        unmutedIcon?.classList.remove("hidden");
    }

    // Fullscreen logic
    fullscreenBtn?.addEventListener("click", () => {
        if (video.requestFullscreen) {
            video.requestFullscreen();
        } else if ((video as any).webkitRequestFullscreen) {
            /* Safari */
            (video as any).webkitRequestFullscreen();
        } else if ((video as any).msRequestFullscreen) {
            /* IE11 */
            (video as any).msRequestFullscreen();
        }
    });
</script>

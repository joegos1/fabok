---
/**
 * Over Ons Pagina
 * ===============
 * Pagina over de makers van VABOK
 */

import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import jorgImage from "../assets/IMG_0599.jpeg";
import jensImage from "../assets/jensnieuwenhuis.jpg";
---

<Layout
    title="Over Ons"
    description="Leer meer over de makers van VABOK - Jorg & Jens"
>
    <!-- Video Hero Sectie -->
    <section
        class="relative h-[70vh] min-h-[500px] max-h-[700px] overflow-hidden"
    >
        <video
            id="hero-video"
            autoplay
            muted
            loop
            playsinline
            class="absolute inset-0 w-full h-full object-cover"
        >
            <source src="/IMG_1513 (1).mp4" type="video/mp4" />
        </video>

        <!-- Overlay -->
        <div
            class="absolute inset-0 bg-gradient-to-t from-firda-blue-900/80 via-firda-blue-900/40 to-transparent"
        >
        </div>

        <!-- Video Controls -->
        <div class="absolute bottom-4 right-4 flex items-center gap-2 z-10">
            <button
                id="play-pause-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Afspelen/Pauzeren"
            >
                <svg
                    id="pause-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 9v6m4-6v6"></path>
                </svg>
                <svg
                    id="play-icon"
                    class="w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"
                    ></path>
                </svg>
            </button>
            <button
                id="mute-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Geluid aan/uit"
            >
                <svg
                    id="muted-icon"
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path>
                </svg>
                <svg
                    id="unmuted-icon"
                    class="w-5 h-5 hidden"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"
                    ></path>
                </svg>
            </button>
            <button
                id="fullscreen-btn"
                class="p-3 bg-white/20 backdrop-blur-sm rounded-full hover:bg-white/30 transition-colors text-white"
                title="Volledig scherm"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"
                    ></path>
                </svg>
            </button>
        </div>

        <!-- Hero Content (Editorial Style) -->
        <div class="relative h-full flex items-end">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20 w-full">
                <div class="relative z-10">
                    <span
                        class="inline-block px-2 py-0.5 bg-firda-green-500 text-firda-blue-900 text-[10px] font-bold uppercase tracking-[0.3em] mb-6"
                    >
                        De makers
                    </span>
                    <h1
                        class="text-6xl sm:text-8xl lg:text-9xl font-black text-white mb-2 leading-[0.8] tracking-tighter"
                    >
                        OVER<br /><span class="text-firda-green-500">ONS</span>
                    </h1>
                    <div class="w-24 h-2 bg-white mt-8 mb-4"></div>
                    <p
                        class="text-xl lg:text-2xl text-firda-blue-100 font-medium tracking-tight"
                    >
                        De studenten achter <span class="font-black italic"
                            >VABOK</span
                        >.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Introductie (Modern Editorial Layout) -->
    <section class="py-32 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col lg:flex-row gap-16 items-start">
                <!-- Linkerkant: Grote Quote/Headline -->
                <div class="w-full lg:w-1/2">
                    <h2
                        class="text-4xl lg:text-6xl font-black text-firda-gray-900 leading-tight tracking-tighter mb-8"
                    >
                        Leren door te <span class="text-firda-blue-600 italic"
                            >bouwen.</span
                        >
                    </h2>
                    <div
                        class="inline-block px-4 py-2 bg-firda-gray-100 border-l-4 border-firda-blue-600"
                    >
                        <p
                            class="text-firda-gray-900 font-bold uppercase tracking-widest text-xs"
                        >
                            IT Innovation Gateway
                        </p>
                    </div>
                </div>

                <!-- Rechterkant: Verhalende Tekst -->
                <div class="w-full lg:w-1/2 lg:pt-4">
                    <div
                        class="prose prose-xl max-w-none text-firda-gray-600 leading-relaxed font-medium"
                    >
                        <p class="mb-8 text-firda-gray-900 font-bold">
                            Wij zijn Jorg en Jens, twee scholieren die deze
                            website hebben ontwikkeld tijdens ons project bij de
                            IT Innovation Gateway. Met passie voor technologie
                            en een frisse blik hebben we VABOK tot leven
                            gebracht.
                        </p>
                        <p class="text-lg">
                            De IT Innovation Gateway biedt studenten de kans om
                            echte projecten te realiseren en zo praktijkervaring
                            op te doen. Dit platform is het resultaat van onze
                            samenwerking en laat zien wat mogelijk is wanneer
                            onderwijs en innovatie samenkomen.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Team Sectie: Modern Editorial (Concept 2) -->
    <section class="py-32 bg-white overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Grote Achtergrond Tekst (Editorial Style) -->
            <div class="relative mb-24 lg:mb-40">
                <h2
                    class="text-[18vw] lg:text-[15vw] font-black text-firda-gray-100 absolute -top-16 -left-8 select-none leading-none z-0 opacity-40 lg:opacity-60 tracking-tighter"
                >
                    THE MAKERS
                </h2>
                <div class="relative z-10 pt-20 lg:pt-32 lg:pl-20">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-firda-blue-600"></div>
                        <span
                            class="text-firda-blue-600 text-[10px] font-black uppercase tracking-[0.4em]"
                        >
                            Het Team
                        </span>
                    </div>
                    <h3
                        class="text-5xl lg:text-8xl font-black text-firda-blue-900 leading-[0.85] tracking-tighter"
                    >
                        TWEE STUDENTEN,<br />
                        <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-firda-blue-600 to-firda-blue-800"
                            >ÉÉN MISSIE.</span
                        >
                    </h3>
                </div>
            </div>

            <!-- Asymmetrische Team Layout -->
            <div class="relative space-y-32 lg:space-y-48">
                <!-- Jorg Sectie (Asymmetrisch Links) -->
                <div
                    class="relative flex flex-col lg:flex-row items-center lg:items-start gap-12 lg:gap-0 group"
                >
                    <div class="w-full lg:w-1/2 relative">
                        <!-- Decoratieve Background Number -->
                        <span
                            class="absolute -top-32 -left-16 text-[250px] font-black text-firda-gray-100 select-none z-0 pointer-events-none opacity-40 leading-none"
                            >01</span
                        >

                        <!-- Portret/Avatar Frame -->
                        <div
                            class="relative w-72 h-96 lg:w-[400px] lg:h-[550px] shadow-[0_35px_60px_-15px_rgba(0,0,0,0.3)] mx-auto lg:mx-0 overflow-hidden transition-all duration-700 group-hover:-translate-y-4 group-hover:rotate-1 z-10 border-8 border-white"
                        >
                            <Image
                                src={jorgImage}
                                alt="Jorg"
                                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                            />
                            <!-- Overlay voor diepte -->
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-firda-blue-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"
                            >
                            </div>

                            <!-- Tape effect - Meer realistisch -->
                            <div
                                class="absolute -top-3 left-1/2 -translate-x-1/2 w-40 h-14 bg-white/40 backdrop-blur-md -rotate-3 z-30 shadow-[0_2px_10px_rgba(0,0,0,0.1)] border-x border-white/30"
                                style="clip-path: polygon(0% 10%, 4% 0%, 10% 8%, 15% 2%, 20% 10%, 25% 1%, 32% 9%, 40% 0%, 48% 10%, 55% 2%, 60% 9%, 68% 1%, 75% 10%, 82% 0%, 90% 8%, 95% 2%, 100% 10%, 100% 90%, 95% 100%, 90% 92%, 82% 100%, 75% 90%, 68% 100%, 60% 91%, 55% 98%, 48% 90%, 40% 100%, 32% 91%, 25% 100%, 20% 90%, 15% 98%, 10% 92%, 4% 100%, 0% 90%);"
                            >
                            </div>
                        </div>

                        <!-- Naam die over de foto loopt -->
                        <div
                            class="absolute -bottom-16 -right-4 lg:-bottom-20 lg:-right-12 z-20 transition-all duration-700 group-hover:translate-x-8"
                        >
                            <h4
                                class="text-7xl lg:text-[12rem] font-black text-white leading-none drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] select-none"
                            >
                                JORG
                            </h4>
                            <div
                                class="inline-flex items-center gap-3 px-6 py-2.5 bg-firda-blue-600 text-white text-xs lg:text-sm font-black uppercase tracking-[0.3em] mt-2 ml-10 shadow-2xl skew-x-[-10deg]"
                            >
                                <span
                                    class="w-2 h-2 bg-firda-green-500 rounded-full animate-pulse"
                                ></span>
                                Full Stack Developer
                            </div>
                        </div>
                    </div>

                    <div
                        class="w-full lg:w-1/2 pt-32 lg:pt-56 lg:pl-24 relative"
                    >
                        <div class="max-w-md mx-auto lg:mx-0 relative z-10">
                            <div class="inline-block mb-6 opacity-20">
                                <svg
                                    class="w-12 h-12 text-firda-blue-600"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V10C14.017 10.5523 13.5693 11 13.017 11H12.017C11.4647 11 11.017 10.5523 11.017 10V9C11.017 6.79086 12.8079 5 15.017 5H19.017C21.2261 5 23.017 6.79086 23.017 9V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM3 21L3 18C3 16.8954 3.89543 16 5 16H8C8.55228 16 9 15.5523 9 15V9C9 8.44772 8.55228 8 8 8H4C3.44772 8 3 8.44772 3 9V10C3 10.5523 2.55228 11 2 11H1C0.447715 11 0 10.5523 0 10V9C0 6.79086 1.79086 5 4 5H8C10.2091 5 12 6.79086 12 9V15C12 18.3137 9.31371 21 6 21H3Z"
                                    ></path>
                                </svg>
                            </div>
                            <p
                                class="text-2xl lg:text-4xl font-black text-firda-gray-900 leading-[1.1] mb-10 text-center lg:text-left tracking-tighter"
                            >
                                Coderen is voor mij een passie waar ik mijn <span
                                    class="text-firda-blue-600 italic"
                                    >creativiteit</span
                                > kan instoppen.
                            </p>
                            <div
                                class="w-20 h-1.5 bg-firda-blue-600 mb-10 mx-auto lg:mx-0 rounded-full"
                            >
                            </div>
                            <p
                                class="text-firda-gray-600 leading-relaxed text-lg lg:text-xl font-medium text-center lg:text-left border-l-4 border-firda-gray-100 pl-10"
                            >
                                Als Full stack developer focus ik me op het
                                technische en visuele aspect van het platform.
                                Het bouwen van VABOK was een perfecte oefening
                                in het vertalen van wensen naar een prachtige
                                website.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Jens Sectie (Asymmetrisch Rechts - Gespiegeld & Verschoven) -->
                <div
                    class="relative flex flex-col-reverse lg:flex-row items-center lg:items-start gap-12 lg:gap-0 group"
                >
                    <div
                        class="w-full lg:w-1/2 pt-32 lg:pt-56 lg:pr-24 lg:text-right flex flex-col items-center lg:items-end relative"
                    >
                        <div
                            class="max-w-md mx-auto lg:mr-0 lg:ml-auto relative z-10"
                        >
                            <div
                                class="inline-block mb-6 opacity-20 lg:ml-auto"
                            >
                                <svg
                                    class="w-12 h-12 text-firda-green-500 scale-x-[-1]"
                                    fill="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        d="M14.017 21L14.017 18C14.017 16.8954 14.9124 16 16.017 16H19.017C19.5693 16 20.017 15.5523 20.017 15V9C20.017 8.44772 19.5693 8 19.017 8H15.017C14.4647 8 14.017 8.44772 14.017 9V10C14.017 10.5523 13.5693 11 13.017 11H12.017C11.4647 11 11.017 10.5523 11.017 10V9C11.017 6.79086 12.8079 5 15.017 5H19.017C21.2261 5 23.017 6.79086 23.017 9V15C23.017 18.3137 20.3307 21 17.017 21H14.017ZM3 21L3 18C3 16.8954 3.89543 16 5 16H8C8.55228 16 9 15.5523 9 15V9C9 8.44772 8.55228 8 8 8H4C3.44772 8 3 8.44772 3 9V10C3 10.5523 2.55228 11 2 11H1C0.447715 11 0 10.5523 0 10V9C0 6.79086 1.79086 5 4 5H8C10.2091 5 12 6.79086 12 9V15C12 18.3137 9.31371 21 6 21H3Z"
                                    ></path>
                                </svg>
                            </div>
                            <p
                                class="text-2xl lg:text-4xl font-black text-firda-gray-900 leading-[1.1] mb-10 text-center lg:text-right tracking-tighter"
                            >
                                Het gaat niet alleen om de techniek, maar om de <span
                                    class="text-firda-green-600 italic"
                                    >impact</span
                                > die we maken.
                            </p>
                            <div
                                class="w-20 h-1.5 bg-firda-green-500 mx-auto lg:ml-auto lg:mr-0 mb-10 rounded-full"
                            >
                            </div>
                            <p
                                class="text-firda-gray-600 leading-relaxed text-lg lg:text-xl font-medium text-center lg:text-right border-r-4 border-firda-gray-100 pr-10"
                            >
                                Mijn passie ligt bij het verbinden van mensen en
                                projecten. Bij VABOK zorg ik dat de structuur
                                klopt en dat de groei van het project
                                gewaarborgd blijft voor de toekomst.
                            </p>
                        </div>
                    </div>

                    <div
                        class="w-full lg:w-1/2 relative lg:flex lg:justify-end"
                    >
                        <!-- Decoratieve Background Number -->
                        <span
                            class="absolute -top-32 -right-16 text-[250px] font-black text-firda-gray-100 select-none z-0 pointer-events-none opacity-40 leading-none"
                            >02</span
                        >

                        <div
                            class="relative w-72 h-96 lg:w-[400px] lg:h-[550px] shadow-[0_35px_60px_-15px_rgba(0,0,0,0.3)] mx-auto lg:mx-0 overflow-hidden transition-all duration-700 group-hover:-translate-y-4 group-hover:-rotate-1 z-10 border-8 border-white"
                        >
                            <Image
                                src={jensImage}
                                alt="Jens"
                                class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110"
                            />
                            <!-- Overlay voor diepte -->
                            <div
                                class="absolute inset-0 bg-gradient-to-t from-firda-blue-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"
                            >
                            </div>

                            <!-- Tape effect - Meer realistisch -->
                            <div
                                class="absolute -top-3 left-1/2 -translate-x-1/2 w-40 h-14 bg-white/40 backdrop-blur-md rotate-3 z-30 shadow-[0_2px_10px_rgba(0,0,0,0.1)] border-x border-white/30"
                                style="clip-path: polygon(0% 10%, 4% 0%, 10% 8%, 15% 2%, 20% 10%, 25% 1%, 32% 9%, 40% 0%, 48% 10%, 55% 2%, 60% 9%, 68% 1%, 75% 10%, 82% 0%, 90% 8%, 95% 2%, 100% 10%, 100% 90%, 95% 100%, 90% 92%, 82% 100%, 75% 90%, 68% 100%, 60% 91%, 55% 98%, 48% 90%, 40% 100%, 32% 91%, 25% 100%, 20% 90%, 15% 98%, 10% 92%, 4% 100%, 0% 90%);"
                            >
                            </div>
                        </div>

                        <!-- Naam die over de foto loopt -->
                        <div
                            class="absolute -bottom-16 -left-4 lg:-bottom-20 lg:-left-12 z-20 transition-all duration-700 group-hover:-translate-x-8"
                        >
                            <h4
                                class="text-7xl lg:text-[12rem] font-black text-white leading-none drop-shadow-[0_20px_50px_rgba(0,0,0,0.5)] select-none"
                            >
                                JENS
                            </h4>
                            <div
                                class="inline-flex items-center gap-3 px-6 py-2.5 bg-firda-green-500 text-firda-blue-900 text-xs lg:text-sm font-black uppercase tracking-[0.3em] mt-2 ml-10 shadow-2xl skew-x-[10deg]"
                            >
                                <span
                                    class="w-2 h-2 bg-firda-blue-600 rounded-full animate-pulse"
                                ></span>
                                TECHNICAL ARCHITECT
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</Layout>

<script>
    const video = document.getElementById("hero-video") as HTMLVideoElement;
    const playPauseBtn = document.getElementById("play-pause-btn");
    const muteBtn = document.getElementById("mute-btn");
    const fullscreenBtn = document.getElementById("fullscreen-btn");

    const playIcon = document.getElementById("play-icon");
    const pauseIcon = document.getElementById("pause-icon");
    const mutedIcon = document.getElementById("muted-icon");
    const unmutedIcon = document.getElementById("unmuted-icon");

    // Play/Pause logic
    playPauseBtn?.addEventListener("click", () => {
        if (video.paused) {
            video.play();
            playIcon?.classList.add("hidden");
            pauseIcon?.classList.remove("hidden");
        } else {
            video.pause();
            playIcon?.classList.remove("hidden");
            pauseIcon?.classList.add("hidden");
        }
    });

    // Mute/Unmute logic
    muteBtn?.addEventListener("click", () => {
        video.muted = !video.muted;
        if (video.muted) {
            mutedIcon?.classList.remove("hidden");
            unmutedIcon?.classList.add("hidden");
        } else {
            mutedIcon?.classList.add("hidden");
            unmutedIcon?.classList.remove("hidden");
        }
    });

    // Initial state check for mute icon (since it starts muted via HTML attribute)
    if (video.muted) {
        mutedIcon?.classList.remove("hidden");
        unmutedIcon?.classList.add("hidden");
    } else {
        mutedIcon?.classList.add("hidden");
        unmutedIcon?.classList.remove("hidden");
    }

    // Fullscreen logic
    fullscreenBtn?.addEventListener("click", () => {
        if (video.requestFullscreen) {
            video.requestFullscreen();
        } else if ((video as any).webkitRequestFullscreen) {
            /* Safari */
            (video as any).webkitRequestFullscreen();
        } else if ((video as any).msRequestFullscreen) {
            /* IE11 */
            (video as any).msRequestFullscreen();
        }
    });
</script>

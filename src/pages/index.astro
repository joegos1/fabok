---
/**
 * Home / Landingspagina
 * =====================
 * Dit is de main landingspagina van FABOK dus waar je komt als je de link opent
 */

import Layout from "../layouts/Layout.astro";
import PdfList from "../components/pdf/PdfList.astro";
import ProjectCard from "../components/project/ProjectCard.astro";
import { Image } from "astro:assets";
import CollageVabok from "../assets/collage-vabok.png";
import type { School } from "../types/database";
import { supabaseAdmin, getCurrentUser, getUserProfile } from "../lib";
import SchoolMap from "../components/SchoolMap.astro";

// Auth check voor registraties
const cookies = Astro.request.headers.get("cookie") || "";
const accessToken = cookies.match(/sb-access-token=([^;]+)/)?.[1];
const user = await getCurrentUser(accessToken);
const profile = user ? await getUserProfile(user.id) : null;
const isLoggedIn = !!user;
const canViewRegistrations = false; // Registraties nu alleen in dashboard te zien

// Haal landingpage content op
const { data: landingContent } = await supabaseAdmin
  .from("landing_page_content")
  .select("*")
  .single();

// Haal landing page PDF's op
const { data: pdfs } = await supabaseAdmin
  .from("pdf_files")
  .select("*")
  .eq("is_landing_page", true)
  .order("uploaded_at", { ascending: false });

// Haal de laatste 4 actieve en gepubliceerde projecten op
const { data: latestProjects } = await supabaseAdmin
  .from("projects")
  .select("*")
  .eq("status", "active")
  .eq("is_published", true)
  .order("created_at", { ascending: false })
  .limit(4);

// Haal scholen op voor marquee
const { data: schoolsData } = await supabaseAdmin
  .from("schools")
  .select("*")
  .order("display_order", { ascending: true });

const schools = (schoolsData || []) as School[];

// Haal aankomende en recente evenementen op (enkel voor check of er events zijn voor de CTA indien gewenst, maar we houden het simpel)
// const { data: eventsData } = ...
// Registratie-gerelateerde code verwijderd, dit staat nu op /agenda

const content = landingContent || {
  title: "VABOK - Versterken van de Aansluiting in de Beroepskolom",
  intro:
    "Welkom bij VABOK, het platform voor informatie over onderwijsprojecten.",
  body: "Hier vindt u informatie over lopende projecten, hun doelen en resultaten.",
};
---

<Layout title="Home">
  <!-- Hero sectie: Compacter en overzichtelijker -->
  <section
    class="relative bg-firda-blue-500 text-white py-16 lg:py-20 overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent">
    </div>

    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="animate-fade-in-up">
        <h1
          class="text-4xl sm:text-5xl lg:text-7xl font-extrabold mb-8 leading-tight"
        >
          {content.title}
        </h1>
        <p
          class="text-xl lg:text-2xl text-firda-blue-100 mb-12 max-w-3xl mx-auto leading-relaxed"
        >
          {content.intro}
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          <a
            href="/projecten/lijst"
            class="inline-flex items-center px-10 py-5 bg-firda-green-500 text-firda-blue-900 font-black rounded-2xl hover:bg-firda-green-400 transition-all duration-300 shadow-xl hover:scale-105 active:scale-95 text-xl"
          >
            Bekijk projecten
            <svg
              class="ml-2 w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a
            href="/agenda"
            class="inline-flex items-center px-10 py-5 bg-white/10 text-white font-bold rounded-2xl hover:bg-white/20 transition-all duration-300 border border-white/20 text-xl group"
          >
            Bekijk agenda
            <svg
              class="ml-2 w-6 h-6 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2.5"
                d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Scholen Marquee -->
  {
    schools && schools.length > 0 && (
      <section class="py-6 bg-firda-blue-600 border-y border-white/10">
        <div class="marquee-container overflow-hidden">
          <div class="marquee-content flex items-center gap-10 text-firda-green-400 font-bold uppercase tracking-widest text-xs">
            {[...schools, ...schools, ...schools].map((school) => (
              <span class="whitespace-nowrap flex items-center gap-4">
                {school.name}
                <span class="w-1 h-1 rounded-full bg-firda-green-500/50" />
              </span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- VABOK Banner Transitie -->
  <section class="relative z-30 -mt-8 sm:-mt-12 lg:-mt-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative group">
        <div
          class="absolute -inset-1 bg-gradient-to-r from-firda-green-500/20 to-firda-blue-500/20 rounded-[2rem] lg:rounded-[3rem] blur-xl opacity-0 group-hover:opacity-100 transition duration-1000"
        >
        </div>
        <div
          class="relative bg-white rounded-[2rem] lg:rounded-[3rem] overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.15)] border-4 lg:border-[12px] border-white"
        >
          <Image
            src={CollageVabok}
            alt="VABOK Collage"
            class="w-full h-auto object-cover max-h-[300px] sm:max-h-[400px] lg:max-h-[600px] hover:scale-105 transition-transform duration-[2s] ease-out"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Over VABOK (CMS Body) -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span
          class="inline-block px-3 py-1 bg-firda-green-100 text-firda-blue-800 text-xs font-bold tracking-wider uppercase rounded-full mb-3"
        >
          Onze visie
        </span>
        <h2 class="text-2xl lg:text-4xl font-bold text-firda-gray-900">
          Samenwerking in de <span class="text-firda-blue-600"
            >onderwijsketen</span
          >
        </h2>
      </div>

      <div
        class="prose prose-lg max-w-none text-firda-gray-600 leading-relaxed"
      >
        {
          content.body
            ?.split("\n")
            .map(
              (paragraph) =>
                paragraph.trim() && <p class="mb-6">{paragraph}</p>,
            )
        }
      </div>
    </div>
  </section>

  <!-- Voor wie is VABOK? -->
  <section class="py-16 bg-firda-gray-50 border-y border-firda-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-firda-gray-900 mb-3">
          Voor wie is VABOK?
        </h2>
        <p class="text-lg text-firda-gray-600 max-w-2xl mx-auto">
          Wij verbinden studenten, docenten en professionals voor een betere
          aansluiting in de beroepskolom.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-blue-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor docenten
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Ontdek onderwijsinnovaties en deel kennis over projecten binnen de
            beroepskolom.
          </p>
        </div>

        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-green-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor projectleiders
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Beheer projectinformatie en deel resultaten effectief met alle
            betrokken stakeholders.
          </p>
        </div>

        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-blue-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor het OCW
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Krijg inzicht in projectvoortgang en de borging van duurzame
            onderwijsverbetering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Voor wie is VABOK kaart (Map Section) -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2
          class="text-3xl lg:text-4xl font-black text-firda-gray-900 mb-4 tracking-tight"
        >
          ONZE <span class="text-firda-blue-600">IMPACT</span> OP DE KAART
        </h2>
        <p class="text-lg text-firda-gray-600 max-w-2xl mx-auto">
          Ontdek alle scholen die onderdeel zijn van het FABOK netwerk en
          samenwerken aan onderwijsvernieuwing.
        </p>
      </div>

      <SchoolMap schools={schools} />

      <div class="mt-8 text-center">
        <a
          href="/scholen"
          class="text-firda-blue-600 font-bold hover:text-firda-blue-800 transition-colors flex items-center justify-center gap-2"
        >
          Bekijk volledige lijst en details
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Hoofdcontent: Projecten, Agenda en Documenten in duidelijke grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Sectie headers -->
      <div class="grid lg:grid-cols-3 gap-8 mb-10">
        <div class="lg:col-span-2">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-firda-gray-900">
                Recente projecten
              </h2>
              <div class="w-10 h-1 bg-firda-green-500 rounded-full mt-2"></div>
            </div>
            <a
              href="/projecten/lijst"
              class="text-firda-blue-600 font-semibold hover:text-firda-blue-800 transition-colors flex items-center gap-1 text-sm"
            >
              Bekijk alles
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
        <div id="documenten">
          <h2 class="text-2xl font-bold text-firda-gray-900">Documenten</h2>
          <div class="w-10 h-1 bg-firda-blue-500 rounded-full mt-2"></div>
        </div>
      </div>

      <!-- Content grid -->
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Projecten (2 kolommen) -->
        <div class="lg:col-span-2">
          {
            latestProjects && latestProjects.length > 0 ? (
              <div class="grid sm:grid-cols-2 gap-4">
                {latestProjects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            ) : (
              <div class="py-16 text-center bg-firda-gray-50 border border-dashed border-firda-gray-300 rounded-xl text-firda-gray-500">
                Geen projecten beschikbaar op dit moment.
              </div>
            )
          }
        </div>

        <!-- Documenten sidebar -->
        <div>
          {
            isLoggedIn ? (
              <div class="bg-firda-gray-50 rounded-xl p-4 border border-firda-gray-200">
                <PdfList pdfs={pdfs || []} title="" maxHeight="500px" />
              </div>
            ) : (
              <div class="p-8 bg-firda-blue-50 rounded-2xl border border-firda-blue-100 text-center">
                <div class="w-12 h-12 bg-firda-blue-100 text-firda-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                </div>
                <h3 class="font-bold text-firda-blue-900 mb-2">
                  Beveiligde Documenten
                </h3>
                <p class="text-xs text-firda-blue-700 leading-relaxed mb-4">
                  De PDF-documenten zijn alleen toegankelijk voor geverifieerde
                  gebruikers. Log in om toegang te krijgen.
                </p>
                <a
                  href="/login"
                  class="inline-block px-6 py-2 bg-firda-blue-600 text-white text-xs font-bold rounded-lg hover:bg-firda-blue-700 transition"
                >
                  Log in
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-firda-blue-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold mb-4 text-white">
        Niet gevonden wat je zocht?
      </h2>
      <p class="text-firda-blue-100 mb-8 max-w-xl mx-auto">
        Bekijk onze volledige bibliotheek aan projecten en ontdek hoe we de
        aansluiting in de beroepskolom versterken.
      </p>
      <a
        href="/projecten/lijst"
        class="inline-flex items-center px-8 py-4 bg-firda-green-500 text-firda-blue-900 font-bold rounded-lg hover:bg-firda-green-400 transition-all shadow-lg hover:scale-105"
      >
        Ontdek alle projecten
      </a>
    </div>
  </section>
</Layout>

<style>
  .marquee-content {
    animation: marquee 60s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.33%);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

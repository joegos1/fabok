---
/**
 * Home / Landingspagina
 * =====================
 * VABOK landingspagina met algemene info en PDF's
 */

import Layout from "../layouts/Layout.astro";
import PdfList from "../components/pdf/PdfList.astro";
import ProjectCard from "../components/project/ProjectCard.astro";
import { supabaseAdmin } from "../lib";
import { Image } from "astro:assets";
import CollageVabok from "../assets/collage-vabok.png";
import type { School } from "../types/database";
import AgendaSection from "../components/agenda/AgendaSection.astro";

// Haal landingpage content op
const { data: landingContent } = await supabaseAdmin
  .from("landing_page_content")
  .select("*")
  .single();

// Haal landing page PDF's op
const { data: pdfs } = await supabaseAdmin
  .from("pdf_files")
  .select("*")
  .eq("is_landing_page", true)
  .order("uploaded_at", { ascending: false });

// Haal de laatste 4 actieve en gepubliceerde projecten op
const { data: latestProjects } = await supabaseAdmin
  .from("projects")
  .select("*")
  .eq("status", "active")
  .eq("is_published", true)
  .order("created_at", { ascending: false })
  .limit(4);

// Haal scholen op voor marquee
const { data: schoolsData } = await supabaseAdmin
  .from("schools")
  .select("*")
  .order("display_order", { ascending: true });

const schools = (schoolsData || []) as School[];

// Haal aankomende en recente evenementen op voor de kalender
const { data: eventsData } = await supabaseAdmin
  .from("project_events")
  .select("*, projects(title)")
  .order("start_date", { ascending: true });

const events = (eventsData || []) as any[];

const content = landingContent || {
  title: "VABOK - Versterken van de Aansluiting in de Beroepskolom",
  intro:
    "Welkom bij VABOK, het platform voor informatie over onderwijsprojecten.",
  body: "Hier vindt u informatie over lopende projecten, hun doelen en resultaten.",
};
---

<Layout title="Home">
  <!-- Hero sectie: Compacter en overzichtelijker -->
  <section
    class="relative bg-firda-blue-500 text-white py-16 lg:py-20 overflow-hidden"
  >
    <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent">
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <!-- Tekst content -->
        <div class="max-w-xl animate-fade-in-up">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl font-extrabold mb-5 leading-tight"
          >
            {content.title}
          </h1>
          <p class="text-lg text-firda-blue-100 mb-8 leading-relaxed">
            {content.intro}
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="/projecten/lijst"
              class="inline-flex items-center px-6 py-3 bg-firda-green-500 text-firda-blue-900 font-bold rounded-lg hover:bg-firda-green-400 transition-all duration-200 shadow-lg hover:scale-105"
            >
              Bekijk projecten
              <svg
                class="ml-2 w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="#documenten"
              class="inline-flex items-center px-6 py-3 bg-white/10 text-white font-semibold rounded-lg hover:bg-white/20 transition-all duration-200 border border-white/20"
            >
              Documenten
            </a>
          </div>
        </div>

        <!-- Video -->
        <div class="relative">
          <div
            class="aspect-video w-full rounded-xl overflow-hidden shadow-2xl bg-black group"
          >
            <video
              id="hero-video"
              class="h-full w-full object-cover opacity-90 group-hover:opacity-100 transition-opacity"
              loop
              playsinline
              preload="metadata"
            >
              <source src="/IMG_1513 (1).mp4" type="video/mp4" />
            </video>

            <div class="absolute inset-0 flex items-center justify-center">
              <button
                id="hero-video-big-play"
                type="button"
                class="w-16 h-16 flex items-center justify-center rounded-full bg-firda-green-500 text-firda-blue-900 shadow-xl hover:scale-110 transition-transform"
              >
                <svg
                  class="w-6 h-6 translate-x-0.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </button>
            </div>

            <div
              class="absolute bottom-0 inset-x-0 p-3 bg-gradient-to-t from-black/80 to-transparent flex items-center gap-3 opacity-0 group-hover:opacity-100 transition-opacity"
            >
              <button
                id="hero-video-toggle"
                class="text-white hover:text-firda-green-400 transition-colors"
              >
                <svg
                  id="hero-video-icon-play"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"><path d="M8 5v14l11-7z"></path></svg
                >
                <svg
                  id="hero-video-icon-pause"
                  class="hidden w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path d="M6 5h4v14H6zm8 0h4v14h-4z"></path></svg
                >
              </button>
              <button
                id="hero-video-mute"
                class="text-white hover:text-firda-green-400 transition-colors"
              >
                <svg
                  id="hero-video-icon-muted"
                  class="w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                  ></path></svg
                >
                <svg
                  id="hero-video-icon-unmuted"
                  class="hidden w-5 h-5"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                  ></path></svg
                >
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Scholen Marquee -->
  {
    schools && schools.length > 0 && (
      <section class="py-6 bg-firda-blue-600 border-y border-white/10">
        <div class="marquee-container overflow-hidden">
          <div class="marquee-content flex items-center gap-10 text-firda-green-400 font-bold uppercase tracking-widest text-xs">
            {[...schools, ...schools, ...schools].map((school) => (
              <span class="whitespace-nowrap flex items-center gap-4">
                {school.name}
                <span class="w-1 h-1 rounded-full bg-firda-green-500/50" />
              </span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Collage -->
  <div class="w-full bg-white py-8">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <Image
        src={CollageVabok}
        alt="VABOK Collage"
        class="w-full h-auto rounded-xl shadow-sm"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Over VABOK (CMS Body) -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span
          class="inline-block px-3 py-1 bg-firda-green-100 text-firda-blue-800 text-xs font-bold tracking-wider uppercase rounded-full mb-3"
        >
          Onze visie
        </span>
        <h2 class="text-2xl lg:text-4xl font-bold text-firda-gray-900">
          Samenwerking in de <span class="text-firda-blue-600"
            >onderwijsketen</span
          >
        </h2>
      </div>

      <div
        class="prose prose-lg max-w-none text-firda-gray-600 leading-relaxed"
      >
        {
          content.body
            ?.split("\n")
            .map(
              (paragraph) =>
                paragraph.trim() && <p class="mb-6">{paragraph}</p>,
            )
        }
      </div>
    </div>
  </section>

  <!-- Voor wie is VABOK? -->
  <section class="py-16 bg-firda-gray-50 border-y border-firda-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-firda-gray-900 mb-3">
          Voor wie is VABOK?
        </h2>
        <p class="text-lg text-firda-gray-600 max-w-2xl mx-auto">
          Wij verbinden studenten, docenten en professionals voor een betere
          aansluiting in de beroepskolom.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-blue-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor docenten
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Ontdek onderwijsinnovaties en deel kennis over projecten binnen de
            beroepskolom.
          </p>
        </div>

        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-green-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor projectleiders
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Beheer projectinformatie en deel resultaten effectief met alle
            betrokken stakeholders.
          </p>
        </div>

        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-blue-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor het OCW
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Krijg inzicht in projectvoortgang en de borging van duurzame
            onderwijsverbetering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hoofdcontent: Projecten, Agenda en Documenten in duidelijke grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Sectie headers -->
      <div class="grid lg:grid-cols-3 gap-8 mb-10">
        <div class="lg:col-span-2">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-firda-gray-900">
                Recente projecten
              </h2>
              <div class="w-10 h-1 bg-firda-green-500 rounded-full mt-2"></div>
            </div>
            <a
              href="/projecten/lijst"
              class="text-firda-blue-600 font-semibold hover:text-firda-blue-800 transition-colors flex items-center gap-1 text-sm"
            >
              Bekijk alles
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
        <div id="documenten">
          <h2 class="text-2xl font-bold text-firda-gray-900">Documenten</h2>
          <div class="w-10 h-1 bg-firda-blue-500 rounded-full mt-2"></div>
        </div>
      </div>

      <!-- Content grid -->
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Projecten (2 kolommen) -->
        <div class="lg:col-span-2">
          {
            latestProjects && latestProjects.length > 0 ? (
              <div class="grid sm:grid-cols-2 gap-4">
                {latestProjects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            ) : (
              <div class="py-16 text-center bg-firda-gray-50 border border-dashed border-firda-gray-300 rounded-xl text-firda-gray-500">
                Geen projecten beschikbaar op dit moment.
              </div>
            )
          }
        </div>

        <!-- Documenten sidebar -->
        <div>
          <div
            class="bg-firda-gray-50 rounded-xl p-4 border border-firda-gray-200"
          >
            <PdfList pdfs={pdfs || []} title="" maxHeight="500px" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Agenda Sectie -->
  <section class="py-16 bg-firda-blue-50/50 border-y border-firda-blue-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-3 gap-10">
        <div>
          <h2 class="text-2xl font-bold text-firda-gray-900 mb-4">
            Aankomende <span class="text-firda-blue-600">evenementen</span>
          </h2>
          <p class="text-firda-gray-600 mb-6">
            Blijf op de hoogte van bijeenkomsten, workshops en deadlines.
          </p>
          <a
            href="/projecten/agenda"
            class="inline-flex items-center text-firda-blue-600 font-semibold hover:text-firda-blue-800 transition-colors text-sm group"
          >
            Bekijk volledige agenda
            <svg
              class="ml-1 w-4 h-4 group-hover:translate-x-1 transition-transform"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
        <div class="lg:col-span-2">
          <AgendaSection
            events={events}
            showProject={true}
            title=""
            emptyMessage="Er zijn momenteel geen aankomende evenementen gepland."
          />
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 bg-firda-blue-600">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl lg:text-3xl font-bold mb-4 text-white">
        Niet gevonden wat je zocht?
      </h2>
      <p class="text-firda-blue-100 mb-8 max-w-xl mx-auto">
        Bekijk onze volledige bibliotheek aan projecten en ontdek hoe we de
        aansluiting in de beroepskolom versterken.
      </p>
      <a
        href="/projecten/lijst"
        class="inline-flex items-center px-8 py-4 bg-firda-green-500 text-firda-blue-900 font-bold rounded-lg hover:bg-firda-green-400 transition-all shadow-lg hover:scale-105"
      >
        Ontdek alle projecten
      </a>
    </div>
  </section>
</Layout>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement;
  const toggle = document.getElementById("hero-video-toggle");
  const bigPlay = document.getElementById("hero-video-big-play");
  const muteBtn = document.getElementById("hero-video-mute");
  const iconPlay = document.getElementById("hero-video-icon-play");
  const iconPause = document.getElementById("hero-video-icon-pause");
  const iconMuted = document.getElementById("hero-video-icon-muted");
  const iconUnmuted = document.getElementById("hero-video-icon-unmuted");

  function setPlayUi(isPlaying: boolean) {
    iconPlay?.classList.toggle("hidden", isPlaying);
    iconPause?.classList.toggle("hidden", !isPlaying);
  }

  function setMuteUi(isMuted: boolean) {
    iconMuted?.classList.toggle("hidden", !isMuted);
    iconUnmuted?.classList.toggle("hidden", isMuted);
  }

  async function playVideo() {
    if (!video) return;
    try {
      await video.play();
      setPlayUi(true);
      bigPlay?.classList.add("hidden");
    } catch (e) {
      console.error("Video play failed", e);
    }
  }

  bigPlay?.addEventListener("click", () => {
    video.muted = false;
    setMuteUi(false);
    playVideo();
  });

  toggle?.addEventListener("click", () => {
    if (video.paused) {
      playVideo();
    } else {
      video.pause();
      setPlayUi(false);
    }
  });

  muteBtn?.addEventListener("click", () => {
    video.muted = !video.muted;
    setMuteUi(video.muted);
  });
</script>

<style>
  .marquee-content {
    animation: marquee 60s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.33%);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

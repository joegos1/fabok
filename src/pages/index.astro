---
/**
 * Home / Landingspagina
 * =====================
 * Dit is de main landingspagina van FABOK dus waar je komt als je de link opent
 */

import Layout from "../layouts/Layout.astro";
import PdfList from "../components/pdf/PdfList.astro";
import ProjectCard from "../components/project/ProjectCard.astro";
import { Image } from "astro:assets";
import CollageVabok from "../assets/collage-vabok.png";
import type {
  School,
  ProjectEvent,
  EventRegistration,
} from "../types/database";
import {
  supabaseAdmin,
  getCurrentUser,
  getUserProfile,
  isAdmin,
  isProjectEditor,
} from "../lib";
import AgendaSection from "../components/agenda/AgendaSection.astro";
import SchoolMap from "../components/SchoolMap.astro";

// Auth check voor registraties
const cookies = Astro.request.headers.get("cookie") || "";
const accessToken = cookies.match(/sb-access-token=([^;]+)/)?.[1];
const user = await getCurrentUser(accessToken);
const profile = user ? await getUserProfile(user.id) : null;
const isLoggedIn = !!user;
const canViewRegistrations = false; // Registraties nu alleen in dashboard te zien

// Haal landingpage content op
const { data: landingContent } = await supabaseAdmin
  .from("landing_page_content")
  .select("*")
  .single();

// Haal landing page PDF's op
const { data: pdfs } = await supabaseAdmin
  .from("pdf_files")
  .select("*")
  .eq("is_landing_page", true)
  .order("uploaded_at", { ascending: false });

// Haal de laatste 4 actieve en gepubliceerde projecten op
const { data: latestProjects } = await supabaseAdmin
  .from("projects")
  .select("*")
  .eq("status", "active")
  .eq("is_published", true)
  .order("created_at", { ascending: false })
  .limit(4);

// Haal scholen op voor marquee
const { data: schoolsData } = await supabaseAdmin
  .from("schools")
  .select("*")
  .order("display_order", { ascending: true });

const schools = (schoolsData || []) as School[];

// Haal aankomende en recente evenementen op voor de kalender
const { data: eventsData } = await supabaseAdmin
  .from("project_events")
  .select("*, projects(title)")
  .order("start_date", { ascending: true });

// Haal alle registraties op voor deze events
const eventIds = ((eventsData || []) as any[]).map((e) => e.id);
const { data: allRegistrationsData } = await supabaseAdmin
  .from("event_registrations")
  .select("*")
  .in("event_id", eventIds);

const allRegistrations = (allRegistrationsData || []) as EventRegistration[];

const events = ((eventsData || []) as any[]).map((event) => ({
  ...event,
  registrationCount: allRegistrations.filter((r) => r.event_id === event.id)
    .length,
  canViewRegistrations: false,
  registrations: [],
}));

const content = landingContent || {
  title: "VABOK - Versterken van de Aansluiting in de Beroepskolom",
  intro:
    "Welkom bij VABOK, het platform voor informatie over onderwijsprojecten.",
  body: "Hier vindt u informatie over lopende projecten, hun doelen en resultaten.",
};
---

<Layout title="Home">
  <!-- Hero sectie: Premium Diagonal Rework -->
  <section
    class="relative min-h-[85vh] flex items-center bg-firda-blue-600 text-white overflow-hidden"
  >
    <!-- Background Layers -->
    <div class="absolute inset-0 z-0">
      <!-- Mesh Gradient -->
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_20%_30%,#3B5755_0%,transparent_50%),radial-gradient(circle_at_80%_70%,#EAB308_0%,transparent_50% )] opacity-40 blur-3xl animate-pulse"
        style="animation-duration: 10s;"
      >
      </div>

      <!-- Grain Texture Overlay -->
      <div
        class="absolute inset-0 opacity-[0.03] pointer-events-none mix-blend-overlay bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
      >
      </div>

      <!-- Diagonal Shape -->
      <div
        class="absolute right-0 top-0 h-full w-1/2 bg-white/5 skew-x-[-12deg] translate-x-32 hidden lg:block"
      >
      </div>
    </div>

    <!-- Floating Decorative Blobs -->
    <div
      class="absolute top-1/4 -left-20 w-64 h-64 bg-firda-green-500/20 rounded-full blur-[100px] animate-blob transition-all duration-1000"
    >
    </div>
    <div
      class="absolute bottom-1/4 -right-20 w-96 h-96 bg-firda-blue-400/20 rounded-full blur-[120px] animate-blob animation-delay-4000 transition-all duration-1000"
    >
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid gap-16 lg:grid-cols-12 lg:items-center">
        <!-- Tekst content -->
        <div class="lg:col-span-7 max-w-3xl">
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-firda-green-500/10 border border-firda-green-500/20 text-firda-green-400 text-[10px] font-black tracking-[0.2em] uppercase mb-8 animate-fade-in"
          >
            <span class="relative flex h-2 w-2">
              <span
                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-firda-green-400 opacity-75"
              ></span>
              <span
                class="relative inline-flex rounded-full h-2 w-2 bg-firda-green-500"
              ></span>
            </span>
            Kennis & Innovatie Platform
          </div>

          <h1
            class="text-5xl sm:text-6xl lg:text-8xl font-black mb-8 leading-[0.9] tracking-tight animate-reveal-text font-display"
          >
            {content.title.split(" - ")[0]}<br />
            <span class="text-firda-green-500">AANSLUITING</span>
          </h1>

          <p
            class="text-xl sm:text-2xl text-firda-blue-100/80 mb-12 leading-relaxed max-w-xl animate-fade-in-up"
            style="animation-delay: 0.4s;"
          >
            {content.intro}
          </p>

          <div
            class="flex flex-wrap gap-6 animate-fade-in-up"
            style="animation-delay: 0.6s;"
          >
            <a
              href="/projecten/lijst"
              class="group relative inline-flex items-center px-10 py-5 bg-firda-green-500 text-firda-blue-900 font-black rounded-2xl hover:bg-white transition-all duration-500 shadow-[0_20px_50px_rgba(234,179,8,0.3)] hover:shadow-white/20 hover:-translate-y-1"
            >
              <span class="relative z-10 flex items-center gap-3">
                ONTDEK DE PROJECTEN
                <svg
                  class="w-6 h-6 transform group-hover:translate-x-2 transition-transform duration-300"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="3"
                    d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                </svg>
              </span>
            </a>

            <a
              href="#documenten"
              class="inline-flex items-center px-10 py-5 bg-white/5 text-white font-bold rounded-2xl border border-white/10 hover:bg-white/10 hover:border-white/30 transition-all duration-300 backdrop-blur-sm"
            >
              DOCUMENTEN
            </a>
          </div>
        </div>

        <!-- Image / Collage Section -->
        <div class="lg:col-span-5 relative lg:block">
          <!-- Geometric Accent -->
          <div
            class="absolute -inset-4 border border-firda-green-500/20 rounded-[3rem] -rotate-3 animate-pulse"
          >
          </div>

          <div class="relative animate-float">
            <div
              class="absolute -top-10 -right-10 w-24 h-24 bg-firda-green-500 rounded-full mix-blend-screen blur-2xl opacity-50"
            >
            </div>
            <Image
              src={CollageVabok}
              alt="VABOK"
              class="w-full h-auto rounded-[2.5rem] shadow-[0_50px_100px_-20px_rgba(0,0,0,0.5)] border-[12px] border-white/5 backdrop-blur-md relative z-10 transition-transform duration-700 hover:scale-105"
              loading="eager"
            />
          </div>

          <!-- Abstract Info Card -->
          <div
            class="absolute -bottom-6 -left-6 bg-white p-6 rounded-2xl shadow-2xl z-20 animate-fade-in-up hidden sm:block"
            style="animation-delay: 1s;"
          >
            <div class="flex items-center gap-4">
              <div
                class="w-12 h-12 bg-firda-blue-500 rounded-xl flex items-center justify-center text-firda-green-400"
              >
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"
                  ><path
                    d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3zM6 8a2 2 0 11-4 0 2 2 0 014 0zM16 18v-3a5.972 5.972 0 00-.75-2.906A3.005 3.005 0 0119 15v3h-3zM4.75 12.094A5.973 5.973 0 004 15v3H1v-3a3 3 0 015-2.906z"
                  ></path></svg
                >
              </div>
              <div>
                <div
                  class="text-[10px] font-black text-firda-gray-400 uppercase tracking-widest"
                >
                  Samenwerking
                </div>
                <div class="text-lg font-bold text-firda-blue-900 leading-none">
                  Netwerk gegroeid
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Scholen Marquee -->
  {
    schools && schools.length > 0 && (
      <section class="py-6 bg-firda-blue-600 border-y border-white/10">
        <div class="marquee-container overflow-hidden">
          <div class="marquee-content flex items-center gap-10 text-firda-green-400 font-bold uppercase tracking-widest text-xs">
            {[...schools, ...schools, ...schools].map((school) => (
              <span class="whitespace-nowrap flex items-center gap-4">
                {school.name}
                <span class="w-1 h-1 rounded-full bg-firda-green-500/50" />
              </span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Collage (Nu compacter binnenshuis) -->
  <div class="w-full bg-white py-4 -mt-10 relative z-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Verwijderd hier, staat nu in de hero -->
    </div>
  </div>

  <!-- Agenda Sectie -->
  <section
    class="py-20 bg-firda-gray-50 border-y border-firda-gray-100"
    id="agenda-section"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-12">
        <!-- Linker kant: Tekst -->
        <div class="lg:col-span-4 space-y-6">
          <div>
            <span
              class="inline-block px-3 py-1 bg-firda-blue-100 text-firda-blue-700 text-[10px] font-black tracking-widest uppercase rounded-full mb-3"
            >
              Evenementen
            </span>
            <h2
              class="text-3xl lg:text-4xl font-black text-firda-gray-900 leading-tight"
            >
              BLIJF OP DE <span class="text-firda-blue-600">HOOGTE</span>
            </h2>
          </div>
          <p class="text-firda-gray-600 leading-relaxed">
            Bekijk onze aankomende fysieke en online bijeenkomsten. Meld je
            direct aan om deel te nemen aan onze projecten en kennisdeling
            sessies.
          </p>
          <div class="pt-4">
            <div
              class="flex items-center gap-4 p-4 bg-white rounded-2xl border border-firda-gray-200 shadow-sm"
            >
              <div
                class="w-12 h-12 rounded-xl bg-firda-green-500 text-white flex items-center justify-center shadow-lg shadow-firda-green-500/20"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2.5"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <div
                  class="text-[10px] font-black text-firda-gray-400 border-b border-firda-gray-100 mb-1 uppercase tracking-widest"
                >
                  Wist je dat?
                </div>
                <div class="text-sm font-bold text-firda-gray-800">
                  Aanmelden is gratis voor iedereen.
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Rechter kant: Agenda -->
        <div class="lg:col-span-8">
          <div
            class="bg-white p-6 rounded-3xl border border-firda-gray-200 shadow-xl overflow-hidden"
          >
            <AgendaSection
              events={events}
              showProject={true}
              title=""
              fullWidth={true}
              showList={true}
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Over VABOK (CMS Body) -->
  <section class="py-20 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <span
          class="inline-block px-3 py-1 bg-firda-green-100 text-firda-blue-800 text-xs font-bold tracking-wider uppercase rounded-full mb-3"
        >
          Onze visie
        </span>
        <h2 class="text-2xl lg:text-4xl font-bold text-firda-gray-900">
          Samenwerking in de <span class="text-firda-blue-600"
            >onderwijsketen</span
          >
        </h2>
      </div>

      <div
        class="prose prose-lg max-w-none text-firda-gray-600 leading-relaxed"
      >
        {
          content.body
            ?.split("\n")
            .map(
              (paragraph) =>
                paragraph.trim() && <p class="mb-6">{paragraph}</p>,
            )
        }
      </div>
    </div>
  </section>

  <!-- Voor wie is VABOK? -->
  <section class="py-16 bg-firda-gray-50 border-y border-firda-gray-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl lg:text-3xl font-bold text-firda-gray-900 mb-3">
          Voor wie is VABOK?
        </h2>
        <p class="text-lg text-firda-gray-600 max-w-2xl mx-auto">
          Wij verbinden studenten, docenten en professionals voor een betere
          aansluiting in de beroepskolom.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-blue-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor docenten
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Ontdek onderwijsinnovaties en deel kennis over projecten binnen de
            beroepskolom.
          </p>
        </div>

        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-green-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor projectleiders
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Beheer projectinformatie en deel resultaten effectief met alle
            betrokken stakeholders.
          </p>
        </div>

        <div
          class="bg-white p-6 rounded-xl border-l-4 border-firda-blue-500 shadow-sm hover:shadow-md transition-shadow"
        >
          <div
            class="w-10 h-10 bg-firda-blue-600 text-firda-green-400 rounded-lg flex items-center justify-center mb-4"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-firda-gray-900 mb-2">
            Voor het OCW
          </h3>
          <p class="text-firda-gray-600 text-sm">
            Krijg inzicht in projectvoortgang en de borging van duurzame
            onderwijsverbetering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Voor wie is VABOK kaart (Map Section) -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2
          class="text-3xl lg:text-4xl font-black text-firda-gray-900 mb-4 tracking-tight"
        >
          ONZE <span class="text-firda-blue-600">IMPACT</span> OP DE KAART
        </h2>
        <p class="text-lg text-firda-gray-600 max-w-2xl mx-auto">
          Ontdek alle scholen die onderdeel zijn van het FABOK netwerk en
          samenwerken aan onderwijsvernieuwing.
        </p>
      </div>

      <SchoolMap schools={schools} />

      <div class="mt-8 text-center">
        <a
          href="/scholen"
          class="text-firda-blue-600 font-bold hover:text-firda-blue-800 transition-colors flex items-center justify-center gap-2"
        >
          Bekijk volledige lijst en details
          <svg
            class="w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- Hoofdcontent: Projecten, Agenda en Documenten in duidelijke grid -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Sectie headers -->
      <div class="grid lg:grid-cols-3 gap-8 mb-10">
        <div class="lg:col-span-2">
          <div class="flex items-center justify-between">
            <div>
              <h2 class="text-2xl font-bold text-firda-gray-900">
                Recente projecten
              </h2>
              <div class="w-10 h-1 bg-firda-green-500 rounded-full mt-2"></div>
            </div>
            <a
              href="/projecten/lijst"
              class="text-firda-blue-600 font-semibold hover:text-firda-blue-800 transition-colors flex items-center gap-1 text-sm"
            >
              Bekijk alles
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"></path></svg
              >
            </a>
          </div>
        </div>
        <div id="documenten">
          <h2 class="text-2xl font-bold text-firda-gray-900">Documenten</h2>
          <div class="w-10 h-1 bg-firda-blue-500 rounded-full mt-2"></div>
        </div>
      </div>

      <!-- Content grid -->
      <div class="grid lg:grid-cols-3 gap-8">
        <!-- Projecten (2 kolommen) -->
        <div class="lg:col-span-2">
          {
            latestProjects && latestProjects.length > 0 ? (
              <div class="grid sm:grid-cols-2 gap-4">
                {latestProjects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            ) : (
              <div class="py-16 text-center bg-firda-gray-50 border border-dashed border-firda-gray-300 rounded-xl text-firda-gray-500">
                Geen projecten beschikbaar op dit moment.
              </div>
            )
          }
        </div>

        <!-- Documenten sidebar -->
        <div>
          {
            isLoggedIn ? (
              <div class="bg-firda-gray-50 rounded-xl p-4 border border-firda-gray-200">
                <PdfList pdfs={pdfs || []} title="" maxHeight="500px" />
              </div>
            ) : (
              <div class="p-8 bg-firda-blue-50 rounded-2xl border border-firda-blue-100 text-center">
                <div class="w-12 h-12 bg-firda-blue-100 text-firda-blue-600 rounded-full flex items-center justify-center mx-auto mb-4">
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                    />
                  </svg>
                </div>
                <h3 class="font-bold text-firda-blue-900 mb-2">
                  Beveiligde Documenten
                </h3>
                <p class="text-xs text-firda-blue-700 leading-relaxed mb-4">
                  De PDF-documenten zijn alleen toegankelijk voor geverifieerde
                  gebruikers. Log in om toegang te krijgen.
                </p>
                <a
                  href="/login"
                  class="inline-block px-6 py-2 bg-firda-blue-600 text-white text-xs font-bold rounded-lg hover:bg-firda-blue-700 transition"
                >
                  Log in
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->

---
/**
 * Home / Landingspagina
 * =====================
 * VABOK landingspagina met algemene info en PDF's
 */

import Layout from "../layouts/Layout.astro";
import PdfList from "../components/pdf/PdfList.astro";
import ProjectCard from "../components/project/ProjectCard.astro";
import { supabaseAdmin } from "../lib";
import { Image } from "astro:assets";
import CollageVabok from "../assets/collage-vabok.png";
import type { School } from "../types/database";

// Haal landingpage content op
const { data: landingContent } = await supabaseAdmin
  .from("landing_page_content")
  .select("*")
  .single();

// Haal landing page PDF's op
const { data: pdfs } = await supabaseAdmin
  .from("pdf_files")
  .select("*")
  .eq("is_landing_page", true)
  .order("uploaded_at", { ascending: false });

// Haal de laatste 4 actieve en gepubliceerde projecten op
const { data: latestProjects } = await supabaseAdmin
  .from("projects")
  .select("*")
  .eq("status", "active")
  .eq("is_published", true)
  .order("created_at", { ascending: false })
  .limit(4);

// Haal scholen op voor marquee
const { data: schoolsData } = await supabaseAdmin
  .from("schools")
  .select("*")
  .order("display_order", { ascending: true });

const schools = (schoolsData || []) as School[];

const content = landingContent || {
  title: "VABOK - Versterken van de Aansluiting in de Beroepskolom",
  intro:
    "Welkom bij VABOK, het platform voor informatie over onderwijsprojecten.",
  body: "Hier vindt u informatie over lopende projecten, hun doelen en resultaten.",
};
---

<Layout title="Home">
  <!-- Hero sectie: Cleaner en professioneler -->
  <section
    class="relative bg-firda-blue-900 text-white py-12 lg:py-24 overflow-hidden"
  >
    <!-- Subtiele achtergrond textuur of verloop -->
    <div class="absolute inset-0 opacity-20">
      <div
        class="absolute inset-0 bg-gradient-to-br from-firda-blue-800 to-transparent"
      >
      </div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid gap-16 lg:grid-cols-2 lg:items-center">
        <div class="max-w-2xl">
          <h1
            class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold mb-6 leading-tight tracking-tight"
          >
            {content.title}
          </h1>
          <p
            class="text-lg sm:text-xl text-firda-blue-100 mb-8 leading-relaxed font-light max-w-xl"
          >
            {content.intro}
          </p>
          <div class="flex flex-wrap gap-6">
            <a
              href="/projecten/lijst"
              class="inline-flex items-center px-8 py-4 bg-firda-green-500 text-firda-blue-900 font-bold rounded-lg hover:bg-firda-green-400 transition-all duration-200 shadow-lg shadow-firda-green-500/20"
            >
              Bekijk projecten
              <svg
                class="ml-2 w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="#documenten"
              class="inline-flex items-center px-8 py-4 bg-white/5 backdrop-blur-md text-white font-semibold rounded-lg hover:bg-white/10 transition-all duration-200 border border-white/20"
            >
              Documenten
            </a>
          </div>
        </div>

        <!-- Video: Strakker geïntegreerd -->
        <div class="relative">
          <div
            class="aspect-video w-full rounded-2xl overflow-hidden shadow-2xl bg-black group relative"
          >
            <video
              id="hero-video"
              class="h-full w-full object-cover opacity-80 group-hover:opacity-100 transition-opacity"
              loop
              playsinline
              preload="metadata"
            >
              <source src="/IMG_1513 (1).mp4" type="video/mp4" />
            </video>

            <div class="absolute inset-0 flex items-center justify-center">
              <button
                id="hero-video-big-play"
                type="button"
                class="w-20 h-20 flex items-center justify-center rounded-full bg-firda-green-500 text-firda-blue-900 shadow-xl hover:scale-110 transition-transform"
              >
                <svg
                  class="w-8 h-8 translate-x-1"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </button>
            </div>

            <!-- Controls overlay -->
            <div
              class="absolute bottom-0 inset-x-0 p-4 bg-gradient-to-t from-black/80 to-transparent flex items-center gap-4 opacity-0 group-hover:opacity-100 transition-opacity"
            >
              <button
                id="hero-video-toggle"
                class="text-white hover:text-firda-green-400 transition-colors"
              >
                <svg
                  id="hero-video-icon-play"
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="currentColor"><path d="M8 5v14l11-7z"></path></svg
                >
                <svg
                  id="hero-video-icon-pause"
                  class="hidden w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path d="M6 5h4v14H6zm8 0h4v14h-4z"></path></svg
                >
              </button>
              <button
                id="hero-video-mute"
                class="text-white hover:text-firda-green-400 transition-colors"
              >
                <svg
                  id="hero-video-icon-muted"
                  class="w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"
                  ></path></svg
                >
                <svg
                  id="hero-video-icon-unmuted"
                  class="hidden w-6 h-6"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  ><path
                    d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"
                  ></path></svg
                >
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Marquee: Terug naar krachtige merkkleuren -->
  {
    schools && schools.length > 0 && (
      <section class="py-10 bg-gradient-to-r from-firda-blue-600 to-firda-blue-700 border-y border-white/10">
        <div class="marquee-container overflow-hidden">
          <div class="marquee-content flex items-center gap-12 text-firda-green-400 font-bold uppercase tracking-widest text-sm">
            {[...schools, ...schools, ...schools].map((school) => (
              <span class="whitespace-nowrap flex items-center gap-6">
                {school.name}
                <span class="w-1.5 h-1.5 rounded-full bg-firda-green-500/50" />
              </span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Collage Image: Verplaatst naar tussen marquee en over ons -->
  <div class="w-full bg-white pt-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Image
        src={CollageVabok}
        alt="VABOK Collage"
        class="w-full h-auto"
        loading="lazy"
      />
    </div>
  </div>

  <!-- Over VABOK: Centraal en leesbaar (CMS Body) -->
  <section class="py-24 bg-white relative">
    <!-- Subtiele kleur accent aan de zijkant -->
    <div
      class="absolute left-0 top-1/4 w-1 h-1/2 bg-firda-green-500 rounded-r-full opacity-30"
    >
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <span
          class="inline-block px-4 py-1.5 bg-firda-green-100 text-firda-blue-800 text-sm font-bold tracking-wider uppercase rounded-full mb-4"
        >
          Onze visie
        </span>
        <h2 class="text-3xl lg:text-5xl font-bold text-firda-gray-900">
          Samenwerking in de <span class="text-firda-blue-600"
            >onderwijsketen</span
          >
        </h2>
      </div>

      <div
        class="prose prose-lg lg:prose-xl max-w-none text-firda-gray-600 leading-relaxed font-serif"
      >
        {
          content.body
            ?.split("\n")
            .map(
              (paragraph) =>
                paragraph.trim() && <p class="mb-8">{paragraph}</p>,
            )
        }
      </div>
    </div>
  </section>

  <!-- Voor wie is VABOK?: Kleurrijke accenten -->
  <section class="py-24 bg-firda-blue-50/30 border-y border-firda-blue-100/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-firda-gray-900 mb-6">
          Voor wie is VABOK?
        </h2>
        <p class="text-xl text-firda-gray-600">
          Wij verbinden studenten, docenten en professionals voor een betere
          aansluiting in de beroepskolom.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-10">
        <!-- Kaartjes met merk-accenten -->
        <div
          class="bg-white p-10 rounded-2xl border-b-4 border-firda-blue-500 shadow-sm hover:shadow-xl transition-all duration-300"
        >
          <div
            class="w-12 h-12 bg-firda-blue-600 text-firda-green-400 rounded-xl flex items-center justify-center mb-8 shadow-inner"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-firda-gray-900 mb-4">
            Voor docenten
          </h3>
          <p class="text-firda-gray-600 leading-relaxed">
            Ontdek onderwijsinnovaties en deel kennis over projecten binnen de
            beroepskolom.
          </p>
        </div>

        <div
          class="bg-white p-10 rounded-2xl border-b-4 border-firda-green-500 shadow-sm hover:shadow-xl transition-all duration-300"
        >
          <div
            class="w-12 h-12 bg-firda-blue-600 text-firda-green-400 rounded-xl flex items-center justify-center mb-8 shadow-inner"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-firda-gray-900 mb-4">
            Voor projectleiders
          </h3>
          <p class="text-firda-gray-600 leading-relaxed">
            Beheer projectinformatie en deel resultaten effectief met alle
            betrokken stakeholders.
          </p>
        </div>

        <div
          class="bg-white p-10 rounded-2xl border-b-4 border-firda-blue-500 shadow-sm hover:shadow-xl transition-all duration-300"
        >
          <div
            class="w-12 h-12 bg-firda-blue-600 text-firda-green-400 rounded-xl flex items-center justify-center mb-8 shadow-inner"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-firda-gray-900 mb-4">
            Voor het OCW
          </h3>
          <p class="text-firda-gray-600 leading-relaxed">
            Krijg inzicht in projectvoortgang en de borging van duurzame
            onderwijsverbetering.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Projecten & Documenten -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-12 gap-16">
        <!-- Recente Projecten -->
        <div class="lg:col-span-8">
          <div class="flex items-center justify-between mb-12">
            <h2 class="text-3xl font-bold text-firda-gray-900">
              Recente projecten
            </h2>
            <a
              href="/projecten/lijst"
              class="text-firda-blue-600 font-semibold hover:underline"
            >
              Bekijk alles →
            </a>
          </div>

          {
            latestProjects && latestProjects.length > 0 ? (
              <div class="grid gap-6">
                {latestProjects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            ) : (
              <div class="py-20 text-center bg-firda-gray-50 rounded-2xl text-firda-gray-500">
                Geen projecten beschikbaar.
              </div>
            )
          }
        </div>

        <!-- Documenten -->
        <div class="lg:col-span-4">
          <div id="documenten" class="sticky top-24">
            <h2 class="text-3xl font-bold text-firda-gray-900 mb-12">
              Documenten
            </h2>
            <div
              class="bg-firda-gray-50 rounded-2xl p-2 border border-firda-gray-200"
            >
              <PdfList pdfs={pdfs || []} title="" maxHeight="600px" />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 bg-firda-blue-600 text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-5xl font-bold mb-8 text-white">
        Klaar om te ontdekken?
      </h2>
      <p class="text-xl text-firda-blue-100 mb-12">
        Bekijk onze projecten en ontdek hoe we de aansluiting in de beroepskolom
        versterken.
      </p>
      <a
        href="/projecten/lijst"
        class="inline-flex items-center px-10 py-5 bg-firda-green-500 text-firda-blue-900 font-bold rounded-xl hover:bg-firda-green-400 transition-all shadow-xl"
      >
        Ontdek onze projecten
      </a>
    </div>
  </section>
</Layout>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement;
  const toggle = document.getElementById("hero-video-toggle");
  const bigPlay = document.getElementById("hero-video-big-play");
  const muteBtn = document.getElementById("hero-video-mute");
  const iconPlay = document.getElementById("hero-video-icon-play");
  const iconPause = document.getElementById("hero-video-icon-pause");
  const iconMuted = document.getElementById("hero-video-icon-muted");
  const iconUnmuted = document.getElementById("hero-video-icon-unmuted");

  function setPlayUi(isPlaying: boolean) {
    iconPlay?.classList.toggle("hidden", isPlaying);
    iconPause?.classList.toggle("hidden", !isPlaying);
  }

  function setMuteUi(isMuted: boolean) {
    iconMuted?.classList.toggle("hidden", !isMuted);
    iconUnmuted?.classList.toggle("hidden", isMuted);
  }

  async function playVideo() {
    if (!video) return;
    try {
      await video.play();
      setPlayUi(true);
      bigPlay?.classList.add("hidden");
    } catch (e) {
      console.error("Video play failed", e);
    }
  }

  bigPlay?.addEventListener("click", () => {
    video.muted = false;
    setMuteUi(false);
    playVideo();
  });

  toggle?.addEventListener("click", () => {
    if (video.paused) {
      playVideo();
    } else {
      video.pause();
      setPlayUi(false);
    }
  });

  muteBtn?.addEventListener("click", () => {
    video.muted = !video.muted;
    setMuteUi(video.muted);
  });
</script>

<style>
  .marquee-content {
    animation: marquee 60s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.33%);
    }
  }
</style>

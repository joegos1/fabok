---
/**
 * Dashboard Nieuw Evenement
 * =========================
 * Formulier voor het aanmaken van een nieuw agenda-item.
 */

import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { requireAuth, supabaseAdmin } from "../../../../lib";

// Check authenticatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
    return auth.redirect;
}

const { profile } = auth;
if (!profile) {
    return Astro.redirect("/login");
}

const isAdmin = profile.role === "admin";

// Haal projecten op waarvoor de gebruiker evenementen mag aanmaken
let query = supabaseAdmin
    .from("projects")
    .select("id, title")
    .eq("status", "active");

if (!isAdmin) {
    query = query.eq("owner_id", profile.id);
}

const { data: projectsData } = await query.order("title", { ascending: true });
const projects = (projectsData || []) as any[];

// Tijdstip afronden op hele uren voor de default
const defaultStart = new Date();
defaultStart.setMinutes(0, 0, 0);
const defaultDate = defaultStart.toISOString().split("T")[0];
const defaultTime = defaultStart.toTimeString().split(" ")[0].substring(0, 5);
---

<DashboardLayout title="Nieuw Evenement" profile={profile}>
    <div class="max-w-3xl mx-auto">
        <div class="mb-8">
            <a
                href="/dashboard/agenda/overzicht"
                class="inline-flex items-center text-sm text-firda-gray-500 hover:text-firda-blue-600 transition mb-4"
            >
                <svg
                    class="w-4 h-4 mr-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Terug naar overzicht
            </a>
            <h1 class="text-2xl font-bold text-firda-gray-900">
                Nieuw evenement toevoegen
            </h1>
        </div>

        <form
            action="/api/agenda/create"
            method="POST"
            class="space-y-6 bg-white p-8 rounded-xl shadow-sm border border-firda-gray-200"
        >
            <!-- Project Selectie -->
            <div>
                <label
                    for="project_id"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Project *</label
                >
                <select
                    name="project_id"
                    id="project_id"
                    required
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 bg-white"
                >
                    <option value="">Selecteer een project...</option>
                    {
                        projects?.map((project: any) => (
                            <option value={project.id}>{project.title}</option>
                        ))
                    }
                </select>
            </div>

            <!-- Titel -->
            <div>
                <label
                    for="title"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Titel *</label
                >
                <input
                    type="text"
                    name="title"
                    id="title"
                    required
                    placeholder="Bijv. Projectpresentatie of Deadline Fase 1"
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                />
            </div>

            <!-- Beschrijving -->
            <div>
                <label
                    for="description"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Beschrijving</label
                >
                <textarea
                    name="description"
                    id="description"
                    rows="3"
                    placeholder="Optionele toelichting..."
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                ></textarea>
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
                <!-- Datum -->
                <div>
                    <label
                        for="date"
                        class="block text-sm font-semibold text-firda-gray-700 mb-2"
                        >Datum *</label
                    >
                    <input
                        type="date"
                        name="date"
                        id="date"
                        required
                        value={defaultDate}
                        class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    />
                </div>

                <!-- Tijd -->
                <div>
                    <label
                        for="time"
                        class="block text-sm font-semibold text-firda-gray-700 mb-2"
                        >Tijdstip *</label
                    >
                    <input
                        type="time"
                        name="time"
                        id="time"
                        required
                        value={defaultTime}
                        class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    />
                </div>
            </div>

            <!-- Locatie -->
            <div>
                <label
                    for="location"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Locatie</label
                >
                <input
                    type="text"
                    name="location"
                    id="location"
                    placeholder="Bijv. Lokaal 2.15 of Online (Teams)"
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                />
            </div>

            <div
                class="pt-4 border-t border-firda-gray-100 flex justify-end gap-3"
            >
                <a
                    href="/dashboard/agenda/overzicht"
                    class="px-6 py-2 border border-firda-gray-300 text-firda-gray-700 rounded-lg hover:bg-firda-gray-50 transition"
                >
                    Annuleren
                </a>
                <button
                    type="submit"
                    class="px-6 py-2 bg-firda-blue-600 text-white font-semibold rounded-lg hover:bg-firda-blue-700 transition shadow-sm"
                >
                    Opslaan
                </button>
            </div>
        </form>
    </div>
</DashboardLayout>

---
/**
 * Dashboard Agenda Overzicht
 * ==========================
 * Beheer alle evenementen voor projecten.
 */

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth, supabaseAdmin } from '../../../lib';
import ConfirmDialog from '../../../components/common/ConfirmDialog.astro';

// Check authenticatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
  return auth.redirect;
}

const { profile } = auth;
if (!profile) {
  return Astro.redirect('/login');
}

const isAdmin = profile.role === 'admin';

// Haal evenementen op
let query = supabaseAdmin
  .from('project_events')
  .select(`
    *,
    projects(title, owner_id)
  `)
  .order('start_date', { ascending: true });

// Als geen admin, filter op projecten die eigendom zijn van de gebruiker
if (!isAdmin) {
  // Dit is iets complexer omdat we moeten filteren op de join
  // Maar voor nu gaan we ervan uit dat RLS de filtering doet op de select
}

const { data: events, error } = await query;

if (error) {
  console.error('Error fetching events:', error);
}

// Check voor success/error message in URL
const url = new URL(Astro.request.url);
const message = url.searchParams.get('message');
---

<DashboardLayout title="Agenda Beheren" profile={profile}>
  <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
    <div>
      <h1 class="text-2xl font-bold text-firda-gray-900">Agenda Beheren</h1>
      <p class="text-sm text-firda-gray-500">Voeg belangrijke data toe aan je projecten</p>
    </div>
    
    <a 
      href="/dashboard/agenda/nieuw"
      class="inline-flex items-center px-4 py-2 bg-firda-blue-600 text-white rounded-lg hover:bg-firda-blue-700 transition"
    >
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Nieuw evenement
    </a>
  </div>

  {message && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      {message === 'created' && 'Evenement succesvol aangemaakt.'}
      {message === 'updated' && 'Evenement succesvol bijgewerkt.'}
      {message === 'deleted' && 'Evenement succesvol verwijderd.'}
    </div>
  )}

  {!events || events.length === 0 ? (
    <div class="text-center py-16 bg-firda-gray-50 rounded-lg">
      <svg class="mx-auto h-16 w-16 text-firda-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2-2v14a2 2 0 002 2z"></path>
      </svg>
      <h3 class="text-lg font-semibold text-firda-gray-900 mb-2">Geen evenementen</h3>
      <p class="text-firda-gray-600 mb-4">Er zijn nog geen evenementen gepland voor jouw projecten.</p>
    </div>
  ) : (
    <div class="bg-white rounded-xl shadow-sm overflow-hidden">
      <table class="w-full">
        <thead class="bg-firda-gray-50 border-b border-firda-gray-200">
          <tr>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Datum</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Titel</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Project</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Locatie</th>
            <th class="text-right py-3 px-4 font-semibold text-firda-gray-700">Acties</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-firda-gray-100">
          {events.map((event: any) => (
            <tr class="hover:bg-firda-gray-50 transition-colors">
              <td class="py-3 px-4 text-sm font-medium text-firda-blue-600">
                {new Date(event.start_date).toLocaleDateString('nl-NL', { day: 'numeric', month: 'short', year: 'numeric' })}
              </td>
              <td class="py-3 px-4">
                <span class="font-medium text-firda-gray-900">{event.title}</span>
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {event.projects?.title || 'Geen project'}
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-500">
                {event.location || '-'}
              </td>
              <td class="py-3 px-4">
                <div class="flex items-center justify-end gap-2">
                  <a 
                    href={`/dashboard/agenda/${event.id}`}
                    class="p-2 text-firda-gray-500 hover:text-firda-blue-600 hover:bg-firda-blue-50 rounded-lg transition"
                    title="Bewerken"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </a>
                  
                  <form 
                    id={`delete-event-form-${event.id}`}
                    action="/api/agenda/delete" 
                    method="POST" 
                    class="inline"
                  >
                    <input type="hidden" name="eventId" value={event.id} />
                    <button 
                      type="button"
                      class="p-2 text-firda-gray-500 hover:text-red-600 hover:bg-red-50 rounded-lg transition delete-btn"
                      data-event-id={event.id}
                      title="Verwijderen"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                      </svg>
                    </button>
                  </form>

                  <ConfirmDialog 
                    id={`DeleteDialog${event.id}`}
                    title="Evenement verwijderen"
                    message={`Weet je zeker dat je "${event.title}" wilt verwijderen? Dit kan niet ongedaan worden gemaakt.`}
                    confirmText="Verwijderen"
                    isDangerous={true}
                  />

                  <script define:vars={{ eventId: event.id }}>
                    (function() {
                      const dialogId = `DeleteDialog${eventId}`;
                      const form = document.getElementById(`delete-event-form-${eventId}`);
                      const dialog = document.getElementById(dialogId);
                      const confirmBtn = document.getElementById(`${dialogId}-confirm`);
                      const deleteBtn = document.querySelector(`[data-event-id="${eventId}"]`);

                      deleteBtn?.addEventListener('click', () => {
                        dialog?.showModal();
                      });

                      confirmBtn?.addEventListener('click', () => {
                        form?.submit();
                      });
                    })();
                  </script>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardLayout>

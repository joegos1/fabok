---
/**
 * Dashboard Bewerk Evenement
 * ===========================
 * Formulier voor het bewerken van een bestaand agenda-item.
 */

import DashboardLayout from "../../../../layouts/DashboardLayout.astro";
import { requireAuth, supabaseAdmin } from "../../../../lib";

// Check authenticatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
    return auth.redirect;
}

const { profile } = auth;
if (!profile) {
    return Astro.redirect("/login");
}

const isAdmin = profile.role === "admin";
const { id } = Astro.params;

if (!id) {
    return Astro.redirect("/dashboard/agenda/overzicht");
}

// Haal evenement op
const { data: event, error: eventError } = await supabaseAdmin
    .from("project_events")
    .select("*, projects(title)")
    .eq("id", id)
    .single();

if (eventError || !event) {
    console.error("Error fetching event:", eventError);
    return Astro.redirect("/dashboard/agenda/overzicht");
}

// Haal projecten op (voor de select, hoewel we meestal het project niet veranderen bij edit)
let query = supabaseAdmin
    .from("projects")
    .select("id, title")
    .eq("status", "active");
if (!isAdmin) {
    query = query.eq("owner_id", profile.id);
}
const { data: projects } = await query.order("title", { ascending: true });

// Formatteer datum en tijd voor de inputs
const startDate = new Date(event.start_date);
const dateVal = startDate.toISOString().split("T")[0];
const timeVal = startDate.toTimeString().split(" ")[0].substring(0, 5);
---

<DashboardLayout title={`Bewerk Evenement: ${event.title}`} profile={profile}>
    <div class="max-w-3xl mx-auto">
        <div class="mb-8">
            <a
                href="/dashboard/agenda/overzicht"
                class="inline-flex items-center text-sm text-firda-gray-500 hover:text-firda-blue-600 transition mb-4"
            >
                <svg
                    class="w-4 h-4 mr-1"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                </svg>
                Terug naar overzicht
            </a>
            <h1 class="text-2xl font-bold text-firda-gray-900">
                Evenement bewerken
            </h1>
        </div>

        <form
            action="/api/agenda/update"
            method="POST"
            class="space-y-6 bg-white p-8 rounded-xl shadow-sm border border-firda-gray-200"
        >
            <input type="hidden" name="eventId" value={event.id} />

            <!-- Project Selectie -->
            <div>
                <label
                    for="project_id"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Project *</label
                >
                <select
                    name="project_id"
                    id="project_id"
                    required
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 bg-white"
                >
                    {
                        projects?.map((project) => (
                            <option
                                value={project.id}
                                selected={project.id === event.project_id}
                            >
                                {project.title}
                            </option>
                        ))
                    }
                </select>
            </div>

            <!-- Titel -->
            <div>
                <label
                    for="title"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Titel *</label
                >
                <input
                    type="text"
                    name="title"
                    id="title"
                    required
                    value={event.title}
                    placeholder="Bijv. Projectpresentatie"
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                />
            </div>

            <!-- Beschrijving -->
            <div>
                <label
                    for="description"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Beschrijving</label
                >
                <textarea
                    name="description"
                    id="description"
                    rows="3"
                    placeholder="Optionele toelichting..."
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    >{event.description}</textarea
                >
            </div>

            <div class="grid sm:grid-cols-2 gap-6">
                <!-- Datum -->
                <div>
                    <label
                        for="date"
                        class="block text-sm font-semibold text-firda-gray-700 mb-2"
                        >Datum *</label
                    >
                    <input
                        type="date"
                        name="date"
                        id="date"
                        required
                        value={dateVal}
                        class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    />
                </div>

                <!-- Tijd -->
                <div>
                    <label
                        for="time"
                        class="block text-sm font-semibold text-firda-gray-700 mb-2"
                        >Tijdstip *</label
                    >
                    <input
                        type="time"
                        name="time"
                        id="time"
                        required
                        value={timeVal}
                        class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    />
                </div>
            </div>

            <!-- Locatie -->
            <div>
                <label
                    for="location"
                    class="block text-sm font-semibold text-firda-gray-700 mb-2"
                    >Locatie</label
                >
                <input
                    type="text"
                    name="location"
                    id="location"
                    value={event.location || ""}
                    placeholder="Bijv. Lokaal 2.15 of Online"
                    class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                />
            </div>

            <div
                class="pt-4 border-t border-firda-gray-100 flex justify-end gap-3"
            >
                <a
                    href="/dashboard/agenda/overzicht"
                    class="px-6 py-2 border border-firda-gray-300 text-firda-gray-700 rounded-lg hover:bg-firda-gray-50 transition"
                >
                    Annuleren
                </a>
                <button
                    type="submit"
                    class="px-6 py-2 bg-firda-blue-600 text-white font-semibold rounded-lg hover:bg-firda-blue-700 transition shadow-sm"
                >
                    Wijzigingen opslaan
                </button>
            </div>
        </form>
    </div>
</DashboardLayout>

---
/**
 * Landingspagina Beheren
 * ======================
 * Voor admin en landingpage_editor
 */

import DashboardLayout from "../../layouts/DashboardLayout.astro";
import PdfList from "../../components/pdf/PdfList.astro";
import PdfUpload from "../../components/pdf/PdfUpload.astro";
import { requireAuth, isLandingPageEditor, supabaseAdmin } from "../../lib";

// Check authenticatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
  return auth.redirect;
}

const { profile } = auth;
if (!profile) {
  return Astro.redirect("/login");
}

// Check of gebruiker landingpage_editor of admin is
if (!isLandingPageEditor(profile.role)) {
  return Astro.redirect("/dashboard/overzicht");
}

// Haal huidige content op
const { data: content } = await supabaseAdmin
  .from("landing_page_content")
  .select("*")
  .single() as { data: any | null };

// Haal PDF's op
const { data: pdfs } = await supabaseAdmin
  .from("pdf_files")
  .select("*")
  .eq("is_landing_page", true)
  .order("uploaded_at", { ascending: false }) as { data: any[] | null };

// Haal scholen op
const { data: schools } = await supabaseAdmin
  .from("schools")
  .select("*")
  .order("display_order", { ascending: true }) as { data: any[] | null };

// Check voor message
const url = new URL(Astro.request.url);
const message = url.searchParams.get("message");
const errorMsg = url.searchParams.get("error");

// Verwerk formulier
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();

    const title = formData.get("title")?.toString() || "VABOK";
    const intro = formData.get("intro")?.toString() || null;
    const body = formData.get("body")?.toString() || null;

    if (content) {
      // Update bestaande content
      const { error } = await supabaseAdmin
        .from("landing_page_content")
        .update({
          title,
          intro,
          body,
          updated_by: profile.id,
          updated_at: new Date().toISOString(),
        } as any)
        .eq("id", content.id);

      if (error) {
        console.error("Error updating content:", error);
        return Astro.redirect("/dashboard/landingpage?error=Update mislukt");
      }
    } else {
      // Insert nieuwe content
      const { error } = await supabaseAdmin
        .from("landing_page_content")
        .insert({
          title,
          intro,
          body,
          updated_by: profile.id,
        } as any);

      if (error) {
        console.error("Error creating content:", error);
        return Astro.redirect("/dashboard/landingpage?error=Aanmaken mislukt");
      }
    }

    return Astro.redirect("/dashboard/landingpage?message=saved");
  } catch (error) {
    console.error("Error processing form:", error);
  }
}

const currentContent = content || {
  title: "VABOK - Versterken van de Aansluiting in de Beroepskolom",
  intro: "",
  body: "",
};
---

<DashboardLayout title="Landingspagina beheren" profile={profile}>
  <div class="grid lg:grid-cols-3 gap-8">
    <!-- Formulier -->
    <div class="lg:col-span-2">
      <h1 class="text-2xl font-bold text-firda-gray-900 mb-6">
        Landingspagina beheren
      </h1>

      {
        message === "saved" && (
          <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
            Wijzigingen succesvol opgeslagen.
          </div>
        )
      }

      {
        errorMsg && (
          <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
            {errorMsg}
          </div>
        )
      }

      <form method="POST" class="space-y-6">
        <!-- Titel -->
        <div>
          <label
            for="title"
            class="block text-sm font-medium text-firda-gray-700 mb-1"
          >
            Titel <span class="text-red-500">*</span>
          </label>
          <input
            type="text"
            id="title"
            name="title"
            required
            value={currentContent.title}
            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
            placeholder="Paginatitel"
          />
        </div>

        <!-- Intro -->
        <div>
          <label
            for="intro"
            class="block text-sm font-medium text-firda-gray-700 mb-1"
          >
            Introductie
          </label>
          <textarea
            id="intro"
            name="intro"
            rows="3"
            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
            placeholder="Korte introductietekst die onder de titel komt..."
            >{currentContent.intro || ""}</textarea
          >
          <p class="mt-1 text-sm text-firda-gray-500">
            Deze tekst wordt getoond in het hero-gedeelte
          </p>
        </div>

        <!-- Body -->
        <div>
          <label
            for="body"
            class="block text-sm font-medium text-firda-gray-700 mb-1"
          >
            Hoofdtekst
          </label>
          <textarea
            id="body"
            name="body"
            rows="10"
            class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
            placeholder="De hoofdtekst van de landingspagina..."
            >{currentContent.body || ""}</textarea
          >
          <p class="mt-1 text-sm text-firda-gray-500">
            Gebruik lege regels om alinea's te scheiden
          </p>
        </div>

        <!-- Submit buttons -->
        <div
          class="flex items-center gap-4 pt-4 border-t border-firda-gray-200"
        >
          <button
            type="submit"
            class="px-6 py-2 bg-firda-blue-600 text-white font-medium rounded-lg hover:bg-firda-blue-700 transition"
          >
            Publish
          </button>
          <a
            href="/"
            target="_blank"
            class="px-6 py-2 bg-firda-gray-200 text-firda-gray-700 font-medium rounded-lg hover:bg-firda-gray-300 transition"
          >
            Bekijk pagina
          </a>
        </div>
      </form>

      <!-- Scholen beheer sectie -->
      <div class="mt-12 pt-8 border-t border-firda-gray-200">
        <h2 class="text-xl font-bold text-firda-gray-900 mb-4">
          Samenwerkende scholen
        </h2>
        <p class="text-sm text-firda-gray-600 mb-4">
          Beheer de lijst van scholen die wordt getoond in de marquee op de
          landingspagina.
        </p>

        <!-- School toevoegen formulier -->
        <form action="/api/schools/add" method="POST" class="mb-6 space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="md:col-span-2">
              <label
                class="block text-xs font-bold text-firda-gray-500 uppercase mb-1 ml-1"
                >Naam School</label
              >
              <input
                type="text"
                name="schoolName"
                required
                placeholder="Naam van de school..."
                class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
              />
            </div>
            <div>
              <label
                class="block text-xs font-bold text-firda-gray-500 uppercase mb-1 ml-1"
                >Adres</label
              >
              <input
                type="text"
                name="address"
                placeholder="Bijv. Hoofdstraat 1"
                class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
              />
            </div>
            <div>
              <label
                class="block text-xs font-bold text-firda-gray-500 uppercase mb-1 ml-1"
                >Stad</label
              >
              <input
                type="text"
                name="city"
                placeholder="Bijv. Leeuwarden"
                class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
              />
            </div>
            <div>
              <label
                class="block text-xs font-bold text-firda-gray-500 uppercase mb-1 ml-1"
                >Provincie</label
              >
              <select
                name="province"
                class="w-full px-4 py-2 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
              >
                <option value="">Selecteer provincie...</option>
                <option value="Friesland">Friesland</option>
                <option value="Groningen">Groningen</option>
                <option value="Drenthe">Drenthe</option>
                <option value="Overijssel">Overijssel</option>
                <option value="Flevoland">Flevoland</option>
                <option value="Gelderland">Gelderland</option>
                <option value="Utrecht">Utrecht</option>
                <option value="Noord-Holland">Noord-Holland</option>
                <option value="Zuid-Holland">Zuid-Holland</option>
                <option value="Zeeland">Zeeland</option>
                <option value="Noord-Brabant">Noord-Brabant</option>
                <option value="Limburg">Limburg</option>
              </select>
            </div>
            <div class="flex items-end">
              <button
                type="submit"
                class="w-full px-6 py-2 bg-firda-green-500 text-firda-gray-900 font-bold rounded-lg hover:bg-firda-green-600 transition shadow-sm"
              >
                Toevoegen
              </button>
            </div>
          </div>
        </form>

        <!-- School lijst -->
        {
          schools && schools.length > 0 ? (
            <div class="space-y-2">
              {schools.map((school, index) => (
                <div class="p-4 bg-firda-gray-50 rounded-xl border border-firda-gray-200 shadow-sm transition-all hover:shadow-md">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      <span class="text-xs font-bold text-firda-gray-400 w-6">
                        {index + 1}
                      </span>
                      <div>
                        <span class="text-firda-gray-900 font-bold block">
                          {school.name}
                        </span>
                        <span class="text-[10px] text-firda-gray-500 uppercase font-bold tracking-tight">
                          {school.city || 'Geen stad'} — {school.province || 'Geen provincie'}
                        </span>
                      </div>
                    </div>
                    
                    <div class="flex items-center gap-1">
                      <!-- Edit Button -->
                      <button
                        type="button"
                        class="p-2 text-firda-gray-400 hover:text-firda-blue-600 hover:bg-white rounded-lg transition-all"
                        onclick={`document.getElementById('edit-form-${school.id}').classList.toggle('hidden')`}
                        title="Bewerken"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                        </svg>
                      </button>

                      <!-- Reorder Up -->
                      {index > 0 && (
                        <form action="/api/schools/reorder" method="POST" class="inline">
                          <input type="hidden" name="schoolId" value={school.id} />
                          <input type="hidden" name="direction" value="up" />
                          <button type="submit" class="p-2 text-firda-gray-400 hover:text-firda-blue-600 hover:bg-white rounded-lg transition-all" title="Omhoog">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" /></svg>
                          </button>
                        </form>
                      )}

                      <!-- Reorder Down -->
                      {index < schools.length - 1 && (
                        <form action="/api/schools/reorder" method="POST" class="inline">
                          <input type="hidden" name="schoolId" value={school.id} />
                          <input type="hidden" name="direction" value="down" />
                          <button type="submit" class="p-2 text-firda-gray-400 hover:text-firda-blue-600 hover:bg-white rounded-lg transition-all" title="Omlaag">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                          </button>
                        </form>
                      )}

                      <!-- Delete -->
                      <form action="/api/schools/delete" method="POST" class="inline">
                        <input type="hidden" name="schoolId" value={school.id} />
                        <button
                          type="submit"
                          class="p-2 text-firda-gray-400 hover:text-red-500 hover:bg-white rounded-lg transition-all"
                          onclick="return confirm('Weet je zeker dat je deze school wilt verwijderen?')"
                          title="Verwijderen"
                        >
                          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                      </form>
                    </div>
                  </div>

                  <!-- Inline Edit Form (Hidden by default) -->
                  <div id={`edit-form-${school.id}`} class="hidden mt-4 pt-4 border-t border-firda-gray-200 animate-fade-in">
                    <form action="/api/schools/update" method="POST" class="space-y-4">
                      <input type="hidden" name="schoolId" value={school.id} />
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div class="md:col-span-2">
                          <label class="block text-[10px] font-black text-firda-gray-400 uppercase mb-1 ml-1">Naam School</label>
                          <input
                            type="text"
                            name="schoolName"
                            required
                            value={school.name}
                            class="w-full px-3 py-1.5 text-sm border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 bg-white"
                          />
                        </div>
                        <div>
                          <label class="block text-[10px] font-black text-firda-gray-400 uppercase mb-1 ml-1">Adres</label>
                          <input
                            type="text"
                            name="address"
                            value={school.address || ''}
                            class="w-full px-3 py-1.5 text-sm border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 bg-white"
                          />
                        </div>
                        <div>
                          <label class="block text-[10px] font-black text-firda-gray-400 uppercase mb-1 ml-1">Stad</label>
                          <input
                            type="text"
                            name="city"
                            value={school.city || ''}
                            class="w-full px-3 py-1.5 text-sm border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 bg-white"
                          />
                        </div>
                        <div>
                          <label class="block text-[10px] font-black text-firda-gray-400 uppercase mb-1 ml-1">Provincie</label>
                          <select
                            name="province"
                            class="w-full px-3 py-1.5 text-sm border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 bg-white"
                          >
                            <option value="">Selecteer...</option>
                            {[
                              'Friesland', 'Groningen', 'Drenthe', 'Overijssel', 'Flevoland', 
                              'Gelderland', 'Utrecht', 'Noord-Holland', 'Zuid-Holland', 
                              'Zeeland', 'Noord-Brabant', 'Limburg'
                            ].map(p => (
                              <option value={p} selected={school.province === p}>{p}</option>
                            ))}
                          </select>
                        </div>
                        <div class="flex items-end gap-2 text-right">
                          <button
                            type="button"
                            onclick={`document.getElementById('edit-form-${school.id}').classList.add('hidden')`}
                            class="px-4 py-1.5 text-xs font-bold text-firda-gray-500 hover:text-firda-gray-700 transition"
                          >
                            Annuleren
                          </button>
                          <button
                            type="submit"
                            class="flex-1 px-4 py-1.5 bg-firda-blue-600 text-white text-xs font-black rounded-lg hover:bg-firda-blue-700 transition shadow-sm uppercase tracking-wider"
                          >
                            Opslaan
                          </button>
                        </div>
                      </div>
                    </form>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="text-center py-8 bg-firda-gray-50 rounded-lg border-2 border-dashed border-firda-gray-300">
              <p class="text-firda-gray-500">Nog geen scholen toegevoegd.</p>
            </div>
          )
        }
      </div>
    </div>

    <!-- Sidebar met PDF's -->
    <aside class="space-y-6">
      <PdfUpload uploadUrl="/api/pdf/upload" />

      <PdfList pdfs={pdfs || []} title="Documenten" maxHeight="400px" />

      {
        pdfs && pdfs.length > 0 && (
          <div class="bg-firda-gray-50 rounded-lg p-4">
            <h3 class="font-semibold text-firda-gray-800 mb-3">
              PDF's verwijderen
            </h3>
            <div class="space-y-2">
              {pdfs.map((pdf) => (
                <div class="flex items-center justify-between p-2 bg-white rounded-lg border border-firda-gray-200">
                  <span class="text-sm text-firda-gray-700 truncate flex-1 mr-2">
                    {pdf.filename}
                  </span>
                  <form action="/api/pdf/delete" method="POST" class="inline">
                    <input type="hidden" name="pdfId" value={pdf.id} />
                    <input
                      type="hidden"
                      name="redirectTo"
                      value="/dashboard/landingpage"
                    />
                    <button
                      type="submit"
                      class="p-1 text-firda-gray-400 hover:text-red-500 transition"
                      onclick="return confirm('Weet je zeker dat je deze PDF wilt verwijderen?')"
                    >
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                        />
                      </svg>
                    </button>
                  </form>
                </div>
              ))}
            </div>
          </div>
        )
      }
    </aside>
  </div>
</DashboardLayout>

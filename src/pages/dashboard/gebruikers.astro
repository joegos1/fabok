---
/**
 * Gebruikersbeheer (Admin)
 * ========================
 */

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { requireAuth, supabaseAdmin } from '../../lib';
import type { UserRole } from '../../types/database';

// Check authenticatie en autorisatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
  return auth.redirect;
}

const { profile } = auth;
if (!profile || profile.role !== 'admin') {
  return Astro.redirect('/dashboard/overzicht');
}

// Haal alle gebruikers op
const { data: users, error } = await supabaseAdmin
  .from('profiles')
  .select('*')
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching users:', error);
}

// Filter gebruikers
const pendingUsers = users?.filter(u => u.account_status === 'pending') || [];
const approvedUsers = users?.filter(u => u.account_status === 'approved') || [];

// Check voor message
const url = new URL(Astro.request.url);
const message = url.searchParams.get('message');
const errorMsg = url.searchParams.get('error');

const roles: UserRole[] = ['admin', 'landingpage_editor', 'project_editor', 'viewer'];

const roleLabels: Record<UserRole, string> = {
  admin: 'Administrator',
  landingpage_editor: 'Landingpage Editor',
  project_editor: 'Project Editor',
  viewer: 'Viewer',
};

const roleColors: Record<UserRole, string> = {
  admin: 'bg-red-100 text-red-700',
  landingpage_editor: 'bg-purple-100 text-purple-700',
  project_editor: 'bg-blue-100 text-blue-700',
  viewer: 'bg-gray-100 text-gray-700',
};
---

<DashboardLayout title="Gebruikers beheren" profile={profile}>
  <h1 class="text-2xl font-bold text-firda-gray-900 mb-6">
    Gebruikers beheren
  </h1>

  {message && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      {message === 'updated' && 'Gebruikersrol succesvol bijgewerkt.'}
      {message === 'approved' && 'Gebruiker succesvol goedgekeurd.'}
      {message === 'rejected' && 'Gebruiker succesvol afgewezen.'}
    </div>
  )}

  {errorMsg && (
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
      {errorMsg}
    </div>
  )}

  <!-- Pending Users Section -->
  {pendingUsers.length > 0 && (
    <div class="mb-8">
      <h2 class="text-lg font-semibold text-orange-800 mb-4 flex items-center">
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
        </svg>
        Wachtend op goedkeuring ({pendingUsers.length})
      </h2>
      <div class="bg-white border border-orange-200 rounded-lg overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-orange-50">
              <tr>
                <th class="text-left py-3 px-4 font-semibold text-orange-800">Gebruiker</th>
                <th class="text-left py-3 px-4 font-semibold text-orange-800">E-mail</th>
                <th class="text-left py-3 px-4 font-semibold text-orange-800">Aangevraagd op</th>
                <th class="text-right py-3 px-4 font-semibold text-orange-800">Actie</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-orange-100">
              {pendingUsers.map(user => (
                <tr>
                  <td class="py-3 px-4 font-medium text-firda-gray-900">
                    {user.full_name || 'Geen naam'}
                  </td>
                  <td class="py-3 px-4 text-sm text-firda-gray-600">
                    {user.email}
                  </td>
                  <td class="py-3 px-4 text-sm text-firda-gray-600">
                    {new Date(user.created_at).toLocaleDateString('nl-NL')}
                  </td>
                  <td class="py-3 px-4">
                    <div class="flex items-center justify-end gap-2">
                      <form action="/api/users/approve" method="POST" class="flex items-center gap-2">
                        <input type="hidden" name="userId" value={user.id} />
                        <select 
                          name="role" 
                          required
                          class="text-sm border border-orange-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-orange-500 focus:border-orange-500"
                        >
                          <option value="" disabled selected>Kies rol...</option>
                          {roles.map(role => (
                            <option value={role}>{roleLabels[role]}</option>
                          ))}
                        </select>
                        <button
                          type="submit"
                          class="px-3 py-1.5 bg-green-600 text-white text-sm font-medium rounded-lg hover:bg-green-700 transition"
                        >
                          Goedkeuren
                        </button>
                      </form>
                      <form action="/api/users/reject" method="POST">
                        <input type="hidden" name="userId" value={user.id} />
                        <button
                          type="submit"
                          class="px-3 py-1.5 bg-red-100 text-red-700 text-sm font-medium rounded-lg hover:bg-red-200 transition"
                          onclick="return confirm('Weet je zeker dat je deze aanvraag wilt afwijzen?')"
                        >
                          Afwijzen
                        </button>
                      </form>
                    </div>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )}

  <!-- Info box -->
  <div class="mb-6 p-4 bg-firda-blue-50 rounded-lg">
    <h3 class="font-semibold text-firda-blue-800 mb-2">Rollen uitleg</h3>
    <ul class="text-sm text-firda-blue-700 space-y-1">
      <li><strong>Admin:</strong> Volledige toegang tot alle functies</li>
      <li><strong>Landingpage Editor:</strong> Kan alleen de landingspagina bewerken</li>
      <li><strong>Project Editor:</strong> Kan eigen toegewezen projecten bewerken</li>
      <li><strong>Viewer:</strong> Kan alleen lezen en PDF's downloaden</li>
    </ul>
  </div>

  <!-- Gebruikers tabel -->
  {!approvedUsers || approvedUsers.length === 0 ? (
    <div class="text-center py-16 bg-firda-gray-50 rounded-lg">
      <p class="text-firda-gray-600">Geen actieve gebruikers gevonden.</p>
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-firda-gray-200">
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Gebruiker</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">E-mail</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Huidige rol</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Lid sinds</th>
            <th class="text-right py-3 px-4 font-semibold text-firda-gray-700">Rol wijzigen</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-firda-gray-100">
          {approvedUsers.map(user => (
            <tr class="hover:bg-firda-gray-50">
              <td class="py-3 px-4">
                <p class="font-medium text-firda-gray-900">
                  {user.full_name || 'Geen naam'}
                </p>
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {user.email}
              </td>
              <td class="py-3 px-4">
                <span class={`inline-flex px-2 py-1 text-xs font-medium rounded-full ${user.role ? roleColors[user.role] : 'bg-gray-100'}`}>
                  {user.role ? roleLabels[user.role] : 'Geen rol'}
                </span>
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {new Date(user.created_at).toLocaleDateString('nl-NL')}
              </td>
              <td class="py-3 px-4">
                <form action="/api/users/update-role" method="POST" class="flex items-center justify-end gap-2">
                  <input type="hidden" name="userId" value={user.id} />
                  <select 
                    name="role" 
                    class="text-sm border border-firda-gray-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    disabled={user.id === profile.id}
                  >
                    {roles.map(role => (
                      <option value={role} selected={role === user.role}>
                        {roleLabels[role]}
                      </option>
                    ))}
                  </select>
                  <button
                    type="submit"
                    class="px-3 py-1.5 bg-firda-blue-600 text-white text-sm font-medium rounded-lg hover:bg-firda-blue-700 disabled:bg-firda-gray-300 disabled:cursor-not-allowed transition"
                    disabled={user.id === profile.id}
                    title={user.id === profile.id ? 'Je kunt je eigen rol niet wijzigen' : 'Rol opslaan'}
                  >
                    Opslaan
                  </button>
                </form>
                {user.id === profile.id && (
                  <p class="text-xs text-firda-gray-500 text-right mt-1">
                    Je kunt je eigen rol niet wijzigen
                  </p>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardLayout>

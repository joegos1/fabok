---
/**
 * Gebruikersbeheer (Admin)
 * ========================
 */

import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../lib/auth';
import { supabaseAdmin } from '../../lib/supabaseClient';
import type { UserRole } from '../../lib/database.types';

// Check authenticatie en autorisatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
  return auth.redirect;
}

const { profile } = auth;
if (!profile || profile.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

// Haal alle gebruikers op
const { data: users, error } = await supabaseAdmin
  .from('profiles')
  .select('*')
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching users:', error);
}

// Check voor message
const url = new URL(Astro.request.url);
const message = url.searchParams.get('message');
const errorMsg = url.searchParams.get('error');

const roles: UserRole[] = ['admin', 'landingpage_editor', 'project_editor', 'viewer'];

const roleLabels: Record<UserRole, string> = {
  admin: 'Administrator',
  landingpage_editor: 'Landingpage Editor',
  project_editor: 'Project Editor',
  viewer: 'Viewer',
};

const roleColors: Record<UserRole, string> = {
  admin: 'bg-red-100 text-red-700',
  landingpage_editor: 'bg-purple-100 text-purple-700',
  project_editor: 'bg-blue-100 text-blue-700',
  viewer: 'bg-gray-100 text-gray-700',
};
---

<DashboardLayout title="Gebruikers beheren" profile={profile}>
  <h1 class="text-2xl font-bold text-firda-gray-900 mb-6">
    Gebruikers beheren
  </h1>

  {message === 'updated' && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      Gebruikersrol succesvol bijgewerkt.
    </div>
  )}

  {errorMsg && (
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
      {errorMsg}
    </div>
  )}

  <!-- Info box -->
  <div class="mb-6 p-4 bg-firda-blue-50 rounded-lg">
    <h3 class="font-semibold text-firda-blue-800 mb-2">Rollen uitleg</h3>
    <ul class="text-sm text-firda-blue-700 space-y-1">
      <li><strong>Admin:</strong> Volledige toegang tot alle functies</li>
      <li><strong>Landingpage Editor:</strong> Kan alleen de landingspagina bewerken</li>
      <li><strong>Project Editor:</strong> Kan eigen toegewezen projecten bewerken</li>
      <li><strong>Viewer:</strong> Kan alleen lezen en PDF's downloaden</li>
    </ul>
  </div>

  <!-- Gebruikers tabel -->
  {!users || users.length === 0 ? (
    <div class="text-center py-16 bg-firda-gray-50 rounded-lg">
      <p class="text-firda-gray-600">Geen gebruikers gevonden.</p>
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-firda-gray-200">
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Gebruiker</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">E-mail</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Huidige rol</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Lid sinds</th>
            <th class="text-right py-3 px-4 font-semibold text-firda-gray-700">Rol wijzigen</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-firda-gray-100">
          {users.map(user => (
            <tr class="hover:bg-firda-gray-50">
              <td class="py-3 px-4">
                <p class="font-medium text-firda-gray-900">
                  {user.full_name || 'Geen naam'}
                </p>
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {user.email}
              </td>
              <td class="py-3 px-4">
                <span class={`inline-flex px-2 py-1 text-xs font-medium rounded-full ${roleColors[user.role]}`}>
                  {roleLabels[user.role]}
                </span>
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {new Date(user.created_at).toLocaleDateString('nl-NL')}
              </td>
              <td class="py-3 px-4">
                <form action="/api/users/update-role" method="POST" class="flex items-center justify-end gap-2">
                  <input type="hidden" name="userId" value={user.id} />
                  <select 
                    name="role" 
                    class="text-sm border border-firda-gray-300 rounded-lg px-3 py-1.5 focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500"
                    disabled={user.id === profile.id}
                  >
                    {roles.map(role => (
                      <option value={role} selected={role === user.role}>
                        {roleLabels[role]}
                      </option>
                    ))}
                  </select>
                  <button
                    type="submit"
                    class="px-3 py-1.5 bg-firda-blue-600 text-white text-sm font-medium rounded-lg hover:bg-firda-blue-700 disabled:bg-firda-gray-300 disabled:cursor-not-allowed transition"
                    disabled={user.id === profile.id}
                    title={user.id === profile.id ? 'Je kunt je eigen rol niet wijzigen' : 'Rol opslaan'}
                  >
                    Opslaan
                  </button>
                </form>
                {user.id === profile.id && (
                  <p class="text-xs text-firda-gray-500 text-right mt-1">
                    Je kunt je eigen rol niet wijzigen
                  </p>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardLayout>

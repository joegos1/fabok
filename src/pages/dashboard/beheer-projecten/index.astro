---
/**
 * Admin - Alle Projecten Beheren
 * ==============================
 * Overzicht van alle projecten voor administrators
 */

import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { requireAuth } from '../../../lib/auth';
import { supabaseAdmin } from '../../../lib/supabaseClient';

// Check authenticatie en autorisatie
const auth = await requireAuth(Astro.request);
if (auth.redirect) {
  return auth.redirect;
}

const { profile } = auth;
if (!profile || profile.role !== 'admin') {
  return Astro.redirect('/dashboard');
}

// Haal alle projecten op
const { data: projects, error } = await supabaseAdmin
  .from('projects')
  .select(`
    *,
    owner:profiles(full_name, email)
  `)
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error fetching projects:', error);
}

// Check voor success/error message in URL
const url = new URL(Astro.request.url);
const message = url.searchParams.get('message');
const errorMsg = url.searchParams.get('error');
---

<DashboardLayout title="Projecten beheren" profile={profile}>
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-firda-gray-900">
      Alle projecten
    </h1>
    <a 
      href="/dashboard/projecten/nieuw"
      class="inline-flex items-center px-4 py-2 bg-firda-green-500 text-white rounded-lg hover:bg-firda-green-600 transition"
    >
      <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
      </svg>
      Nieuw project
    </a>
  </div>

  <!-- Success/error messages -->
  {message && (
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700">
      {message === 'created' && 'Project succesvol aangemaakt.'}
      {message === 'updated' && 'Project succesvol bijgewerkt.'}
      {message === 'archived' && 'Project succesvol gearchiveerd.'}
      {message === 'deleted' && 'Project succesvol verwijderd.'}
    </div>
  )}

  {errorMsg && (
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700">
      {errorMsg}
    </div>
  )}

  <!-- Projecten tabel -->
  {!projects || projects.length === 0 ? (
    <div class="text-center py-16 bg-firda-gray-50 rounded-lg">
      <svg class="mx-auto h-16 w-16 text-firda-gray-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
      <h3 class="text-lg font-semibold text-firda-gray-900 mb-2">
        Nog geen projecten
      </h3>
      <p class="text-firda-gray-600 mb-4">
        Maak je eerste VABOK project aan.
      </p>
      <a 
        href="/dashboard/projecten/nieuw"
        class="inline-flex items-center px-4 py-2 bg-firda-blue-600 text-white rounded-lg hover:bg-firda-blue-700 transition"
      >
        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        Nieuw project
      </a>
    </div>
  ) : (
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead>
          <tr class="border-b border-firda-gray-200">
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Titel</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Eigenaar</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Status</th>
            <th class="text-left py-3 px-4 font-semibold text-firda-gray-700">Aangemaakt</th>
            <th class="text-right py-3 px-4 font-semibold text-firda-gray-700">Acties</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-firda-gray-100">
          {projects.map(project => (
            <tr class="hover:bg-firda-gray-50">
              <td class="py-3 px-4">
                <a href={`/projecten/${project.id}`} class="font-medium text-firda-blue-600 hover:text-firda-blue-700">
                  {project.title}
                </a>
                {project.tags && project.tags.length > 0 && (
                  <div class="flex gap-1 mt-1">
                    {project.tags.slice(0, 2).map(tag => (
                      <span class="text-xs px-2 py-0.5 bg-firda-gray-100 text-firda-gray-600 rounded-full">
                        {tag}
                      </span>
                    ))}
                    {project.tags.length > 2 && (
                      <span class="text-xs text-firda-gray-500">
                        +{project.tags.length - 2}
                      </span>
                    )}
                  </div>
                )}
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {project.owner?.full_name || project.owner?.email || 'Onbekend'}
              </td>
              <td class="py-3 px-4">
                <span class={`inline-flex px-2 py-1 text-xs font-medium rounded-full ${
                  project.status === 'active' 
                    ? 'bg-firda-green-100 text-firda-green-700' 
                    : 'bg-firda-gray-100 text-firda-gray-600'
                }`}>
                  {project.status === 'active' ? 'Actief' : 'Gearchiveerd'}
                </span>
              </td>
              <td class="py-3 px-4 text-sm text-firda-gray-600">
                {new Date(project.created_at).toLocaleDateString('nl-NL')}
              </td>
              <td class="py-3 px-4">
                <div class="flex items-center justify-end gap-2">
                  <a 
                    href={`/dashboard/projecten/${project.id}`}
                    class="p-2 text-firda-gray-500 hover:text-firda-blue-600 hover:bg-firda-blue-50 rounded-lg transition"
                    title="Bewerken"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                  </a>
                  {project.status === 'active' ? (
                    <form action="/api/projects/archive.ts" method="POST" class="inline">
                      <input type="hidden" name="projectId" value={project.id} />
                      <button 
                        type="submit"
                        class="p-2 text-firda-gray-500 hover:text-orange-600 hover:bg-orange-50 rounded-lg transition"
                        title="Archiveren"
                        onclick="return confirm('Weet je zeker dat je dit project wilt archiveren?')"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                        </svg>
                      </button>
                    </form>
                  ) : (
                    <form action="/api/projects/restore.ts" method="POST" class="inline">
                      <input type="hidden" name="projectId" value={project.id} />
                      <button 
                        type="submit"
                        class="p-2 text-firda-gray-500 hover:text-firda-green-600 hover:bg-firda-green-50 rounded-lg transition"
                        title="Herstellen"
                      >
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path>
                        </svg>
                      </button>
                    </form>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
</DashboardLayout>

---
/**
 * Login Page
 * ==========
 * Login pagina met e-mail en wachtwoord
 */

import Layout from "../layouts/Layout.astro";
import { getCurrentUser } from "../lib";

// Check of gebruiker al ingelogd is met een geldige token
const cookies = Astro.request.headers.get("cookie") || "";
const accessTokenMatch = cookies.match(/sb-access-token=([^;]+)/);
const accessToken = accessTokenMatch ? accessTokenMatch[1] : null;

// Only redirect if we have a valid token AND the user exists
if (accessToken && accessToken.length > 0) {
  const user = await getCurrentUser(accessToken);
  if (user) {
    return Astro.redirect("/dashboard/overzicht");
  }
}

// Check voor error/success message in URL
const url = new URL(Astro.request.url);
const error = url.searchParams.get("error");
const message = url.searchParams.get("message");
---

<Layout title="Inloggen">
  <div
    class="min-h-[80vh] flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8"
  >
    <div class="max-w-md w-full">
      <div class="bg-white rounded-2xl shadow-lg p-8">
        <!-- Header -->
        <div class="text-center mb-8">
          <div
            class="mx-auto w-16 h-16 bg-firda-blue-100 rounded-full flex items-center justify-center mb-4"
          >
            <svg
              class="w-8 h-8 text-firda-blue-600"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
              ></path>
            </svg>
          </div>
          <h1 class="text-2xl font-bold text-firda-gray-900">Inloggen</h1>
          <p class="mt-2 text-firda-gray-600">
            Log in om toegang te krijgen tot het dashboard
          </p>
        </div>

        <!-- Error message -->
        {
          error && (
            <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm">
              {error === "invalid_credentials" &&
                "Ongeldige e-mail of wachtwoord."}
              {error === "server_error" &&
                "Er is een serverfout opgetreden. Probeer het later opnieuw."}
              {error === "unauthorized" &&
                "Je bent niet geautoriseerd om deze pagina te bekijken."}
              {error === "account_pending" &&
                "Je account wacht nog op goedkeuring door een beheerder."}
              {error === "account_rejected" &&
                "Je accountaanvraag is afgewezen."}
              {![
                "invalid_credentials",
                "server_error",
                "unauthorized",
                "account_pending",
                "account_rejected",
              ].includes(error) && error}
            </div>
          )
        }

        <!-- Success message -->
        {
          message && (
            <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-lg text-green-700 text-sm">
              {message === "logged_out" && "Je bent succesvol uitgelogd."}
              {message === "password_reset" &&
                "Check je e-mail voor instructies om je wachtwoord te resetten."}
              {message === "account_pending" &&
                "Je account is aangevraagd en wacht op goedkeuring."}
              {!["logged_out", "password_reset", "account_pending"].includes(
                message,
              ) && message}
            </div>
          )
        }

        <!-- Login form -->
        <form action="/api/auth/login" method="POST" class="space-y-6">
          <div>
            <label
              for="email"
              class="block text-sm font-medium text-firda-gray-700 mb-1"
            >
              E-mailadres
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="w-full px-4 py-3 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 transition"
              placeholder="jouw@email.nl"
            />
          </div>

          <div>
            <label
              for="password"
              class="block text-sm font-medium text-firda-gray-700 mb-1"
            >
              Wachtwoord
            </label>
            <input
              type="password"
              id="password"
              name="password"
              required
              autocomplete="current-password"
              class="w-full px-4 py-3 border border-firda-gray-300 rounded-lg focus:ring-2 focus:ring-firda-blue-500 focus:border-firda-blue-500 transition"
              placeholder="••••••••"
            />
          </div>

          <button
            type="submit"
            class="w-full bg-firda-blue-600 text-white py-3 px-4 rounded-lg font-semibold hover:bg-firda-blue-700 focus:ring-4 focus:ring-firda-blue-200 transition"
          >
            Inloggen
          </button>
        </form>

        <!-- Footer links -->
        <div class="mt-6 text-center text-sm text-firda-gray-600">
          <a
            href="/"
            class="text-firda-blue-600 hover:text-firda-blue-700 font-medium"
          >
            ← Terug naar home
          </a>
        </div>
      </div>

      <!-- Info box -->
      <div
        class="mt-6 bg-firda-blue-50 rounded-xl p-4 text-center text-sm text-firda-blue-800"
      >
        <p>
          <strong>Heb je nog geen account?</strong><br />
          <a
            href="/signup"
            class="text-firda-blue-600 hover:text-firda-blue-700 font-semibold underline"
          >
            Vraag hier een account aan
          </a>
        </p>
      </div>
    </div>
  </div>
</Layout>

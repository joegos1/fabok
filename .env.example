# VABOK Applicatie - Environment Variabelen
# ==========================================
# Kopieer dit bestand naar .env en vul de juiste waarden in.
#
# SUPABASE CONFIGURATIE
# ---------------------
# Ga naar je Supabase project dashboard:
# 1. Settings > API
# 2. Kopieer de "Project URL" naar PUBLIC_SUPABASE_URL
# 3. Kopieer de "anon/public" key naar PUBLIC_SUPABASE_ANON_KEY
# 4. Kopieer de "service_role" key naar SUPABASE_SERVICE_ROLE_KEY
#    (Let op: deze key geeft volledige toegang, alleen server-side gebruiken!)

PUBLIC_SUPABASE_URL=https://jouw-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

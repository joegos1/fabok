{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/auth/logout/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/delete-pdf/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/projects/archive/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/projects/restore/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/upload-pdf/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/users/update-role/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/gebruikers/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/landingpage/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/mijn-projecten/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/projecten/nieuw/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/projecten/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/projecten/?$",
			"dest": "_render"
		},
		{
			"src": "^/dashboard/?$",
			"dest": "_render"
		},
		{
			"src": "^/login/?$",
			"dest": "_render"
		},
		{
			"src": "^/projecten/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/projecten/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}